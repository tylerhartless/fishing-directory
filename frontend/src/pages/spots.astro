---
import Layout from '../layouts/Layout.astro';

const stateSlugLookup = {
  'AL': 'alabama',
  'AK': 'alaska',
  'AZ': 'arizona',
  'AR': 'arkansas',
  'CA': 'california',
  'CO': 'colorado',
  'CT': 'connecticut',
  'DE': 'delaware',
  'FL': 'florida',
  'GA': 'georgia',
  'HI': 'hawaii',
  'ID': 'idaho',
  'IL': 'illinois',
  'IN': 'indiana',
  'IA': 'iowa',
  'KS': 'kansas',
  'KY': 'kentucky',
  'LA': 'louisiana',
  'ME': 'maine',
  'MD': 'maryland',
  'MA': 'massachusetts',
  'MI': 'michigan',
  'MN': 'minnesota',
  'MS': 'mississippi',
  'MO': 'missouri',
  'MT': 'montana',
  'NE': 'nebraska',
  'NV': 'nevada',
  'NH': 'new-hampshire',
  'NJ': 'new-jersey',
  'NM': 'new-mexico',
  'NY': 'new-york',
  'NC': 'north-carolina',
  'ND': 'north-dakota',
  'OH': 'ohio',
  'OK': 'oklahoma',
  'OR': 'oregon',
  'PA': 'pennsylvania',
  'RI': 'rhode-island',
  'SC': 'south-carolina',
  'SD': 'south-dakota',
  'TN': 'tennessee',
  'TX': 'texas',
  'UT': 'utah',
  'VT': 'vermont',
  'VA': 'virginia',
  'WA': 'washington',
  'WV': 'west-virginia',
  'WI': 'wisconsin',
  'WY': 'wyoming'
};
---

<Layout
  title="Fishing Spots Near You - Search Results"
  description="Find fishing spots near your location. Browse public access fishing locations with GPS coordinates and amenities."
>
  <section class="retro-page-header">
    <div class="container">
      <h1 id="page-title">Fishing Spots Near You</h1>
      <p class="subtitle" id="subtitle">
        Loading fishing spots...
      </p>
    </div>
  </section>

  <section class="retro-container">
    <form class="search-box-top" id="search-form">
      <input
        type="text"
        name="q"
        placeholder="Search by location, lake, county..."
        id="search-input"
        class="retro-input"
      />
      <button type="submit" class="retro-btn retro-btn-search">Search</button>
    </form>

    <div class="retro-notice retro-notice-error" id="error-message" style="display: none;">
      <p id="error-text"></p>
    </div>

    <div class="search-results-info" id="search-info" style="display: none;">
      <p id="search-query-text"></p>
      <a href="/" class="new-search-btn">New Search</a>
    </div>

    <div class="data-accuracy-notice">
      <span class="notice-icon">ℹ️</span>
      <p><strong>Data Accuracy Notice:</strong> We're actively improving our database. If you find inaccurate or duplicate spots, we appreciate your patience as we refine the data.</p>
    </div>

    <div class="filters">
      <div class="filter-controls">
        <label for="type-filter">Filter:</label>
        <select id="type-filter" class="retro-select">
          <option value="">All types</option>
          <option value="lake">Lakes</option>
          <option value="public_water">Public Waters</option>
          <option value="state_park">State Parks</option>
          <option value="river_access">River Access</option>
          <option value="fishing_pier">Fishing Piers</option>
        </select>
      </div>
    </div>

    <div class="retro-grid retro-grid-spots" id="spots-container">
      <div class="loading">Loading fishing spots...</div>
    </div>

    <div class="no-results" id="no-results" style="display: none;">
      <p>No fishing spots found. Try adjusting your search or filters.</p>
    </div>
  </section>
</Layout>

<style is:global>
  /* Page-specific styles only - common styles in retro-common.css */

  .subtitle {
    margin-bottom: 0;
    font-size: 0.95rem;
  }

  .search-box-top {
    display: flex;
    max-width: 700px;
    margin: 0 auto 1.5rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .search-box-top input {
    flex: 1;
    min-width: 250px;
  }

  .filters {
    margin-bottom: 1.5rem;
  }

  .filter-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0;
    flex-wrap: wrap;
  }

  .filter-controls label {
    font-weight: 600;
    color: var(--neutral-black);
    font-size: 0.9rem;
  }

  .loading {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    color: var(--neutral-gray);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .spot-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .spot-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .spot-header h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--neutral-black);
    font-weight: 900;
    flex: 1;
  }

  .spot-details {
    flex: 1;
  }

  .spot-details p {
    margin: 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .location {
    color: var(--neutral-black);
  }

  .water-body {
    color: #666;
    font-weight: 500;
  }

  .description {
    color: #666;
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 500;
  }

  .spot-footer {
    border-top: 3px solid var(--neutral-black);
    padding-top: 0.75rem;
  }

  .coordinates {
    font-size: 0.85rem;
    color: var(--neutral-gray);
    font-family: monospace;
    font-weight: 600;
  }

  .address {
    font-size: 0.9rem;
    color: var(--neutral-gray);
    font-weight: 600;
  }

  .distance {
    font-size: 0.95rem;
    color: var(--neutral-black);
    font-weight: 700;
  }

  .amenities-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }

  .amenity-badge {
    background: var(--box-sage);
    color: var(--neutral-black);
    padding: 0.4rem 0.7rem;
    border-radius: 0;
    font-size: 0.75rem;
    border: 2px solid var(--neutral-black);
    white-space: nowrap;
    font-weight: 700;
  }

  .no-results {
    text-align: center;
    padding: 3rem;
    color: var(--neutral-gray);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .search-results-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--neutral-bg);
    border-left: 3px solid var(--earth-olive);
    padding: 0.5rem 0.75rem;
    margin-bottom: 1rem;
  }

  .search-results-info p {
    margin: 0;
    color: var(--neutral-black);
    font-weight: 600;
    font-size: 0.85rem;
    flex: 1;
  }

  .new-search-btn {
    background: white;
    border: 2px solid var(--neutral-black);
    padding: 0.4rem 0.8rem;
    color: var(--neutral-black);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.8rem;
    transition: all 0.1s;
    white-space: nowrap;
  }

  .new-search-btn:hover {
    background: var(--accent-copper);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 rgba(0,0,0,0.2);
  }

  .data-accuracy-notice {
    background: var(--accent-cream);
    border: 2px solid var(--earth-olive);
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .data-accuracy-notice .notice-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .data-accuracy-notice p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--neutral-black);
  }

  .data-accuracy-notice strong {
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .retro-page-header h1 {
      font-size: 2rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .search-box-top {
      flex-direction: column;
    }

    .search-box-top input {
      min-width: 100%;
    }

    .filter-controls {
      gap: 0.5rem;
    }

    .filter-controls label:first-child {
      width: 100%;
    }

    .filter-controls select {
      flex: 1;
      min-width: 150px;
    }
  }
</style>

<script define:vars={{ stateSlugLookup }}>
  // API URL - use /api for production, localhost:8000 for local development
  const API_URL = window.location.hostname === 'localhost'
    ? 'http://localhost:8000'
    : `${window.location.protocol}//${window.location.host}/api`;
  let allSpots = [];
  let filteredSpots = [];

  // Get URL parameters
  const urlParams = new URLSearchParams(window.location.search);
  const searchQuery = urlParams.get('q') || '';
  const userLat = urlParams.get('lat') ? parseFloat(urlParams.get('lat')) : null;
  const userLon = urlParams.get('lon') ? parseFloat(urlParams.get('lon')) : null;

  // Update search input and UI
  const searchInput = document.getElementById('search-input');
  if (searchQuery && searchInput) {
    searchInput.value = searchQuery;
    document.getElementById('search-info').style.display = 'block';
    document.getElementById('search-query-text').textContent = `Showing results for "${searchQuery}"`;
  } else if (userLat && userLon) {
    document.getElementById('search-info').style.display = 'block';
    document.getElementById('search-query-text').textContent = `Showing results near your location`;
  }

  // Load spots from API (all states)
  async function loadSpots() {
    try {
      const response = await fetch(`${API_URL}/spots.php?limit=5000`);
      const data = await response.json();

      if (data.success) {
        allSpots = data.spots;
        filterAndDisplaySpots();
      } else {
        showError('Failed to load fishing spots');
      }
    } catch (error) {
      console.error('Error loading spots:', error);
      showError('Failed to load fishing spots. Please try again later.');
    }
  }

  // Calculate distance
  function calculateDistance(lat1, lon1, lat2, lon2) {
    const R = 3958.8; // Earth's radius in miles
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }

  function filterAndDisplaySpots() {
    // Apply search filter with improved matching
    if (searchQuery) {
      const query = searchQuery.toLowerCase().trim();

      // Split query into words for better matching
      const queryWords = query.split(/\s+/).filter(word => word.length > 0);

      filteredSpots = allSpots.filter(spot => {
        // Combine all searchable fields into one string
        const searchableText = [
          spot.name || '',
          spot.county || '',
          spot.water_body_name || '',
          spot.description || '',
          spot.spot_type ? spot.spot_type.replace('_', ' ') : '',
          spot.state || ''
        ].join(' ').toLowerCase();

        // Match if ANY word is found (OR logic)
        // This makes "lake travis" match spots with either "lake" OR "travis"
        const anyWordMatches = queryWords.some(word =>
          searchableText.includes(word)
        );

        // Also check if the exact phrase appears
        const exactMatch = searchableText.includes(query);

        return anyWordMatches || exactMatch;
      });
    } else {
      filteredSpots = allSpots;
    }

    // If user location is provided, calculate distances and sort by proximity
    if (userLat && userLon) {
      filteredSpots = filteredSpots.map(spot => ({
        ...spot,
        distance: calculateDistance(userLat, userLon, parseFloat(spot.latitude), parseFloat(spot.longitude))
      }));

      // Sort by distance (nearest first)
      filteredSpots.sort((a, b) => a.distance - b.distance);

      // Limit to nearest 100 spots for initial display
      filteredSpots = filteredSpots.slice(0, 100);
    }

    // Update subtitle
    const subtitle = document.getElementById('subtitle');
    const pageTitle = document.getElementById('page-title');
    if (subtitle) {
      if (userLat && userLon) {
        subtitle.textContent = `Showing ${filteredSpots.length} nearest fishing spots`;
        pageTitle.textContent = 'Fishing Spots Near You';
      } else if (searchQuery) {
        subtitle.textContent = `${filteredSpots.length} spots found`;
        pageTitle.textContent = `Results for "${searchQuery}"`;
      } else {
        subtitle.textContent = `${filteredSpots.length} fishing spots`;
      }
    }

    // Display spots
    displaySpots(filteredSpots);
  }

  // Helper function to create county slug for URLs
  function getCountySlug(countyName) {
    if (!countyName) return '';

    // Handle multi-county entries - use first county
    if (countyName.includes(',')) {
      countyName = countyName.split(',')[0].trim();
    }

    // Remove "County" suffix if present
    countyName = countyName.replace(/\s+County$/i, '').trim();

    // Convert to lowercase and replace spaces with hyphens
    return countyName.toLowerCase().replace(/\s+/g, '-');
  }

  function displaySpots(spots) {
    const container = document.getElementById('spots-container');
    const noResults = document.getElementById('no-results');

    if (spots.length === 0) {
      container.innerHTML = '';
      noResults.style.display = 'block';
      return;
    }

    noResults.style.display = 'none';

    container.innerHTML = spots.map(spot => {
      const displayName = spot.name.replace(/\s*\([a-z]+\d+\)\s*$/i, '');
      const amenities = spot.amenities ? (typeof spot.amenities === 'string' ? JSON.parse(spot.amenities) : spot.amenities) : {};
      const amenitiesJson = JSON.stringify(amenities);

      const prominentAmenities = [];
      const amenityIcons = {
        'boat_ramp': '🚤 Boat Ramp',
        'fishing_pier': '🎣 Pier',
        'fish_cleaning': '🔪 Cleaning Station',
        'restrooms': '🚻 Restrooms',
        'parking': '🅿️ Parking',
        'boat_trailer_parking': '🚢 Boat Trailer',
        'camping': '⛺ Camping',
        'lighting': '💡 Lighting',
        'picnic_area': '🧺 Picnic Area'
      };

      for (const [key, label] of Object.entries(amenityIcons)) {
        if (amenities[key] === true) {
          prominentAmenities.push(`<span class="amenity-badge">${label}</span>`);
        }
      }

      const amenitiesHtml = prominentAmenities.length > 0
        ? `<div class="amenities-row">${prominentAmenities.join('')}</div>`
        : '';

      // Get proper county slug for URL
      const countySlug = getCountySlug(spot.county);

      return `
      <a href="/${stateSlugLookup[spot.state]}/${countySlug}/${spot.slug}" class="retro-card spot-card" data-spot-type="${spot.spot_type}" data-amenities='${amenitiesJson}'>
        <div class="spot-header">
          <h3>${displayName}</h3>
          <span class="retro-badge spot-type">${spot.spot_type.replace('_', ' ')}</span>
        </div>
        <div class="spot-details">
          <p class="location">
            <strong>📍 ${spot.county === 'Multiple Counties' ? 'Multiple Counties' : spot.county + ' County'}, ${spot.state}</strong>
          </p>
          <p class="water-body">🌊 ${spot.water_body_name}</p>
          ${amenitiesHtml}
          <p class="description">${spot.description}</p>
        </div>
        <div class="spot-footer">
          ${spot.distance
            ? `<span class="distance">📍 ${spot.distance < 0.1 ? (spot.distance * 5280).toFixed(0) + ' ft' : spot.distance.toFixed(1) + ' mi'} away</span>`
            : spot.address
              ? `<span class="address">📍 ${spot.address}</span>`
              : `<span class="coordinates">${parseFloat(spot.latitude).toFixed(4)}, ${parseFloat(spot.longitude).toFixed(4)}</span>`
          }
        </div>
      </a>
      `;
    }).join('');
  }

  function showError(message) {
    const errorDiv = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');
    if (errorDiv && errorText) {
      errorText.textContent = message;
      errorDiv.style.display = 'block';
    }
    document.getElementById('spots-container').innerHTML = '';
  }

  // Search form handling (NOW WITH GEOCODING)
  const searchForm = document.getElementById('search-form');
  // 'searchInput' is defined earlier in your script, so this will work.
  
  searchForm?.addEventListener('submit', async (e) => {
    e.preventDefault(); // Stop the form from submitting
    console.log('Search submitted on /spots page...');

    const query = searchInput.value.trim();
    if (!query) return;

    console.log(`Search query: ${query}`);

    // Get the search button to show a loading state
    const searchButton = searchForm.querySelector('button[type="submit"]');
    if (searchButton) {
      searchButton.innerHTML = 'Searching...';
      searchButton.disabled = true;
    }

    try {
      // --- MAKE SURE YOUR EMAIL HERE IS CORRECT ---
      const email = 'tyler@netlace.xyz'; 
      
      // Make the query more specific for better results
      const specificQuery = query + ', texas'; 
      const apiUrl = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(specificQuery)}&format=json&limit=1&email=${email}`;

      console.log(`Fetching from: ${apiUrl}`); // 1. DO YOU SEE THIS?

      // Call the API
      const response = await fetch(apiUrl);
      
      if (!response.ok) {
        console.error('Nominatim API request failed:', response.status, response.statusText);
        throw new Error(`API response not OK: ${response.status}`);
      }
      
      const data = await response.json();
      console.log('Nominatim response:', data); // 2. WHAT DOES THIS SAY?

      // Check for results
      if (data && data.length > 0) {
        // Geocoding SUCCESS: Redirect to lat/lon URL
        const lat = data[0].lat;
        const lon = data[0].lon;
        console.log(`Geocoding success: lat=${lat}, lon=${lon}. Redirecting...`);
        // We are already on /spots, so just reload with new params
        window.location.href = `/spots?lat=${lat}&lon=${lon}`; 
      } else {
        // Geocoding FAILED: Fallback to text search
        console.log('No results from Nominatim. Falling back to text search.');
        window.location.href = `/spots?q=${encodeURIComponent(query)}`;
      }
    } catch (error) {
      console.error('Geocoding fetch error:', error);
      // Error: Fallback to text search
      console.log('Error during fetch. Falling back to text search.');
      window.location.href = `/spots?q=${encodeURIComponent(query)}`;
    }
  });

  // Type filter
  const typeFilter = document.getElementById('type-filter');
  typeFilter?.addEventListener('change', () => {
    const typeValue = typeFilter.value;
    const spotCards = document.querySelectorAll('.spot-card');

    spotCards.forEach((card) => {
      const cardType = card.getAttribute('data-spot-type');
      const amenitiesStr = card.getAttribute('data-amenities');

      if (!typeValue) {
        card.style.display = 'flex';
        return;
      }

      if (cardType === typeValue) {
        card.style.display = 'flex';
        return;
      }

      try {
        const amenities = JSON.parse(amenitiesStr || '{}');
        if (amenities[typeValue] === true) {
          card.style.display = 'flex';
          return;
        }
      } catch (e) {
        // Invalid JSON, ignore
      }

      card.style.display = 'none';
    });
  });

  // Load spots on page load
  loadSpots();
</script>
