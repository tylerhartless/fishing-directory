---

<Layout
  title="Fishing Spots Near You - Search Results"
  description="Find fishing spots near your location. Browse public access fishing locations with GPS coordinates and amenities."
>
  <section class="retro-page-header">
    <div class="container">
      <h1>Search Results</h1>
    </div>
  </section>

  <section class="retro-container">
    <div class="search-section">
      <div class="search-container">
        <!-- Results Header -->
        <div class="results-header">
          <div class="search-results-info" id="search-info">
            <div class="query-display">
              <span class="query-prompt">›</span>
              <span id="search-query-text">Finding fishing spots near you...</span>
            </div>
            <a href="/" class="new-search-btn">← New Search</a>
          </div>
        </div>

        <!-- Error Messages -->
        <div class="retro-notice retro-notice-error" id="error-message" style="display: none;">
          <div class="error-header">
            <span class="error-prompt">✖</span>
            <span>ERROR</span>
          </div>
          <p id="error-text"></p>
        </div>

        <!-- Filters -->
        <div class="filters">
          <div class="filter-controls">
            <label for="type-filter">Filter:</label>
            <select id="type-filter" class="retro-select">
              <option value="">All types</option>
              <option value="lake">Lakes</option>
              <option value="public_water">Public Waters</option>
              <option value="state_park">State Parks</option>
              <option value="river_access">River Access</option>
              <option value="fishing_pier">Fishing Piers</option>
            </select>
          </div>
        </div>

        <!-- Results Grid -->
        <div class="retro-grid retro-grid-spots" id="spots-container">
          <div class="loading">Loading fishing spots...</div>
        </div>

        <!-- No Results -->
        <div class="no-results" id="no-results" style="display: none;">
          <p>No fishing spots found. Try a different search.</p>
        </div>

        <!-- Data Notice (collapsed by default) -->
        <details class="data-accuracy-notice">
          <summary>
            <span class="notice-icon">⚠</span>
            <strong>Data Notice</strong>
            <span class="toggle-arrow">▼</span>
          </summary>
          <p>We're consolidating data from multiple TX agencies. Some duplicates exist. We're actively cleaning it up.</p>
        </details>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* =====================================
     RESULTS PAGE - MORPHS FROM SEARCH WIDGET
     ===================================== */

  /* Reduce the gradient spacer height for spots page only */
  .retro-page-header::after {
    height: 50px !important;
  }

  /* Tighten spacing after page header */
  .retro-page-header + .retro-container {
    padding-top: 0.5rem !important;
  }

  /* Results header - minimal spacing */
  .results-header {
    margin-bottom: 0.5rem;
    padding-bottom: 0;
    margin-top: 0;
    padding-top: 0;
    border-bottom: 2px solid rgba(168, 197, 168, 0.2);
  }

  [data-theme="light"] .results-header {
    border-bottom: 2px solid rgba(0, 0, 0, 0.1);
  }



  .filters {
    margin-bottom: 1.5rem;
    margin-top: 0;
  }

  .filter-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0;
    flex-wrap: wrap;
  }

  .filter-controls label {
    font-family: 'VT323', monospace;
    font-weight: 400;
    color: var(--earth-sand);
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    text-shadow:
      0 0 6px rgba(212, 165, 116, 0.4);
  }

  [data-theme="light"] .filter-controls label {
    color: var(--neutral-black);
    text-shadow: none;
    font-weight: 600;
  }

  /* Error Message */
  .retro-notice-error {
    background: rgba(255, 68, 68, 0.1);
    border: 2px solid rgba(255, 68, 68, 0.4);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  [data-theme="light"] .retro-notice-error {
    background: #ffe0e0;
    border: 3px solid #cc0000;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.2);
  }

  .error-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-family: 'VT323', monospace;
    font-size: 1.3rem;
    color: #ff6666;
    text-shadow: 0 0 6px rgba(255, 68, 68, 0.5);
  }

  [data-theme="light"] .error-header {
    color: #990000;
    text-shadow: none;
    font-weight: 700;
  }

  .error-prompt {
    font-size: 1.5rem;
  }

  .retro-notice-error p {
    margin: 0;
    font-family: 'VT323', monospace;
    font-size: 1.1rem;
    color: rgba(255, 102, 102, 0.9);
  }

  [data-theme="light"] .retro-notice-error p {
    color: #990000;
    font-weight: 600;
  }

  /* Loading State */
  .loading {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    font-family: 'VT323', monospace;
    color: var(--theme-text-sage);
    font-weight: 400;
    font-size: 1.5rem;
    text-shadow: 0 0 8px rgba(168, 197, 168, 0.5);
    animation: textPulse 1.5s ease-in-out infinite;
  }

  [data-theme="light"] .loading {
    color: var(--gray-dark);
    text-shadow: none;
    font-weight: 600;
    animation: none;
  }

  @keyframes textPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Unified card styling - matches county pages */
  .retro-card h3 {
    margin: 0 0 0.75rem 0;
    color: var(--neutral-white);
    font-size: 1.8rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-shadow:
      0 0 10px rgba(255, 255, 255, 0.6),
      0 0 20px rgba(255, 255, 255, 0.4);
  }

  [data-theme="light"] .retro-card h3 {
    color: var(--neutral-black);
    font-weight: 900;
    text-shadow: none;
  }

  /* Distance indicator - only on /spots page */
  .distance-indicator {
    color: var(--earth-sand);
    font-size: 1.1rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    margin-bottom: 0.5rem;
    text-shadow:
      0 0 8px rgba(212, 165, 116, 0.6),
      0 0 12px rgba(212, 165, 116, 0.4);
  }

  [data-theme="light"] .distance-indicator {
    color: var(--earth-rust);
    text-shadow: none;
    font-weight: 700;
  }

  .spot-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .amenities-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .amenity-badge {
    background: rgba(168, 197, 168, 0.15);
    border: 1px solid rgba(168, 197, 168, 0.3);
    color: var(--theme-text-sage);
    padding: 0.3rem 0.6rem;
    font-size: 1rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    text-shadow: none;
  }

  [data-theme="light"] .amenity-badge {
    background: rgba(122, 132, 80, 0.1);
    border: 1px solid rgba(122, 132, 80, 0.3);
    color: #5a6450;
    text-shadow: none;
    font-weight: 600;
  }

  /* Amenity placeholder styling */
  .amenity-placeholder {
    color: var(--theme-text-secondary);
    font-size: 0.95rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    font-style: italic;
    opacity: 0.6;
  }

  [data-theme="light"] .amenity-placeholder {
    color: var(--neutral-gray);
    font-weight: 500;
    opacity: 0.7;
  }

  /* Spot type badge styling */
  .spot-type {
    padding: 0.4rem 0.8rem;
    font-size: 1rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Colored card outlines and spot type badges based on spot type */

  /* Lake - Blue for dark, slate blue for light */
  .retro-card[data-spot-type="lake"] {
    border-color: var(--badge-lake);
    box-shadow: 0 0 12px rgba(92, 157, 255, 0.25);
  }

  .retro-card[data-spot-type="lake"] .spot-type {
    background: rgba(92, 157, 255, 0.2);
    border: 1px solid rgba(92, 157, 255, 0.5);
    color: var(--badge-lake);
    text-shadow: 0 0 6px rgba(92, 157, 255, 0.5);
  }

  [data-theme="light"] .retro-card[data-spot-type="lake"] {
    border-color: var(--badge-lake-light);
    box-shadow: 2px 2px 0 rgba(90, 107, 115, 0.2);
  }

  [data-theme="light"] .retro-card[data-spot-type="lake"] .spot-type {
    background: var(--badge-lake-light);
    border: 2px solid var(--badge-lake-border-light);
    color: #ffffff;
    text-shadow: none;
    font-weight: 700;
  }

  /* River Access - Purple for dark, deep purple for light */
  .retro-card[data-spot-type="river_access"] {
    border-color: var(--badge-river);
    box-shadow: 0 0 12px rgba(184, 141, 255, 0.25);
  }

  .retro-card[data-spot-type="river_access"] .spot-type {
    background: rgba(184, 141, 255, 0.2);
    border: 1px solid rgba(184, 141, 255, 0.5);
    color: var(--badge-river);
    text-shadow: 0 0 6px rgba(184, 141, 255, 0.5);
  }

  [data-theme="light"] .retro-card[data-spot-type="river_access"] {
    border-color: var(--badge-river-light);
    box-shadow: 2px 2px 0 rgba(107, 74, 158, 0.2);
  }

  [data-theme="light"] .retro-card[data-spot-type="river_access"] .spot-type {
    background: var(--badge-river-light);
    border: 2px solid var(--badge-river-border-light);
    color: #ffffff;
    text-shadow: none;
    font-weight: 700;
  }

  /* Public Water - Green for dark, forest green for light */
  .retro-card[data-spot-type="public_water"] {
    border-color: var(--badge-public);
    box-shadow: 0 0 12px rgba(126, 201, 126, 0.25);
  }

  .retro-card[data-spot-type="public_water"] .spot-type {
    background: rgba(126, 201, 126, 0.2);
    border: 1px solid rgba(126, 201, 126, 0.5);
    color: var(--badge-public);
    text-shadow: 0 0 6px rgba(126, 201, 126, 0.5);
  }

  [data-theme="light"] .retro-card[data-spot-type="public_water"] {
    border-color: var(--badge-public-light);
    box-shadow: 2px 2px 0 rgba(74, 103, 65, 0.2);
  }

  [data-theme="light"] .retro-card[data-spot-type="public_water"] .spot-type {
    background: var(--badge-public-light);
    border: 2px solid var(--badge-public-border-light);
    color: #ffffff;
    text-shadow: none;
    font-weight: 700;
  }

  /* State Park - Yellow-green for dark, olive green for light */
  .retro-card[data-spot-type="state_park"] {
    border-color: var(--badge-park);
    box-shadow: 0 0 12px rgba(168, 217, 110, 0.25);
  }

  .retro-card[data-spot-type="state_park"] .spot-type {
    background: rgba(168, 217, 110, 0.2);
    border: 1px solid rgba(168, 217, 110, 0.5);
    color: var(--badge-park);
    text-shadow: 0 0 6px rgba(168, 217, 110, 0.5);
  }

  [data-theme="light"] .retro-card[data-spot-type="state_park"] {
    border-color: var(--badge-park-light);
    box-shadow: 2px 2px 0 rgba(122, 132, 80, 0.2);
  }

  [data-theme="light"] .retro-card[data-spot-type="state_park"] .spot-type {
    background: var(--badge-park-light);
    border: 2px solid var(--badge-park-border-light);
    color: #ffffff;
    text-shadow: none;
    font-weight: 700;
  }

  /* Fishing Pier - Gold for dark, sandy tan for light */
  .retro-card[data-spot-type="fishing_pier"] {
    border-color: var(--badge-pier);
    box-shadow: 0 0 12px rgba(255, 184, 77, 0.25);
  }

  .retro-card[data-spot-type="fishing_pier"] .spot-type {
    background: rgba(255, 184, 77, 0.2);
    border: 1px solid rgba(255, 184, 77, 0.5);
    color: var(--badge-pier);
    text-shadow: 0 0 6px rgba(255, 184, 77, 0.5);
  }

  [data-theme="light"] .retro-card[data-spot-type="fishing_pier"] {
    border-color: var(--badge-pier-light);
    box-shadow: 2px 2px 0 rgba(212, 165, 116, 0.2);
  }

  [data-theme="light"] .retro-card[data-spot-type="fishing_pier"] .spot-type {
    background: var(--badge-pier-light);
    border: 2px solid var(--badge-pier-border-light);
    color: #2d2d2d;
    text-shadow: none;
    font-weight: 700;
  }

  .spot-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .spot-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .spot-header h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--neutral-black);
    font-weight: 900;
    flex: 1;
  }

  .spot-details {
    flex: 1;
  }

  .spot-details p {
    margin: 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .location {
    color: var(--neutral-black);
  }

  .water-body {
    color: var(--gray-medium);
    font-weight: 500;
  }

  .description {
    color: var(--gray-medium);
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 500;
  }

  .spot-footer {
    border-top: 3px solid var(--neutral-black);
    padding-top: 0.75rem;
  }

  .coordinates {
    font-size: 0.85rem;
    color: var(--neutral-gray);
    font-family: monospace;
    font-weight: 600;
  }

  .address {
    font-size: 0.9rem;
    color: var(--neutral-gray);
    font-weight: 600;
  }

  .distance {
    font-size: 0.95rem;
    color: var(--neutral-black);
    font-weight: 700;
  }


  .no-results {
    text-align: center;
    padding: 3rem;
    font-family: 'VT323', monospace;
    color: var(--earth-sand);
    font-weight: 400;
    font-size: 1.4rem;
    text-shadow:
      0 0 8px rgba(212, 165, 116, 0.5),
      0 0 15px rgba(212, 165, 116, 0.3);
  }

  [data-theme="light"] .no-results {
    color: var(--neutral-gray);
    text-shadow: none;
    font-weight: 600;
  }

  /* Search Results Info - clean and integrated */
  .search-results-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: 'VT323', monospace;
  }

  .query-display {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
  }

  .query-prompt {
    font-size: 1.4rem;
    color: rgba(168, 197, 168, 0.7);
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.5);
  }

  [data-theme="light"] .query-prompt {
    color: var(--accent-dark-orange);
    text-shadow: none;
    font-weight: 700;
  }

  .search-results-info #search-query-text {
    color: var(--theme-text-sage);
    font-size: 1.15rem;
    font-weight: 400;
    text-shadow: 0 0 4px rgba(168, 197, 168, 0.3);
  }

  [data-theme="light"] .search-results-info #search-query-text {
    color: var(--neutral-black);
    text-shadow: none;
    font-weight: 600;
  }

  .new-search-btn {
    background: rgba(168, 197, 168, 0.1);
    border: 1px solid rgba(168, 197, 168, 0.3);
    padding: 0.6rem 1.25rem;
    color: var(--theme-text-sage);
    text-decoration: none;
    font-weight: 400;
    font-size: 1.05rem;
    font-family: 'VT323', monospace;
    transition: all 0.2s;
    white-space: nowrap;
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.4);
  }

  [data-theme="light"] .new-search-btn {
    background: var(--accent-sage);
    border: 2px solid var(--neutral-black);
    color: var(--neutral-black);
    text-shadow: none;
    font-weight: 700;
  }

  .new-search-btn:hover {
    background: rgba(168, 197, 168, 0.2);
    border-color: rgba(168, 197, 168, 0.5);
    transform: translateY(-1px);
    box-shadow: 0 0 12px rgba(168, 197, 168, 0.4);
  }

  [data-theme="light"] .new-search-btn:hover {
    background: var(--box-moss);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 rgba(0,0,0,0.3);
  }

  .data-accuracy-notice {
    background: rgba(184, 92, 58, 0.1);
    border: 1px solid rgba(184, 92, 58, 0.3);
    margin-bottom: 1.5rem;
    font-family: 'VT323', monospace;
  }

  [data-theme="light"] .data-accuracy-notice {
    background: rgba(184, 92, 58, 0.05);
    border: 2px solid rgba(184, 92, 58, 0.2);
  }

  .data-accuracy-notice summary {
    padding: 0.75rem 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    user-select: none;
  }

  .data-accuracy-notice summary::-webkit-details-marker {
    display: none;
  }

  .data-accuracy-notice summary:hover {
    background: rgba(184, 92, 58, 0.08);
  }

  [data-theme="light"] .data-accuracy-notice summary:hover {
    background: rgba(184, 92, 58, 0.05);
  }

  .data-accuracy-notice .notice-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .data-accuracy-notice strong {
    font-weight: 400;
    color: var(--accent-cream);
    flex: 1;
    text-shadow:
      0 0 8px rgba(240, 230, 210, 0.5);
  }

  [data-theme="light"] .data-accuracy-notice strong {
    font-weight: 700;
    color: var(--neutral-black);
    text-shadow: none;
  }

  .data-accuracy-notice .toggle-arrow {
    font-size: 0.9rem;
    transition: transform 0.2s ease;
    color: var(--earth-sand);
  }

  [data-theme="light"] .data-accuracy-notice .toggle-arrow {
    color: var(--neutral-black);
  }

  .data-accuracy-notice[open] .toggle-arrow {
    transform: rotate(180deg);
  }

  .data-accuracy-notice p {
    margin: 0;
    padding: 0 1rem 0.75rem 1rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--earth-sand);
    font-weight: 400;
  }

  [data-theme="light"] .data-accuracy-notice p {
    color: var(--neutral-black);
    font-weight: 600;
  }

  /* =====================================
     PROGRESSIVE REVEAL ANIMATIONS
     ===================================== */

  /* Result cards fade in sequentially */
  .retro-card {
    opacity: 0;
    animation: revealCard 0.4s ease-out forwards;
  }

  @keyframes revealCard {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light mode: slide in from side (catalog page turn) */
  [data-theme="light"] .retro-card {
    animation: revealCardLight 0.35s ease-out forwards;
  }

  @keyframes revealCardLight {
    from {
      opacity: 0;
      transform: translateX(-15px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Stagger animation delays - set via JS */
  .retro-card:nth-child(1) { animation-delay: 0.05s; }
  .retro-card:nth-child(2) { animation-delay: 0.1s; }
  .retro-card:nth-child(3) { animation-delay: 0.15s; }
  .retro-card:nth-child(4) { animation-delay: 0.2s; }
  .retro-card:nth-child(5) { animation-delay: 0.25s; }
  .retro-card:nth-child(6) { animation-delay: 0.3s; }
  .retro-card:nth-child(7) { animation-delay: 0.35s; }
  .retro-card:nth-child(8) { animation-delay: 0.4s; }
  .retro-card:nth-child(9) { animation-delay: 0.45s; }
  .retro-card:nth-child(10) { animation-delay: 0.5s; }

  /* For cards beyond 10, cap the delay */
  .retro-card:nth-child(n+11) { animation-delay: 0.5s; }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .retro-card {
      animation: simpleFadeIn 0.2s ease-out forwards !important;
    }

    @keyframes simpleFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }

  /* =====================================
     RESPONSIVE
     ===================================== */

  @media (max-width: 768px) {
    .results-header {
      padding: 1.5rem 0;
    }

    .terminal-command {
      font-size: 1.5rem;
    }

    .terminal-status {
      font-size: 1.1rem;
    }

    .search-box-top {
      flex-direction: column;
    }

    .search-box-top input {
      min-width: 100%;
    }

    .filter-controls {
      gap: 0.5rem;
    }

    .filter-controls label:first-child {
      width: 100%;
    }

    .filter-controls select {
      flex: 1;
      min-width: 150px;
    }

    .terminal-line {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }

    .terminal-name {
      font-size: 1.1rem;
    }

    .terminal-prompt {
      font-size: 1.1rem;
    }

    .terminal-command {
      font-size: 0.9rem;
    }

    .terminal-field {
      flex-direction: column;
      gap: 0.2rem;
      font-size: 0.95rem;
    }

    .terminal-label {
      min-width: auto;
    }

    .search-results-info {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .new-search-btn {
      width: 100%;
      text-align: center;
    }
  }

  /* Stylistic fade-in animation for results */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Dark mode: subtle glow on fade-in */
  [data-theme="dark"] .retro-card {
    animation: fadeInUp 0.4s ease-out forwards;
  }

  /* Light mode: clean slide-in */
  [data-theme="light"] .retro-card {
    animation: fadeInUp 0.3s ease-out forwards;
  }
</style>

<script define:vars={{ stateSlugLookup }}>
  // API URL - dynamically construct based on environment
  const isDev = window.location.hostname === 'localhost' ||
                window.location.hostname.startsWith('100.') || // Tailscale IP
                window.location.hostname.startsWith('127.') || // Localhost variations
                window.location.port === '4321'; // Astro dev server

  const API_URL = isDev
    ? `http://${window.location.hostname}:8000` // Use same hostname but port 8000
    : `${window.location.protocol}//${window.location.host}/api`;
  let allSpots = [];
  let filteredSpots = [];

  // Get URL parameters
  const urlParams = new URLSearchParams(window.location.search);
  const searchQuery = urlParams.get('q') || '';
  const userLat = urlParams.get('lat') ? parseFloat(urlParams.get('lat')) : null;
  const userLon = urlParams.get('lon') ? parseFloat(urlParams.get('lon')) : null;

  // Update search query text (always visible)
  const searchQueryTextEl = document.getElementById('search-query-text');
  if (searchQuery) {
    searchQueryTextEl.textContent = `Searching for: "${searchQuery}"`;
  } else if (userLat && userLon) {
    searchQueryTextEl.textContent = `Searching near: ${userLat.toFixed(4)}, ${userLon.toFixed(4)}`;
  } else {
    searchQueryTextEl.textContent = `Loading fishing spots...`;
  }

  // Load spots from API (all states)
  async function loadSpots() {
    try {
      const response = await fetch(`${API_URL}/spots.php?limit=5000`);
      const data = await response.json();

      if (data.success) {
        allSpots = data.spots;
        filterAndDisplaySpots();
      } else {
        showError('Failed to load fishing spots');
      }
    } catch (error) {
      console.error('Error loading spots:', error);
      showError('Failed to load fishing spots. Please try again later.');
    }
  }

  // Calculate distance
  function calculateDistance(lat1, lon1, lat2, lon2) {
    const R = 3958.8; // Earth's radius in miles
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }

  function filterAndDisplaySpots() {
    // Apply search filter with improved matching
    if (searchQuery) {
      const query = searchQuery.toLowerCase().trim();

      // Split query into words for better matching
      const queryWords = query.split(/\s+/).filter(word => word.length > 0);

      filteredSpots = allSpots.filter(spot => {
        // Combine all searchable fields into one string
        const searchableText = [
          spot.name || '',
          spot.county || '',
          spot.water_body_name || '',
          spot.description || '',
          spot.spot_type ? spot.spot_type.replace('_', ' ') : '',
          spot.state || ''
        ].join(' ').toLowerCase();

        // Match if ANY word is found (OR logic)
        // This makes "lake travis" match spots with either "lake" OR "travis"
        const anyWordMatches = queryWords.some(word =>
          searchableText.includes(word)
        );

        // Also check if the exact phrase appears
        const exactMatch = searchableText.includes(query);

        return anyWordMatches || exactMatch;
      });
    } else {
      filteredSpots = allSpots;
    }

    // If user location is provided, calculate distances and sort by proximity
    if (userLat && userLon) {
      filteredSpots = filteredSpots.map(spot => ({
        ...spot,
        distance: calculateDistance(userLat, userLon, parseFloat(spot.latitude), parseFloat(spot.longitude))
      }));

      // Sort by distance (nearest first)
      filteredSpots.sort((a, b) => a.distance - b.distance);

      // Limit to nearest 100 spots for initial display
      filteredSpots = filteredSpots.slice(0, 100);
    }

    // Update search query text
    const searchQueryText = document.getElementById('search-query-text');
    if (searchQueryText) {
      if (userLat && userLon) {
        searchQueryText.textContent = `Found ${filteredSpots.length} spots nearby`;
      } else if (searchQuery) {
        searchQueryText.textContent = `${filteredSpots.length} results for "${searchQuery}"`;
      } else {
        searchQueryText.textContent = `${filteredSpots.length} fishing spots in Texas`;
      }
    }

    // Display spots
    displaySpots(filteredSpots);
  }

  // Helper function to create county slug for URLs
  function getCountySlug(countyName) {
    if (!countyName) return '';

    // Handle multi-county entries - use first county
    if (countyName.includes(',')) {
      countyName = countyName.split(',')[0].trim();
    }

    // Remove "County" suffix if present
    countyName = countyName.replace(/\s+County$/i, '').trim();

    // Convert to lowercase and replace spaces with hyphens
    return countyName.toLowerCase().replace(/\s+/g, '-');
  }

  function displaySpots(spots) {
    const container = document.getElementById('spots-container');
    const noResults = document.getElementById('no-results');

    if (spots.length === 0) {
      container.innerHTML = '';
      noResults.style.display = 'block';
      return;
    }

    noResults.style.display = 'none';

    // Add a stylistic delay before showing results (terminal-like loading)
    container.innerHTML = '<div class="loading">Processing results...</div>';

    setTimeout(() => {
      container.innerHTML = spots.map(spot => {
      const displayName = spot.name.replace(/\s*\([a-z]+\d+\)\s*$/i, '');
      const amenities = spot.amenities ? (typeof spot.amenities === 'string' ? JSON.parse(spot.amenities) : spot.amenities) : {};
      const amenitiesJson = JSON.stringify(amenities);

      const prominentAmenities = [];
      const amenityIcons = {
        'boat_ramp': '🚤 Boat Ramp',
        'fishing_pier': '🎣 Pier',
        'fish_cleaning': '🔪 Cleaning Station',
        'restrooms': '🚻 Restrooms',
        'parking': '🅿️ Parking',
        'boat_trailer_parking': '🚢 Boat Trailer',
        'camping': '⛺ Camping',
        'lighting': '💡 Lighting',
        'picnic_area': '🧺 Picnic Area'
      };

      for (const [key, label] of Object.entries(amenityIcons)) {
        if (amenities[key] === true) {
          prominentAmenities.push(`<span class="amenity-badge">${label}</span>`);
        }
      }

      const amenitiesHtml = prominentAmenities.length > 0
        ? `<div class="amenities-row">${prominentAmenities.join('')}</div>`
        : `<div class="amenities-row amenities-empty"><span class="amenity-placeholder">No amenities listed</span></div>`;

      const typeLabel = spot.spot_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

      // Get proper county slug for URL
      const countySlug = getCountySlug(spot.county);

      // Format distance if available
      const distanceHtml = spot.distance
        ? `<div class="distance-indicator">${spot.distance < 0.1 ? (spot.distance * 5280).toFixed(0) + ' ft away' : spot.distance.toFixed(1) + ' mi away'}</div>`
        : '';

      return `
        <a href="/${stateSlugLookup[spot.state]}/${countySlug}/${spot.slug}" class="retro-card" data-spot-type="${spot.spot_type}" data-amenities='${amenitiesJson}' data-spot-id="${spot.id}">
          <h3 style="view-transition-name: spot-title-${spot.id};">${displayName}</h3>
          ${distanceHtml}
          <div class="spot-meta">
            <span class="retro-badge spot-type">${typeLabel}</span>
          </div>
          ${amenitiesHtml}
        </a>
      `;
      }).join('');

      // Fade in results with CSS animation
      const cards = container.querySelectorAll('.retro-card');
      cards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.animation = `fadeInUp 0.4s ease-out ${index * 0.03}s forwards`;
      });
    }, 300); // 300ms delay - just enough to feel intentional
  }

  function showError(message) {
    const errorDiv = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');
    if (errorDiv && errorText) {
      errorText.textContent = message;
      errorDiv.style.display = 'block';
    }
    document.getElementById('spots-container').innerHTML = '';
  }

  // Search form handling (NOW WITH GEOCODING)
  const searchForm = document.getElementById('search-form');
  // 'searchInput' is defined earlier in your script, so this will work.
  
  searchForm?.addEventListener('submit', async (e) => {
    e.preventDefault(); // Stop the form from submitting
    console.log('Search submitted on /spots page...');

    const query = searchInput.value.trim();
    if (!query) return;

    console.log(`Search query: ${query}`);

    // Get the search button to show a loading state
    const searchButton = searchForm.querySelector('button[type="submit"]');
    if (searchButton) {
      searchButton.innerHTML = 'Searching...';
      searchButton.disabled = true;
    }

    try {
      // --- MAKE SURE YOUR EMAIL HERE IS CORRECT ---
      const email = 'tyler@netlace.xyz'; 
      
      // Make the query more specific for better results
      const specificQuery = query + ', texas'; 
      const apiUrl = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(specificQuery)}&format=json&limit=1&email=${email}`;

      console.log(`Fetching from: ${apiUrl}`); // 1. DO YOU SEE THIS?

      // Call the API
      const response = await fetch(apiUrl);
      
      if (!response.ok) {
        console.error('Nominatim API request failed:', response.status, response.statusText);
        throw new Error(`API response not OK: ${response.status}`);
      }
      
      const data = await response.json();
      console.log('Nominatim response:', data); // 2. WHAT DOES THIS SAY?

      // Check for results
      if (data && data.length > 0) {
        // Geocoding SUCCESS: Redirect to lat/lon URL
        const lat = data[0].lat;
        const lon = data[0].lon;
        console.log(`Geocoding success: lat=${lat}, lon=${lon}. Redirecting...`);
        // We are already on /spots, so just reload with new params
        window.location.href = `/spots?lat=${lat}&lon=${lon}`; 
      } else {
        // Geocoding FAILED: Fallback to text search
        console.log('No results from Nominatim. Falling back to text search.');
        window.location.href = `/spots?q=${encodeURIComponent(query)}`;
      }
    } catch (error) {
      console.error('Geocoding fetch error:', error);
      // Error: Fallback to text search
      console.log('Error during fetch. Falling back to text search.');
      window.location.href = `/spots?q=${encodeURIComponent(query)}`;
    }
  });

  // Type filter
  const typeFilter = document.getElementById('type-filter');
  typeFilter?.addEventListener('change', () => {
    const typeValue = typeFilter.value;
    const spotCards = document.querySelectorAll('.spot-card');

    spotCards.forEach((card) => {
      const cardType = card.getAttribute('data-spot-type');
      const amenitiesStr = card.getAttribute('data-amenities');

      if (!typeValue) {
        card.style.display = 'flex';
        return;
      }

      if (cardType === typeValue) {
        card.style.display = 'flex';
        return;
      }

      try {
        const amenities = JSON.parse(amenitiesStr || '{}');
        if (amenities[typeValue] === true) {
          card.style.display = 'flex';
          return;
        }
      } catch (e) {
        // Invalid JSON, ignore
      }

      card.style.display = 'none';
    });
  });

  // Load spots on initial page load
  loadSpots();

  // Re-load spots when navigating via View Transitions
  document.addEventListener('astro:page-load', () => {
    // Only run if we're on the spots page
    if (window.location.pathname === '/spots') {
      loadSpots();
    }
  });
</script>
