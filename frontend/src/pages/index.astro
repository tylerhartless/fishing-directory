---
import Layout from '../layouts/Layout.astro';
import SearchWidget from '../components/SearchWidget.tsx';
import DynamicSubtitle from '../components/DynamicSubtitle.tsx';
import ValuePropositionBadges from '../components/ValuePropositionBadges.tsx';
import StateParkNoLicenseCallout from '../components/StateParkNoLicenseCallout.tsx';
import WhatEachSpotIncludes from '../components/WhatEachSpotIncludes.tsx';
import CountyListing from '../components/CountyListing.tsx';

const nominatimEmail = import.meta.env.PUBLIC_NOMINATIM_EMAIL || 'contact@wherecanifish.com';
---

<Layout
  title="Find Fishing Spots Near You - Public Fishing Directory"
  description="Stop searching 'fishing spots near me' - find your perfect fishing location here! Discover thousands of public boat ramps, piers, and bank fishing spots with GPS coordinates, amenities, and real catches."
>
  <section class="retro-page-header">
    <div class="container">
      <h1>Fishing Spot Finder</h1>
      <DynamicSubtitle client:load />
    </div>
  </section>

  <section class="retro-container">
    <div class="search-section">
      <div class="search-container">
        <SearchWidget nominatimEmail={nominatimEmail} client:idle />
      </div>

      <!-- New Homepage Sections: Mobile-First Design -->
      <div class="homepage-content">
        <!-- Value Proposition Badges -->
        <ValuePropositionBadges client:load />

        <!-- State Parks No-License Callout (conditional, dynamic by state) -->
        <StateParkNoLicenseCallout client:load />

        <!-- What Each Spot Includes -->
        <WhatEachSpotIncludes client:load />

        <!-- County Listing (dynamic by IP-detected state) -->
        <CountyListing client:load />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* =====================================================
     HOMEPAGE REDESIGN - Mobile-First, Dual Theme
     ===================================================== */

  /* Search section container */
  .search-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .search-container {
    max-width: 900px;
    margin: 0 auto 2rem;
    background: rgba(30, 30, 30, 0.8);
    border: 2px solid rgba(168, 197, 168, 0.5);
    border-radius: 0;
    padding: 1.5rem;
    box-shadow:
      0 0 20px rgba(168, 197, 168, 0.3),
      inset 0 0 30px rgba(0, 0, 0, 0.5);
    color: var(--theme-text);
    transition: all 0.3s ease;
  }

  :global([data-theme="light"]) .search-container {
    background: white;
    border: 3px solid var(--neutral-black);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2);
  }

  /* Homepage Content Wrapper */
  .homepage-content {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* =====================================================
     VALUE PROPOSITION BADGES
     ===================================================== */

  .value-prop-section {
    margin-top: 2rem;
  }

  .section-header {
    font-family: 'VT323', monospace;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--theme-text-sage);
    text-align: center;
    margin-bottom: 2rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-shadow: 0 0 8px rgba(168, 197, 168, 0.4);
  }

  .header-prompt {
    color: var(--theme-text-sage);
    margin-right: 0.5rem;
  }

  :global([data-theme="light"]) .section-header {
    color: var(--neutral-black);
    font-weight: 700;
    text-shadow: none;
  }

  :global([data-theme="light"]) .header-prompt {
    color: var(--boat-orange);
  }

  /* Badge Grid */
  .badge-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .badge-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Individual Badge - Dark Mode (Terminal) */
  .value-badge {
    /* Match search container aesthetic */
    background: var(--rgba-dark-bg-80);
    border: 2px solid var(--rgba-sage-60);
    border-radius: 0;
    padding: 1.5rem;
    box-shadow:
      0 0 15px var(--rgba-sage-30),
      inset 0 0 30px var(--rgba-gray-30);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    transition: all 0.2s;
  }

  /* Scanline effect like search container */
  .value-badge::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      var(--rgba-black-15) 0px,
      transparent 1px,
      transparent 2px,
      var(--rgba-black-15) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .value-badge > * {
    position: relative;
    z-index: 2;
  }

  .value-badge:hover {
    border-color: var(--rgba-sage-80);
    box-shadow:
      0 0 20px var(--rgba-sage-50),
      inset 0 0 30px var(--rgba-gray-30);
  }

  /* Badge Icon */
  .badge-icon {
    font-size: 1.5rem;
    color: var(--theme-text-sage);
    flex-shrink: 0;
    text-shadow: 0 0 8px rgba(168, 197, 168, 0.6);
  }

  .badge-content h3 {
    font-family: 'VT323', monospace;
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--theme-text-sage);
    margin: 0 0 0.5rem 0;
    letter-spacing: 0.05em;
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.4);
  }

  .badge-content p {
    font-family: 'VT323', monospace;
    font-size: 1rem;
    font-weight: 400;
    color: var(--theme-text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  /* Light Mode (80s/90s Catalog) */
  :global([data-theme="light"]) .value-badge {
    background: #ffffff;
    border: 4px dashed #999999;
    box-shadow: none;
    border-radius: 8px;
  }

  :global([data-theme="light"]) .value-badge::before {
    background: none;
  }

  :global([data-theme="light"]) .value-badge:hover {
    border-color: #00CED1;
    box-shadow: 0 4px 12px rgba(0, 206, 209, 0.2);
  }

  :global([data-theme="light"]) .badge-icon {
    color: #20B2AA;
    font-size: 2rem;
    text-shadow: none;
  }

  :global([data-theme="light"]) .badge-content h3 {
    color: #333333;
    font-weight: 900;
    text-shadow: none;
    font-size: 1rem;
    letter-spacing: 0.08em;
  }

  :global([data-theme="light"]) .badge-content p {
    color: #555555;
    font-weight: 600;
  }

  /* =====================================================
     STATE PARKS NO-LICENSE CALLOUT
     ===================================================== */

  .no-license-callout {
    /* Dark mode: match search container */
    background: var(--rgba-dark-bg-80);
    border: 2px solid var(--rgba-sage-60);
    border-radius: 0;
    padding: 2rem;
    box-shadow:
      0 0 15px var(--rgba-sage-30),
      inset 0 0 30px var(--rgba-gray-30);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .no-license-callout::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      var(--rgba-black-15) 0px,
      transparent 1px,
      transparent 2px,
      var(--rgba-black-15) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .no-license-callout > * {
    position: relative;
    z-index: 2;
  }

  .callout-icon {
    font-size: 3rem;
    flex-shrink: 0;
  }

  .callout-content {
    flex: 1;
  }

  .callout-title {
    font-family: 'VT323', monospace;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--theme-text-sage);
    margin: 0 0 0.75rem 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-shadow: 0 0 8px rgba(168, 197, 168, 0.5);
  }

  .callout-text {
    font-family: 'VT323', monospace;
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--theme-text-secondary);
    margin: 0 0 1rem 0;
    line-height: 1.5;
  }

  .callout-link {
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--theme-text-sage);
    text-decoration: none;
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--rgba-sage-15);
    border: 2px solid var(--rgba-sage-50);
    transition: all 0.2s;
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.4);
  }

  .callout-link:hover {
    background: var(--rgba-sage-25);
    border-color: var(--rgba-sage-80);
    box-shadow: 0 0 15px var(--rgba-sage-50);
  }

  /* Light Mode */
  :global([data-theme="light"]) .no-license-callout {
    background: #FFF9E6;
    border: 4px solid #FF6B6B;
    box-shadow: 6px 6px 0 rgba(255, 107, 107, 0.2);
    border-radius: 8px;
  }

  :global([data-theme="light"]) .no-license-callout::before {
    background: none;
  }

  :global([data-theme="light"]) .callout-title {
    color: #333333;
    font-weight: 900;
    text-shadow: none;
  }

  :global([data-theme="light"]) .callout-text {
    color: #555555;
    font-weight: 600;
  }

  :global([data-theme="light"]) .callout-link {
    background: linear-gradient(180deg, #FF6B6B 0%, #d15820 100%);
    color: white;
    border: 3px solid #333333;
    font-weight: 900;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.3);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  :global([data-theme="light"]) .callout-link:hover {
    background: linear-gradient(180deg, #FF8C42 0%, #FF6B6B 100%);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.4);
  }

  /* =====================================================
     WHAT EACH SPOT INCLUDES SECTION
     ===================================================== */

  .spot-features-section {
    margin: 2rem 0;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .features-list li {
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--theme-text-secondary);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  .feature-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .feature-text {
    flex: 1;
  }

  :global([data-theme="light"]) .features-list li {
    color: #555555;
    font-weight: 600;
  }

  /* =====================================================
     COUNTY LISTING SECTION
     ===================================================== */

  .county-listing-section {
    margin: 2rem 0;
  }

  .loading-text {
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    color: var(--theme-text-secondary);
    text-align: center;
    padding: 2rem;
  }

  .county-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  /* County Item - Dark Mode */
  .county-item {
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--theme-text-sage);
    text-decoration: none;
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--rgba-dark-bg-80);
    border: 2px solid var(--rgba-sage-40);
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 10px var(--rgba-sage-20);
  }

  .county-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      var(--rgba-black-15) 0px,
      transparent 1px,
      transparent 2px,
      var(--rgba-black-15) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .county-item > * {
    position: relative;
    z-index: 2;
  }

  .county-item:hover {
    border-color: var(--rgba-sage-80);
    box-shadow: 0 0 15px var(--rgba-sage-40);
    text-shadow: 0 0 8px rgba(168, 197, 168, 0.6);
  }

  .county-name {
    flex-shrink: 0;
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.4);
  }

  .county-dots {
    flex: 1;
    height: 1px;
    background-image: repeating-linear-gradient(
      to right,
      var(--rgba-sage-40) 0,
      var(--rgba-sage-40) 4px,
      transparent 4px,
      transparent 8px
    );
    margin: 0 1rem;
  }

  .county-count {
    flex-shrink: 0;
    font-weight: 400;
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.4);
  }

  /* County Item - Light Mode (Catalog) */
  :global([data-theme="light"]) .county-item {
    background: white;
    border: 3px solid #999999;
    color: #333333;
    font-weight: 700;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.1);
  }

  :global([data-theme="light"]) .county-item::before {
    background: none;
  }

  :global([data-theme="light"]) .county-item:hover {
    border-color: #00CED1;
    box-shadow: 4px 4px 0 rgba(0, 206, 209, 0.2);
    text-shadow: none;
  }

  :global([data-theme="light"]) .county-name,
  :global([data-theme="light"]) .county-count {
    text-shadow: none;
  }

  :global([data-theme="light"]) .county-dots {
    background-image: repeating-linear-gradient(
      to right,
      #999999 0,
      #999999 4px,
      transparent 4px,
      transparent 8px
    );
  }

  /* County Actions */
  .county-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .btn-county-all,
  .btn-county-browse {
    display: block;
    width: 100%;
    padding: 1rem 2rem;
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--theme-text-sage);
    text-decoration: none;
    text-align: center;
    background: var(--rgba-sage-15);
    border: 2px solid var(--rgba-sage-50);
    transition: all 0.2s;
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.4);
    box-shadow: 0 0 10px var(--rgba-sage-30);
  }

  .btn-county-all:hover,
  .btn-county-browse:hover {
    background: var(--rgba-sage-25);
    border-color: var(--rgba-sage-80);
    box-shadow: 0 0 15px var(--rgba-sage-50);
  }

  /* Light Mode Buttons */
  :global([data-theme="light"]) .btn-county-all,
  :global([data-theme="light"]) .btn-county-browse {
    background: white;
    color: #333333;
    border: 3px solid #333333;
    font-weight: 900;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.2);
    text-shadow: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global([data-theme="light"]) .btn-county-all:hover,
  :global([data-theme="light"]) .btn-county-browse:hover {
    background: linear-gradient(180deg, #FF8C42 0%, #FF6B6B 100%);
    color: white;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.3);
  }

  /* =====================================================
     MOBILE RESPONSIVE
     ===================================================== */

  @media (max-width: 768px) {
    .search-container {
      padding: 0.75rem;
      border-width: 3px;
      margin-bottom: 1.5rem;
    }

    .homepage-content {
      gap: 2rem;
    }

    .section-header {
      font-size: 1.3rem;
    }

    .badge-grid {
      gap: 0.75rem;
    }

    .value-badge {
      padding: 1.25rem;
    }

    .no-license-callout {
      flex-direction: column;
      padding: 1.5rem;
      gap: 1rem;
    }

    .callout-icon {
      font-size: 2.5rem;
    }

    .callout-title {
      font-size: 1.2rem;
    }

    .callout-text {
      font-size: 1rem;
    }
  }

  @media (min-width: 640px) {
    .county-actions {
      flex-direction: row;
    }

    .btn-county-all,
    .btn-county-browse {
      width: auto;
      flex: 1;
    }
  }
</style>
