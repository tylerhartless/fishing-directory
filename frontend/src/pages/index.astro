---
import Layout from '../layouts/Layout.astro';
import SearchWidget from '../components/SearchWidget.tsx';
import DynamicSubtitle from '../components/DynamicSubtitle.tsx';
import ValuePropositionBadges from '../components/ValuePropositionBadges.tsx';
import SpecialLandingPageCallout from '../components/SpecialLandingPageCallout.tsx';
import WhatEachListingIncludes from '../components/WhatEachListingIncludes.tsx';
import CountyListing from '../components/CountyListing.tsx';

const nominatimEmail = import.meta.env.PUBLIC_NOMINATIM_EMAIL || 'contact@wherecanifish.com';
---

<Layout
  title="Find Fishing Spots Near You - Public Fishing Directory"
  description="Find public fishing spots near you. Thousands of boat ramps, piers, and bank fishing locations with GPS coordinates, amenities, and real catches."
>
  <section class="retro-page-header">
    <div class="container">
      <h1>FISHING SPOT FINDER</h1>
      <DynamicSubtitle client:load />
    </div>
  </section>

  <section class="retro-container">
    <div class="search-section">
      <div class="search-container">
        <SearchWidget nominatimEmail={nominatimEmail} client:idle />
      </div>

      <!-- New Homepage Sections: Mobile-First Design -->
      <div class="homepage-content">
        <!-- Scroll Prompt - Interstitial Element -->
        <div class="scroll-prompt">
          <span class="scroll-arrow">↓</span>
          <span class="scroll-text">WHY USE THIS DIRECTORY?</span>
          <span class="scroll-arrow">↓</span>
        </div>

        <!-- Value Proposition Badges -->
        <ValuePropositionBadges client:load />

        <!-- State Parks No-License Callout (conditional, dynamic by state) -->
        <SpecialLandingPageCallout geolocateOnly={true} client:load />

        <!-- What Each Listing Includes -->
        <WhatEachListingIncludes client:load />

        <!-- County Listing (dynamic by IP-detected state) -->
        <CountyListing client:load />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Homepage-specific layout styles only - component styles in retro-common.css */

  .search-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .search-container {
    max-width: 900px;
    margin: 0 auto 2rem;
    background: rgba(30, 30, 30, 0.8);
    border: 2px solid rgba(168, 197, 168, 0.5);
    border-radius: 0;
    padding: 1.5rem;
    box-shadow:
      0 0 20px rgba(168, 197, 168, 0.3),
      inset 0 0 30px rgba(0, 0, 0, 0.5);
    color: var(--theme-text);
    transition: all 0.3s ease;
  }

  :global([data-theme="light"]) .search-container {
    background: white;
    border: 3px solid var(--neutral-black);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2);
  }

  .homepage-content {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .search-container {
      padding: 0.75rem;
      border-width: 3px;
      margin-bottom: 1.5rem;
    }

    .homepage-content {
      gap: 1.25rem;
    }
  }
</style>
