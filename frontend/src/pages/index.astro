---
import Layout from '../layouts/Layout.astro';
import SearchWidget from '../components/SearchWidget.tsx';

const nominatimEmail = import.meta.env.PUBLIC_NOMINATIM_EMAIL || 'contact@wherecanifish.com';
---

<Layout
  title="Find Fishing Spots Near You - Public Fishing Directory"
  description="Stop searching 'fishing spots near me' - find your perfect fishing location here! Discover thousands of public boat ramps, piers, and bank fishing spots with GPS coordinates, amenities, and real catches."
>
  <section class="hero">
    <div class="rainbow-accent"></div>
    <div class="container">
      <div class="hero-header">
        <h1>Fishing Spot Finder</h1>
        <p class="tagline">Stop fishing for spots near you and catch one here! 🎣</p>
      </div>

      <div class="search-container">
        <SearchWidget nominatimEmail={nominatimEmail} client:idle />
      </div>

      <div class="status-banner">
        🚧 Currently covering Texas only • More states & user submissions coming soon
      </div>

      <div class="quick-stats">
        <div class="stat stat-red">
          <strong>3,300+</strong>
          <span>Fishing Spots</span>
        </div>
        <div class="stat stat-green">
          <strong>Texas</strong>
          <span>Available Now</span>
        </div>
        <div class="stat stat-blue">
          <strong>100%</strong>
          <span>Public Access</span>
        </div>
      </div>
    </div>
  </section>

  <section class="container popular-locations">
    <h2>Popular Fishing Locations</h2>
    <p class="section-subtitle">Most enriched areas with complete amenity data</p>

    <div class="location-grid">
      <a href="/texas/harris" class="location-card retro-card">
        <div class="location-header">
          <h3>Harris County</h3>
          <span class="spot-count">450+ spots</span>
        </div>
        <p>Houston metro area with diverse fishing opportunities</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🚤 Boat Ramps</span>
          <span class="feature-badge">🅿️ Parking Info</span>
        </div>
      </a>

      <a href="/texas/travis" class="location-card retro-card">
        <div class="location-header">
          <h3>Travis County</h3>
          <span class="spot-count">280+ spots</span>
        </div>
        <p>Austin lakes and Colorado River access</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🎣 Pier Access</span>
          <span class="feature-badge">🏞️ Parks</span>
        </div>
      </a>

      <a href="/texas/tarrant" class="location-card retro-card">
        <div class="location-header">
          <h3>Tarrant County</h3>
          <span class="spot-count">220+ spots</span>
        </div>
        <p>Fort Worth area urban fishing destinations</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🌊 Lakes</span>
          <span class="feature-badge">🎯 Easy Access</span>
        </div>
      </a>

      <a href="/texas/bexar" class="location-card retro-card">
        <div class="location-header">
          <h3>Bexar County</h3>
          <span class="spot-count">180+ spots</span>
        </div>
        <p>San Antonio fishing lakes and rivers</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🏕️ Recreation</span>
          <span class="feature-badge">🌳 Nature</span>
        </div>
      </a>
    </div>

    <div class="browse-all">
      <a href="/texas" class="btn-secondary">Browse All Texas Locations →</a>
    </div>
  </section>

  <section class="features-section">
    <div class="container">
      <h2>Why Fishermen Love This Directory</h2>
      <div class="features-grid">
        <div class="feature retro-card">
          <div class="feature-icon">📍</div>
          <h3>Exact GPS Coordinates</h3>
          <p>Navigate directly to every fishing spot with precise location data</p>
        </div>
        <div class="feature retro-card">
          <div class="feature-icon">✅</div>
          <h3>Sourced from State Data</h3>
          <p>Data from official sources - we're actively improving accuracy and removing duplicates</p>
        </div>
        <div class="feature retro-card">
          <div class="feature-icon">🚤</div>
          <h3>Amenities Listed</h3>
          <p>Know before you go: parking, restrooms, boat ramps, and facilities</p>
        </div>
        <div class="feature retro-card">
          <div class="feature-icon">🆓</div>
          <h3>Public Fishing Access</h3>
          <p>All locations allow public fishing. Most are free, though some parks and facilities may charge entrance fees.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container coverage-section">
    <h2>Current Coverage</h2>
    <div class="coverage-info">
      <div class="coverage-state active retro-card">
        <h3>🎣 Texas</h3>
        <p><strong>3,300+ spots</strong> across 254 counties</p>
        <ul>
          <li>Boat ramps, fishing piers, and lake access</li>
          <li>State parks and public waters</li>
          <li>GPS coordinates for every location</li>
        </ul>
      </div>
      <div class="coverage-state coming-soon retro-card">
        <h3>🚧 Coming Soon</h3>
        <p>Florida, Louisiana, Georgia & more southern states</p>
        <p class="stay-tuned">Building comprehensive directories with the same attention to detail</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(180deg, #0d1f0d 0%, #121212 20%, #151515 40%, #1a1a1a 60%, #222222 80%, #2a2a2a 100%);
    color: white;
    padding: 0;
    text-align: center;
    position: relative;
    transition: background 0.3s ease;
  }

  :global([data-theme="light"]) .hero {
    background: linear-gradient(180deg, #0d1f0d 0%, #1a1a1a 15%, #2a2a2a 25%, #3a3a3a 35%, #4a4a4a 45%, #6a6a6a 55%, #8a8a8a 65%, #a0a0a0 75%, #c0c0c0 85%, #d5d5d5 92%, #e8e8e8 96%, #f5f5f5 100%);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.15) 0px,
      transparent 1px,
      transparent 2px,
      rgba(0, 0, 0, 0.15) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .hero .container {
    position: relative;
    z-index: 2;
    padding: 1.25rem 2rem 3.5rem;
  }

  .rainbow-accent {
    height: 4px;
    background: repeating-linear-gradient(
      to right,
      var(--earth-rust) 0px,
      var(--earth-rust) 8px,
      transparent 8px,
      transparent 16px
    );
    position: relative;
    z-index: 2;
    box-shadow:
      0 0 12px rgba(184, 92, 58, 0.8),
      0 0 20px rgba(184, 92, 58, 0.6),
      0 0 30px rgba(184, 92, 58, 0.4),
      0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .hero-header {
    margin-bottom: 2rem;
  }

  .hero h1 {
    font-family: 'VT323', monospace;
    font-size: 3.5rem;
    margin: 0 0 0.5rem 0;
    font-weight: 400;
    letter-spacing: 0.05em;
    line-height: 1.1;
    color: #f0e6d2;
    text-shadow:
      0 0 10px rgba(240, 230, 210, 0.8),
      0 0 20px rgba(240, 230, 210, 0.6),
      0 0 40px rgba(240, 230, 210, 0.4),
      4px 4px 0 rgba(0,0,0,0.3);
  }

  .tagline {
    font-family: 'VT323', monospace;
    font-size: 1.8rem;
    margin: 0;
    color: #a8c5a8;
    text-shadow:
      0 0 8px rgba(168, 197, 168, 0.6),
      0 0 15px rgba(168, 197, 168, 0.4);
    font-weight: 400;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .search-container {
    max-width: 700px;
    margin: 0 auto 1rem;
    background: rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(184, 92, 58, 0.5);
    border-radius: 0;
    padding: 1.5rem;
    box-shadow:
      0 0 20px rgba(184, 92, 58, 0.3),
      inset 0 0 30px rgba(0, 0, 0, 0.5);
    color: var(--theme-text);
    transition: all 0.3s ease;
  }

  :global([data-theme="light"]) .search-container {
    background: #f8f8f8;
    border: 3px solid rgba(212, 165, 116, 0.4);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.08);
  }

  .status-banner {
    max-width: 700px;
    margin: 0 auto 2rem;
    background: rgba(184, 92, 58, 0.2);
    border: 2px solid rgba(184, 92, 58, 0.5);
    padding: 0.75rem 1.5rem;
    text-align: center;
    color: #d4a574;
    font-family: 'VT323', monospace;
    font-weight: 400;
    font-size: 1.05rem;
    transition: all 0.3s ease;
    box-shadow:
      0 0 10px rgba(184, 92, 58, 0.3),
      inset 0 0 20px rgba(0, 0, 0, 0.3);
    text-shadow:
      0 0 6px rgba(212, 165, 116, 0.4);
  }

  :global([data-theme="light"]) .status-banner {
    background: var(--accent-cream);
    border: 2px solid var(--earth-rust);
    color: var(--neutral-black);
    box-shadow: none;
    text-shadow: none;
    font-weight: 600;
  }

  .quick-stats {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(40, 40, 40, 0.8);
    border: 2px solid;
    padding: 1.5rem 2rem;
    min-width: 140px;
    box-shadow:
      0 0 15px rgba(184, 92, 58, 0.3),
      inset 0 0 30px rgba(100, 100, 100, 0.3);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .stat::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.15) 0px,
      transparent 1px,
      transparent 2px,
      rgba(0, 0, 0, 0.15) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .stat > * {
    position: relative;
    z-index: 2;
  }

  :global([data-theme="light"]) .stat {
    background: white;
    border: 3px solid;
    box-shadow: 6px 6px 0 rgba(0,0,0,0.2);
  }

  :global([data-theme="light"]) .stat::before {
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.02) 0px,
      transparent 1px,
      transparent 2px,
      rgba(0, 0, 0, 0.02) 3px
    );
  }

  .stat-red {
    border-color: var(--earth-rust);
  }

  .stat-green {
    border-color: var(--earth-forest);
  }

  .stat-blue {
    border-color: var(--earth-slate);
  }

  .stat strong {
    font-size: 2.5rem;
    display: block;
    font-family: 'VT323', monospace;
    font-weight: 400;
    color: #f0e6d2;
    transition: color 0.3s ease;
    text-shadow:
      0 0 10px rgba(240, 230, 210, 0.6),
      0 0 20px rgba(240, 230, 210, 0.4);
  }

  :global([data-theme="light"]) .stat strong {
    color: var(--neutral-black);
    font-weight: 900;
    text-shadow: none;
  }

  .stat span {
    font-size: 0.9rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    color: #a8c5a8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
    text-shadow:
      0 0 6px rgba(168, 197, 168, 0.4);
  }

  :global([data-theme="light"]) .stat span {
    color: var(--neutral-gray);
    font-weight: 600;
    text-shadow: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }

  h2 {
    font-family: 'VT323', monospace;
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    text-align: center;
    color: var(--neutral-black);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    display: inline-block;
    width: 100%;
    transition: color 0.3s ease;
  }

  :global([data-theme="dark"]) h2 {
    color: var(--theme-text);
  }

  h2::after {
    content: '';
    display: block;
    width: 150px;
    height: 6px;
    background: var(--rainbow-gradient);
    margin: 0.5rem auto 0;
  }

  .section-subtitle {
    font-family: 'VT323', monospace;
    text-align: center;
    color: #666;
    font-size: 1.4rem;
    margin-bottom: 2rem;
    font-weight: 400;
    transition: color 0.3s ease;
  }

  :global([data-theme="dark"]) .section-subtitle {
    color: var(--theme-text-secondary);
  }

  .popular-locations {
    background: #2a2a2a;
    transition: background 0.3s ease;
  }

  :global([data-theme="light"]) .popular-locations {
    background: var(--neutral-bg);
  }

  .location-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  /* Location cards inherit from retro-card, only add specific styling */
  .location-card:nth-child(1) {
    border-color: var(--box-sage);
  }

  .location-card:nth-child(2) {
    border-color: var(--box-rust);
  }

  .location-card:nth-child(3) {
    border-color: var(--box-moss);
  }

  .location-card:nth-child(4) {
    border-color: var(--box-tan);
  }

  .location-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .location-header h3 {
    margin: 0;
    color: #f0e6d2;
    font-size: 1.4rem;
    font-weight: 400;
    font-family: 'VT323', monospace;
    letter-spacing: 0.02em;
    transition: color 0.3s ease;
    text-shadow:
      0 0 8px rgba(240, 230, 210, 0.5);
  }

  :global([data-theme="light"]) .location-header h3 {
    color: var(--neutral-black);
    font-weight: 900;
    text-shadow: none;
  }

  .spot-count {
    background: var(--neutral-black);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 0;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .location-card > p {
    color: #b0b0b0;
    margin: 0 0 1rem 0;
    line-height: 1.5;
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    font-weight: 400;
    transition: color 0.3s ease;
  }

  :global([data-theme="light"]) .location-card > p {
    color: #555;
    font-weight: 500;
  }

  .location-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature-badge {
    background: var(--neutral-black);
    color: white;
    padding: 0.4rem 0.7rem;
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .browse-all {
    text-align: center;
    margin-top: 1.5rem;
  }

  .btn-secondary {
    display: inline-block;
    padding: 1rem 2rem;
    font-family: 'VT323', monospace;
    background: rgba(184, 92, 58, 0.2);
    color: #d4a574;
    border: 2px solid rgba(184, 92, 58, 0.5);
    border-radius: 0;
    text-decoration: none;
    font-size: 1.15rem;
    font-weight: 400;
    transition: all 0.2s;
    box-shadow:
      0 0 10px rgba(184, 92, 58, 0.3),
      inset 0 0 20px rgba(100, 100, 100, 0.2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-shadow: 0 0 6px rgba(212, 165, 116, 0.4);
  }

  :global([data-theme="light"]) .btn-secondary {
    background: var(--box-clay);
    color: var(--primary-text);
    border: 3px solid var(--neutral-black);
    font-weight: 700;
    box-shadow: 4px 4px 0 rgba(0,0,0,0.3);
    text-shadow: none;
  }

  .btn-secondary:hover {
    background: rgba(212, 165, 116, 0.3);
    border-color: rgba(212, 165, 116, 0.7);
    box-shadow:
      0 0 15px rgba(212, 165, 116, 0.5),
      inset 0 0 20px rgba(100, 100, 100, 0.2);
    text-shadow: 0 0 8px rgba(212, 165, 116, 0.6);
  }

  :global([data-theme="light"]) .btn-secondary:hover {
    background: var(--accent-sage);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.3);
    text-shadow: none;
  }

  .features-section {
    background: #2a2a2a;
    padding: 2.5rem 0;
    transition: background 0.3s ease;
  }

  :global([data-theme="light"]) .features-section {
    background: var(--neutral-bg);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  /* Feature cards inherit from retro-card, only add specific styling */
  .feature {
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .feature:nth-child(1) {
    border-color: rgba(168, 197, 168, 0.5);
  }

  .feature:nth-child(2) {
    border-color: rgba(144, 164, 136, 0.5);
  }

  .feature:nth-child(3) {
    border-color: rgba(212, 165, 116, 0.5);
  }

  .feature:nth-child(4) {
    border-color: rgba(184, 92, 58, 0.5);
  }

  :global([data-theme="light"]) .feature:nth-child(1) {
    background: var(--box-sage);
    border-color: var(--neutral-black);
  }

  :global([data-theme="light"]) .feature:nth-child(2) {
    background: var(--box-moss);
    border-color: var(--neutral-black);
  }

  :global([data-theme="light"]) .feature:nth-child(3) {
    background: var(--box-tan);
    border-color: var(--neutral-black);
  }

  :global([data-theme="light"]) .feature:nth-child(4) {
    background: var(--box-rust);
    border-color: var(--neutral-black);
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .feature h3 {
    margin: 0 0 0.75rem 0;
    color: #f0e6d2;
    font-size: 1.2rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
    text-shadow:
      0 0 8px rgba(240, 230, 210, 0.5);
  }

  :global([data-theme="light"]) .feature h3 {
    color: var(--neutral-black);
    font-weight: 900;
    text-shadow: none;
  }

  .feature p {
    margin: 0;
    color: #b0b0b0;
    line-height: 1.6;
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    font-weight: 400;
    transition: color 0.3s ease;
  }

  :global([data-theme="light"]) .feature p {
    color: var(--neutral-black);
    font-weight: 600;
  }

  .coverage-section {
    background: #2a2a2a;
    transition: background 0.3s ease;
  }

  :global([data-theme="light"]) .coverage-section {
    background: var(--neutral-bg);
  }

  .coverage-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }

  /* Coverage cards inherit from retro-card, only add specific styling */
  .coverage-state {
    padding: 2rem;
  }

  .coverage-state.active {
    border-color: rgba(168, 197, 168, 0.6);
  }

  :global([data-theme="light"]) .coverage-state.active {
    border-color: var(--earth-forest);
    background: var(--box-moss);
  }

  .coverage-state h3 {
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
    text-align: left;
    font-family: 'VT323', monospace;
    font-weight: 400;
    color: #f0e6d2;
    transition: color 0.3s ease;
    text-shadow:
      0 0 8px rgba(240, 230, 210, 0.5);
  }

  :global([data-theme="light"]) .coverage-state h3 {
    color: var(--neutral-black);
    font-weight: 900;
    text-shadow: none;
  }

  .coverage-state p {
    margin: 0 0 1rem 0;
    color: #b0b0b0;
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    font-weight: 400;
    transition: color 0.3s ease;
  }

  :global([data-theme="light"]) .coverage-state p {
    color: var(--neutral-black);
    font-weight: 600;
  }

  .coverage-state ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .coverage-state li {
    padding: 0.5rem 0;
    color: #b0b0b0;
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    border-bottom: 1px solid rgba(212, 165, 116, 0.2);
    font-weight: 400;
    transition: all 0.3s ease;
  }

  :global([data-theme="light"]) .coverage-state li {
    color: var(--neutral-black);
    border-bottom: 2px solid rgba(0,0,0,0.1);
    font-weight: 600;
  }

  .coverage-state li:last-child {
    border-bottom: none;
  }

  .coverage-state.coming-soon {
    border-color: rgba(144, 164, 136, 0.4);
  }

  :global([data-theme="light"]) .coverage-state.coming-soon {
    background: var(--neutral-white);
    border-color: var(--neutral-gray);
  }

  .stay-tuned {
    font-style: italic;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .hero .container {
      padding: 2rem 1.5rem;
    }

    .hero h1 {
      font-size: 2rem;
      letter-spacing: 0.05em;
    }

    .tagline {
      font-size: 1.1rem;
    }

    .search-container {
      padding: 1.5rem;
      border-width: 3px;
      margin-bottom: 1.5rem;
    }

    .quick-stats {
      gap: 1rem;
      margin-top: 1.5rem;
    }

