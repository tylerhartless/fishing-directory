---
import Layout from '../layouts/Layout.astro';
import SearchWidget from '../components/SearchWidget.tsx';

const nominatimEmail = import.meta.env.PUBLIC_NOMINATIM_EMAIL || 'contact@wherecanifish.com';
---

<Layout
  title="Find Fishing Spots Near You - Public Fishing Directory"
  description="Stop searching 'fishing spots near me' - find your perfect fishing location here! Discover thousands of public boat ramps, piers, and bank fishing spots with GPS coordinates, amenities, and real catches."
>
  <section class="hero">
    <div class="container">
      <h1>Stop Searching "Fishing Spots Near Me"</h1>
      <p class="tagline">Find your perfect fishing location here!</p>

      <div class="search-container">
        <SearchWidget nominatimEmail={nominatimEmail} client:idle />
      </div>

      <div class="quick-stats">
        <div class="stat">
          <strong>4,200+</strong>
          <span>Fishing Spots</span>
        </div>
        <div class="stat">
          <strong>Texas</strong>
          <span>Available Now</span>
        </div>
        <div class="stat">
          <strong>100%</strong>
          <span>Free Access</span>
        </div>
      </div>
    </div>
  </section>

  <section class="container popular-locations">
    <h2>Popular Fishing Locations</h2>
    <p class="section-subtitle">Most enriched areas with complete amenity data</p>

    <div class="location-grid">
      <a href="/texas/harris" class="location-card">
        <div class="location-header">
          <h3>Harris County</h3>
          <span class="spot-count">450+ spots</span>
        </div>
        <p>Houston metro area with diverse fishing opportunities</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🚤 Boat Ramps</span>
          <span class="feature-badge">🅿️ Parking Info</span>
        </div>
      </a>

      <a href="/texas/travis" class="location-card">
        <div class="location-header">
          <h3>Travis County</h3>
          <span class="spot-count">280+ spots</span>
        </div>
        <p>Austin lakes and Colorado River access</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🎣 Pier Access</span>
          <span class="feature-badge">🏞️ Parks</span>
        </div>
      </a>

      <a href="/texas/tarrant" class="location-card">
        <div class="location-header">
          <h3>Tarrant County</h3>
          <span class="spot-count">220+ spots</span>
        </div>
        <p>Fort Worth area urban fishing destinations</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🌊 Lakes</span>
          <span class="feature-badge">🎯 Easy Access</span>
        </div>
      </a>

      <a href="/texas/bexar" class="location-card">
        <div class="location-header">
          <h3>Bexar County</h3>
          <span class="spot-count">180+ spots</span>
        </div>
        <p>San Antonio fishing lakes and rivers</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🏕️ Recreation</span>
          <span class="feature-badge">🌳 Nature</span>
        </div>
      </a>
    </div>

    <div class="browse-all">
      <a href="/texas" class="btn-secondary">Browse All Texas Locations →</a>
    </div>
  </section>

  <section class="features-section">
    <div class="container">
      <h2>Why Fishermen Love This Directory</h2>
      <div class="features-grid">
        <div class="feature">
          <div class="feature-icon">📍</div>
          <h3>Exact GPS Coordinates</h3>
          <p>Navigate directly to every fishing spot with precise location data</p>
        </div>
        <div class="feature">
          <div class="feature-icon">✅</div>
          <h3>Verified Information</h3>
          <p>Official data from state agencies and community-verified details</p>
        </div>
        <div class="feature">
          <div class="feature-icon">🚤</div>
          <h3>Amenities Listed</h3>
          <p>Know before you go: parking, restrooms, boat ramps, and facilities</p>
        </div>
        <div class="feature">
          <div class="feature-icon">🆓</div>
          <h3>100% Free Access</h3>
          <p>All listed spots are public access - no fees, no memberships</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container coverage-section">
    <h2>Current Coverage</h2>
    <div class="coverage-info">
      <div class="coverage-state active">
        <h3>🎣 Texas</h3>
        <p><strong>4,200+ spots</strong> across 254 counties</p>
        <ul>
          <li>2,188 boat ramps</li>
          <li>829 fishing piers & parks</li>
          <li>768 community fishing lakes</li>
          <li>62 state parks</li>
        </ul>
      </div>
      <div class="coverage-state coming-soon">
        <h3>🚧 Coming Soon</h3>
        <p>Florida, Louisiana, Georgia & more southern states</p>
        <p class="stay-tuned">Building comprehensive directories with the same attention to detail</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, #1e4d2b 0%, #2d6a3f 50%, #3a8751 100%);
    color: white;
    padding: 5rem 2rem 4rem;
    text-align: center;
  }

  .hero h1 {
    font-size: 3rem;
    margin: 0 0 0.75rem 0;
    font-weight: 700;
    line-height: 1.2;
  }

  .tagline {
    font-size: 1.5rem;
    margin: 0 0 3rem 0;
    opacity: 0.95;
    font-weight: 500;
  }

  .search-container {
    max-width: 700px;
    margin: 0 auto 3rem;
    background: white;
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    color: #333;
  }

  .quick-stats {
    display: flex;
    justify-content: center;
    gap: 4rem;
    margin-top: 3rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat strong {
    font-size: 2.5rem;
    display: block;
    font-weight: 700;
  }

  .stat span {
    opacity: 0.9;
    font-size: 1rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    text-align: center;
    color: #1e4d2b;
  }

  .section-subtitle {
    text-align: center;
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .popular-locations {
    background: #f9fafb;
  }

  .location-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .location-card {
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .location-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    border-color: #2d6a3f;
  }

  .location-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .location-header h3 {
    margin: 0;
    color: #1e4d2b;
    font-size: 1.3rem;
  }

  .spot-count {
    background: #e8f5e9;
    color: #2d6a3f;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .location-card > p {
    color: #666;
    margin: 0 0 1rem 0;
    line-height: 1.5;
  }

  .location-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature-badge {
    background: #f3f4f6;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    color: #555;
  }

  .browse-all {
    text-align: center;
    margin-top: 2rem;
  }

  .btn-secondary {
    display: inline-block;
    padding: 1rem 2rem;
    background: white;
    color: #2d6a3f;
    border: 2px solid #2d6a3f;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: #2d6a3f;
    color: white;
  }

  .features-section {
    background: white;
    padding: 4rem 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature {
    text-align: center;
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .feature h3 {
    margin: 0 0 0.75rem 0;
    color: #1e4d2b;
    font-size: 1.2rem;
  }

  .feature p {
    margin: 0;
    color: #666;
    line-height: 1.6;
  }

  .coverage-section {
    background: #f9fafb;
  }

  .coverage-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .coverage-state {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    border: 2px solid #e5e7eb;
  }

  .coverage-state.active {
    border-color: #2d6a3f;
    background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
  }

  .coverage-state h3 {
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
    text-align: left;
  }

  .coverage-state p {
    margin: 0 0 1rem 0;
    color: #666;
  }

  .coverage-state ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .coverage-state li {
    padding: 0.5rem 0;
    color: #555;
    border-bottom: 1px solid #f0f0f0;
  }

  .coverage-state li:last-child {
    border-bottom: none;
  }

  .coverage-state.coming-soon {
    opacity: 0.7;
  }

  .stay-tuned {
    font-style: italic;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }

    .tagline {
      font-size: 1.2rem;
    }

    .search-container {
      padding: 1.5rem;
    }

    .quick-stats {
      flex-direction: column;
      gap: 1.5rem;
    }

    .stat strong {
      font-size: 2rem;
    }

    .location-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
