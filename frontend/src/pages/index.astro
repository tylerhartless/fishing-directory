---
import Layout from '../layouts/Layout.astro';
import SearchWidget from '../components/SearchWidget.tsx';

const nominatimEmail = import.meta.env.PUBLIC_NOMINATIM_EMAIL || 'contact@wherecanifish.com';
---

<Layout
  title="Find Fishing Spots Near You - Public Fishing Directory"
  description="Stop searching 'fishing spots near me' - find your perfect fishing location here! Discover thousands of public boat ramps, piers, and bank fishing spots with GPS coordinates, amenities, and real catches."
>
  <section class="hero">
    <div class="rainbow-accent"></div>
    <div class="container">
      <div class="hero-header">
        <h1>Fishing Spot Finder</h1>
        <p class="tagline">Stop fishing for spots near you and catch one here! 🎣</p>
      </div>

      <div class="search-container">
        <SearchWidget nominatimEmail={nominatimEmail} client:idle />
      </div>

      <div class="quick-stats">
        <div class="stat stat-red">
          <strong>4,200+</strong>
          <span>Fishing Spots</span>
        </div>
        <div class="stat stat-green">
          <strong>Texas</strong>
          <span>Available Now</span>
        </div>
        <div class="stat stat-blue">
          <strong>100%</strong>
          <span>Free Access</span>
        </div>
      </div>
    </div>
  </section>

  <section class="container popular-locations">
    <h2>Popular Fishing Locations</h2>
    <p class="section-subtitle">Most enriched areas with complete amenity data</p>

    <div class="location-grid">
      <a href="/texas/harris" class="location-card">
        <div class="location-header">
          <h3>Harris County</h3>
          <span class="spot-count">450+ spots</span>
        </div>
        <p>Houston metro area with diverse fishing opportunities</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🚤 Boat Ramps</span>
          <span class="feature-badge">🅿️ Parking Info</span>
        </div>
      </a>

      <a href="/texas/travis" class="location-card">
        <div class="location-header">
          <h3>Travis County</h3>
          <span class="spot-count">280+ spots</span>
        </div>
        <p>Austin lakes and Colorado River access</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🎣 Pier Access</span>
          <span class="feature-badge">🏞️ Parks</span>
        </div>
      </a>

      <a href="/texas/tarrant" class="location-card">
        <div class="location-header">
          <h3>Tarrant County</h3>
          <span class="spot-count">220+ spots</span>
        </div>
        <p>Fort Worth area urban fishing destinations</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🌊 Lakes</span>
          <span class="feature-badge">🎯 Easy Access</span>
        </div>
      </a>

      <a href="/texas/bexar" class="location-card">
        <div class="location-header">
          <h3>Bexar County</h3>
          <span class="spot-count">180+ spots</span>
        </div>
        <p>San Antonio fishing lakes and rivers</p>
        <div class="location-features">
          <span class="feature-badge">📍 GPS Data</span>
          <span class="feature-badge">🏕️ Recreation</span>
          <span class="feature-badge">🌳 Nature</span>
        </div>
      </a>
    </div>

    <div class="browse-all">
      <a href="/texas" class="btn-secondary">Browse All Texas Locations →</a>
    </div>
  </section>

  <section class="features-section">
    <div class="container">
      <h2>Why Fishermen Love This Directory</h2>
      <div class="features-grid">
        <div class="feature">
          <div class="feature-icon">📍</div>
          <h3>Exact GPS Coordinates</h3>
          <p>Navigate directly to every fishing spot with precise location data</p>
        </div>
        <div class="feature">
          <div class="feature-icon">✅</div>
          <h3>Verified Information</h3>
          <p>Official data from state agencies and community-verified details</p>
        </div>
        <div class="feature">
          <div class="feature-icon">🚤</div>
          <h3>Amenities Listed</h3>
          <p>Know before you go: parking, restrooms, boat ramps, and facilities</p>
        </div>
        <div class="feature">
          <div class="feature-icon">🆓</div>
          <h3>100% Free Access</h3>
          <p>All listed spots are public access - no fees, no memberships</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container coverage-section">
    <h2>Current Coverage</h2>
    <div class="coverage-info">
      <div class="coverage-state active">
        <h3>🎣 Texas</h3>
        <p><strong>4,200+ spots</strong> across 254 counties</p>
        <ul>
          <li>2,188 boat ramps</li>
          <li>829 fishing piers & parks</li>
          <li>768 community fishing lakes</li>
          <li>62 state parks</li>
        </ul>
      </div>
      <div class="coverage-state coming-soon">
        <h3>🚧 Coming Soon</h3>
        <p>Florida, Louisiana, Georgia & more southern states</p>
        <p class="stay-tuned">Building comprehensive directories with the same attention to detail</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: var(--primary-bg);
    color: white;
    padding: 0;
    text-align: center;
    position: relative;
  }

  .rainbow-accent {
    height: 4px;
    background: repeating-linear-gradient(
      to right,
      var(--earth-rust) 0px,
      var(--earth-rust) 8px,
      transparent 8px,
      transparent 16px
    );
  }

  .hero .container {
    padding: 1.25rem 2rem 2.5rem;
  }

  .hero-header {
    margin-bottom: 2rem;
  }

  .hero h1 {
    font-size: 3.5rem;
    margin: 0 0 0.5rem 0;
    font-weight: 900;
    letter-spacing: 0.05em;
    line-height: 1.1;
    text-shadow: 4px 4px 0 rgba(0,0,0,0.3);
    color: var(--accent-cream);
  }

  .tagline {
    font-size: 1.4rem;
    margin: 0;
    color: var(--secondary-text);
    font-weight: 600;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .search-container {
    max-width: 700px;
    margin: 0 auto 2rem;
    background: white;
    border: 4px solid var(--earth-sand);
    border-radius: 0;
    padding: 2rem;
    box-shadow: 8px 8px 0 rgba(0,0,0,0.2);
    color: #333;
  }

  .quick-stats {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: white;
    border: 3px solid;
    padding: 1.5rem 2rem;
    min-width: 140px;
    box-shadow: 6px 6px 0 rgba(0,0,0,0.2);
  }

  .stat-red {
    border-color: var(--earth-rust);
  }

  .stat-green {
    border-color: var(--earth-forest);
  }

  .stat-blue {
    border-color: var(--earth-slate);
  }

  .stat strong {
    font-size: 2.5rem;
    display: block;
    font-weight: 900;
    color: var(--neutral-black);
  }

  .stat span {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neutral-gray);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    text-align: center;
    color: var(--neutral-black);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    display: inline-block;
    width: 100%;
  }

  h2::after {
    content: '';
    display: block;
    width: 150px;
    height: 6px;
    background: var(--rainbow-gradient);
    margin: 0.5rem auto 0;
  }

  .section-subtitle {
    text-align: center;
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 2rem;
    font-weight: 600;
  }

  .popular-locations {
    background: var(--neutral-bg);
  }

  .location-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .location-card {
    background: white;
    border: 4px solid;
    border-radius: 0;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.1s;
    box-shadow: 6px 6px 0 rgba(0,0,0,0.2);
  }

  .location-card:nth-child(1) {
    border-color: var(--box-sage);
  }

  .location-card:nth-child(2) {
    border-color: var(--box-rust);
  }

  .location-card:nth-child(3) {
    border-color: var(--box-moss);
  }

  .location-card:nth-child(4) {
    border-color: var(--box-tan);
  }

  .location-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 rgba(0,0,0,0.3);
  }

  .location-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .location-header h3 {
    margin: 0;
    color: var(--neutral-black);
    font-size: 1.4rem;
    font-weight: 900;
  }

  .spot-count {
    background: var(--neutral-black);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 0;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .location-card > p {
    color: #555;
    margin: 0 0 1rem 0;
    line-height: 1.5;
    font-weight: 500;
  }

  .location-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature-badge {
    background: var(--neutral-black);
    color: white;
    padding: 0.4rem 0.7rem;
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .browse-all {
    text-align: center;
    margin-top: 1.5rem;
  }

  .btn-secondary {
    display: inline-block;
    padding: 1rem 2rem;
    background: var(--box-clay);
    color: var(--primary-text);
    border: 3px solid var(--neutral-black);
    border-radius: 0;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.1s;
    box-shadow: 4px 4px 0 rgba(0,0,0,0.3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .btn-secondary:hover {
    background: var(--accent-sage);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.3);
  }

  .features-section {
    background: white;
    padding: 2.5rem 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .feature {
    text-align: center;
    background: white;
    border: 3px solid var(--neutral-black);
    padding: 2rem 1.5rem;
    box-shadow: 5px 5px 0 rgba(0,0,0,0.2);
  }

  .feature:nth-child(1) {
    background: var(--box-sage);
  }

  .feature:nth-child(2) {
    background: var(--box-moss);
  }

  .feature:nth-child(3) {
    background: var(--box-tan);
  }

  .feature:nth-child(4) {
    background: var(--box-rust);
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .feature h3 {
    margin: 0 0 0.75rem 0;
    color: var(--neutral-black);
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .feature p {
    margin: 0;
    color: var(--neutral-black);
    line-height: 1.6;
    font-weight: 600;
  }

  .coverage-section {
    background: var(--neutral-bg);
  }

  .coverage-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .coverage-state {
    background: white;
    padding: 2rem;
    border-radius: 0;
    border: 4px solid var(--neutral-black);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.2);
  }

  .coverage-state.active {
    border-color: var(--earth-forest);
    background: var(--box-moss);
  }

  .coverage-state h3 {
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
    text-align: left;
    font-weight: 900;
  }

  .coverage-state p {
    margin: 0 0 1rem 0;
    color: var(--neutral-black);
    font-weight: 600;
  }

  .coverage-state ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .coverage-state li {
    padding: 0.5rem 0;
    color: var(--neutral-black);
    border-bottom: 2px solid rgba(0,0,0,0.1);
    font-weight: 600;
  }

  .coverage-state li:last-child {
    border-bottom: none;
  }

  .coverage-state.coming-soon {
    background: var(--neutral-white);
    border-color: var(--neutral-gray);
  }

  .stay-tuned {
    font-style: italic;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .hero .container {
      padding: 2rem 1.5rem;
    }

    .hero h1 {
      font-size: 2rem;
      letter-spacing: 0.05em;
    }

    .tagline {
      font-size: 1.1rem;
    }

    .search-container {
      padding: 1.5rem;
      border-width: 3px;
      margin-bottom: 1.5rem;
    }

    .quick-stats {
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .stat {
      min-width: 120px;
      padding: 1rem 1.5rem;
    }

    .stat strong {
      font-size: 2rem;
    }

    .location-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .container {
      padding: 2rem 1.5rem;
    }

    h2 {
      font-size: 2rem;
    }
  }
</style>
