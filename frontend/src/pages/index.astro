---
import Layout from '../layouts/Layout.astro';
import SearchWidget from '../components/SearchWidget.tsx';
import DynamicSubtitle from '../components/DynamicSubtitle.tsx';
import ValuePropositionBadges from '../components/ValuePropositionBadges.tsx';
import StateParkNoLicenseCallout from '../components/StateParkNoLicenseCallout.tsx';
import WhatEachSpotIncludes from '../components/WhatEachSpotIncludes.tsx';
import CountyListing from '../components/CountyListing.tsx';

const nominatimEmail = import.meta.env.PUBLIC_NOMINATIM_EMAIL || 'contact@wherecanifish.com';
---

<Layout
  title="Find Fishing Spots Near You - Public Fishing Directory"
  description="Stop searching 'fishing spots near me' - find your perfect fishing location here! Discover thousands of public boat ramps, piers, and bank fishing spots with GPS coordinates, amenities, and real catches."
>
  <section class="retro-page-header">
    <div class="container">
      <h1>Fishing Spot Finder</h1>
      <DynamicSubtitle client:load />
    </div>
  </section>

  <section class="retro-container">
    <div class="search-section">
      <div class="search-container">
        <SearchWidget nominatimEmail={nominatimEmail} client:idle />
      </div>

      <!-- New Homepage Sections: Mobile-First Design -->
      <div class="homepage-content">
        <!-- Scroll Prompt - Interstitial Element -->
        <div class="scroll-prompt">
          <span class="scroll-arrow">↓</span>
          <span class="scroll-text">WHY USE THIS DIRECTORY?</span>
          <span class="scroll-arrow">↓</span>
        </div>

        <!-- Value Proposition Badges -->
        <ValuePropositionBadges client:load />

        <!-- State Parks No-License Callout (conditional, dynamic by state) -->
        <StateParkNoLicenseCallout client:load />

        <!-- What Each Spot Includes -->
        <WhatEachSpotIncludes client:load />

        <!-- County Listing (dynamic by IP-detected state) -->
        <CountyListing client:load />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Homepage-specific styles - all container styling uses retro-common.css classes */

  .search-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .search-container {
    max-width: 900px;
    margin: 0 auto 2rem;
    background: rgba(30, 30, 30, 0.8);
    border: 2px solid rgba(168, 197, 168, 0.5);
    border-radius: 0;
    padding: 1.5rem;
    box-shadow:
      0 0 20px rgba(168, 197, 168, 0.3),
      inset 0 0 30px rgba(0, 0, 0, 0.5);
    color: var(--theme-text);
    transition: all 0.3s ease;
  }

  :global([data-theme="light"]) .search-container {
    background: white;
    border: 3px solid var(--neutral-black);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2);
  }

  .homepage-content {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Value Proposition Badges */
  :global(.value-badge) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0;
    font-family: var(--font-terminal);
    color: var(--theme-text-secondary);
  }

  :global([data-theme="light"] .value-badge) {
    color: var(--boat-black);
  }

  /* Scroll Prompt - Interstitial element between sections */
  .scroll-prompt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem 0;
    margin: 0 0 -1rem 0;
    font-family: var(--font-terminal);
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--theme-text-sage);
    text-align: center;
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .scroll-arrow {
    font-size: 1.5rem;
    animation: bounce 2s ease-in-out infinite;
  }

  .scroll-text {
    text-transform: uppercase;
  }

  :global([data-theme="light"]) .scroll-prompt {
    color: var(--boat-charcoal);
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  @keyframes pulse-glow {
    0%, 100% {
      text-shadow: 0 0 8px rgba(168, 197, 168, 0.6);
    }
    50% {
      text-shadow: 0 0 15px rgba(168, 197, 168, 0.8);
    }
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  :global([data-theme="light"]) .scroll-prompt {
    animation: none;
  }

  :global([data-theme="light"]) .scroll-arrow {
    animation: none;
  }

  /* No-License Callout - Less bright in dark mode with rust/orange border */
  :global(.no-license-callout) {
    border-color: var(--accent-rust) !important;
    background: rgba(30, 30, 30, 0.6) !important;
    box-shadow:
      0 0 15px rgba(184, 92, 58, 0.3),
      inset 0 0 30px rgba(0, 0, 0, 0.5) !important;
  }

  :global([data-theme="light"] .no-license-callout) {
    border-color: var(--boat-orange) !important;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2) !important;
  }

  /* County Items - Button-like styling */
  :global(.county-item) {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    text-decoration: none;
    font-family: var(--font-terminal);
    font-size: 1.15rem;
    background: rgba(168, 197, 168, 0.08);
    border: 2px solid rgba(168, 197, 168, 0.3);
    border-radius: 0;
    color: var(--theme-text-sage);
    transition: all 0.2s;
    cursor: pointer;
  }

  :global(.county-item:hover) {
    background: rgba(168, 197, 168, 0.15);
    border-color: rgba(168, 197, 168, 0.5);
    transform: translateX(4px);
    text-shadow: 0 0 8px rgba(168, 197, 168, 0.6);
  }

  :global([data-theme="light"] .county-item) {
    background: white;
    border: 3px solid var(--neutral-black);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.15);
    color: var(--neutral-black);
    font-weight: 600;
  }

  :global([data-theme="light"] .county-item:hover) {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2);
    border-color: var(--boat-orange);
    text-shadow: none;
  }

  /* County dots separator */
  :global(.county-dots) {
    flex: 1;
    height: 1px;
    background-image: repeating-linear-gradient(to right, rgba(168, 197, 168, 0.4) 0, rgba(168, 197, 168, 0.4) 4px, transparent 4px, transparent 8px);
    margin: 0 1rem;
  }

  :global([data-theme="light"] .county-dots) {
    background-image: repeating-linear-gradient(to right, rgba(0, 0, 0, 0.2) 0, rgba(0, 0, 0, 0.2) 4px, transparent 4px, transparent 8px);
  }

  /* Browse Other States Button - Custom styling for dark mode */
  :global(.county-browse-btn) {
    font-family: var(--font-terminal);
    background: rgba(122, 132, 80, 0.2);
    color: var(--box-moss);
    border: 2px solid var(--box-moss);
    font-size: 1.15rem;
    font-weight: 400;
    padding: 1rem 2rem;
    box-shadow:
      0 0 10px rgba(122, 132, 80, 0.3),
      inset 0 0 20px rgba(100, 100, 100, 0.2);
    text-shadow: 0 0 6px rgba(122, 132, 80, 0.4);
    transition: all 0.2s;
  }

  :global(.county-browse-btn:hover) {
    background: rgba(122, 132, 80, 0.3);
    border-color: var(--accent-sage);
    box-shadow:
      0 0 15px rgba(168, 197, 168, 0.5),
      inset 0 0 20px rgba(100, 100, 100, 0.2);
  }

  :global([data-theme="light"] .county-browse-btn) {
    background: linear-gradient(180deg, var(--box-moss) 0%, #6a7440 100%);
    color: white;
    border: 4px solid var(--boat-black);
    font-weight: 900;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.3);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  :global([data-theme="light"] .county-browse-btn:hover) {
    background: linear-gradient(180deg, #6a7440 0%, #5a6430 100%);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.4);
    border-color: var(--boat-black);
  }

  @media (max-width: 768px) {
    .search-container {
      padding: 0.75rem;
      border-width: 3px;
      margin-bottom: 1.5rem;
    }

    .homepage-content {
      gap: 2rem;
    }

    .scroll-prompt {
      font-size: 1.1rem;
      gap: 0.75rem;
    }
  }
</style>
