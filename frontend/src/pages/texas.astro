---
import Layout from '../layouts/Layout.astro';
import { getSpots } from '../lib/database';

// Get all Texas spots
const allSpots = await getSpots();
const texasSpots = allSpots.filter(spot => spot.state === 'TX' || spot.state === 'Texas');

// Group spots by county and count them
const countyData = texasSpots.reduce((acc, spot) => {
  let countyName = spot.county || 'Unknown';

  // Handle multi-county entries - use first county
  if (countyName.includes(',')) {
    countyName = countyName.split(',')[0].trim();
  }

  // Remove "County" suffix if present
  countyName = countyName.replace(/\s+County$/i, '').trim();

  // Skip "Multiple Counties" from county list
  if (countyName === 'Multiple Counties') {
    return acc;
  }

  if (!acc[countyName]) {
    acc[countyName] = 0;
  }
  acc[countyName]++;

  return acc;
}, {} as Record<string, number>);

// Convert to array and sort alphabetically
const counties = Object.entries(countyData)
  .map(([name, count]) => ({
    name,
    count,
    slug: name.toLowerCase().replace(/\s+/g, '-')
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout
  title="Texas Fishing Spots by County - Public Access Directory"
  description="Browse fishing spots in Texas by county. Find boat ramps, piers, and bank fishing spots across all 254 Texas counties."
>
  <section class="retro-page-header">
    <div class="container">
      <h1>Texas Fishing Spots by County</h1>
      <p class="subtitle">
        {texasSpots.length} fishing spots across {counties.length} counties
      </p>
      <p class="description">
        Select a county to view all fishing locations in that area
      </p>
    </div>
  </section>

  <section class="retro-container">
    <div class="retro-grid retro-grid-auto">
      {counties.map((county) => (
        <a href={`/texas/${county.slug}`} class="retro-card">
          <div class="county-header">
            <h3>{county.name} County</h3>
            <span class="spot-count">{county.count} {county.count === 1 ? 'spot' : 'spots'}</span>
          </div>
          <p class="county-link">View all fishing spots →</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* Page-specific styles only - common styles in retro-common.css */

  .county-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .county-header h3 {
    margin: 0;
    font-size: 1.3rem;
    color: var(--neutral-black);
    font-weight: 900;
    flex: 1;
  }

  .spot-count {
    background: var(--neutral-black);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 0;
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .county-link {
    color: var(--neutral-black);
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
  }
</style>
