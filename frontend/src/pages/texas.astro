---
import Layout from '../layouts/Layout.astro';
import { getSpots } from '../lib/database';

// Get all Texas spots
const allSpots = await getSpots();
const texasSpots = allSpots.filter(spot => spot.state === 'TX' || spot.state === 'Texas');

// Group spots by county and count them
const countyData = texasSpots.reduce((acc, spot) => {
  let countyName = spot.county || 'Unknown';

  // Handle multi-county entries - use first county
  if (countyName.includes(',')) {
    countyName = countyName.split(',')[0].trim();
  }

  // Remove "County" suffix if present
  countyName = countyName.replace(/\s+County$/i, '').trim();

  // Skip "Multiple Counties" from county list
  if (countyName === 'Multiple Counties') {
    return acc;
  }

  if (!acc[countyName]) {
    acc[countyName] = 0;
  }
  acc[countyName]++;

  return acc;
}, {} as Record<string, number>);

// Convert to array and sort alphabetically
const counties = Object.entries(countyData)
  .map(([name, count]) => ({
    name,
    count,
    slug: name.toLowerCase().replace(/\s+/g, '-')
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout
  title="Texas Fishing Spots by County - Public Access Directory"
  description="Browse fishing spots in Texas by county. Find boat ramps, piers, and bank fishing spots across all 254 Texas counties."
>
  <section class="page-header">
    <div class="container">
      <h1>Texas Fishing Spots by County</h1>
      <p class="subtitle">
        {texasSpots.length} fishing spots across {counties.length} counties
      </p>
      <p class="description">
        Select a county to view all fishing locations in that area
      </p>
    </div>
  </section>

  <section class="container">
    <div class="counties-grid">
      {counties.map((county) => (
        <a href={`/texas/${county.slug}`} class="county-card">
          <div class="county-header">
            <h3>{county.name} County</h3>
            <span class="spot-count">{county.count} {county.count === 1 ? 'spot' : 'spots'}</span>
          </div>
          <p class="county-link">View all fishing spots →</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--primary-bg);
    color: white;
    padding: 0;
    text-align: center;
    position: relative;
  }

  .page-header::before {
    content: '';
    display: block;
    height: 12px;
    background: var(--rainbow-gradient);
  }

  .page-header .container {
    padding: 2.5rem 2rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin: 0 0 0.75rem 0;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-shadow: 4px 4px 0 rgba(0,0,0,0.3);
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--secondary-text);
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }

  .description {
    font-size: 1rem;
    color: var(--secondary-text);
    margin: 0;
    font-weight: 500;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }

  .counties-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .county-card {
    background: white;
    border: 4px solid;
    border-radius: 0;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.1s;
    display: flex;
    flex-direction: column;
    box-shadow: 6px 6px 0 rgba(0,0,0,0.2);
  }

  .county-card:nth-child(4n+1) {
    border-color: var(--box-aqua);
  }

  .county-card:nth-child(4n+2) {
    border-color: var(--box-pink);
  }

  .county-card:nth-child(4n+3) {
    border-color: var(--box-mint);
  }

  .county-card:nth-child(4n+4) {
    border-color: var(--box-peach);
  }

  .county-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 rgba(0,0,0,0.3);
  }

  .county-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .county-header h3 {
    margin: 0;
    font-size: 1.3rem;
    color: var(--neutral-black);
    font-weight: 900;
    flex: 1;
  }

  .spot-count {
    background: var(--neutral-black);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 0;
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .county-link {
    color: var(--neutral-black);
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .page-header .container {
      padding: 2rem 1.5rem;
    }

    .counties-grid {
      grid-template-columns: 1fr;
    }

    .county-card {
      border-width: 3px;
    }
  }
</style>
