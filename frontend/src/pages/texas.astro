---
import Layout from '../layouts/Layout.astro';
import SpecialLandingPageCallout from '../components/SpecialLandingPageCallout.tsx';
import { getSpots } from '../lib/database';

// Get all Texas spots
const allSpots = await getSpots();
const texasSpots = allSpots.filter(spot => spot.state === 'TX' || spot.state === 'Texas');

// Group spots by county and count them
const countyData = texasSpots.reduce((acc, spot) => {
  let countyName = spot.county || 'Unknown';

  // Handle multi-county entries - use first county
  if (countyName.includes(',')) {
    countyName = countyName.split(',')[0].trim();
  }

  // Remove "County" suffix if present
  countyName = countyName.replace(/\s+County$/i, '').trim();

  // Skip "Multiple Counties" from county list
  if (countyName === 'Multiple Counties') {
    return acc;
  }

  if (!acc[countyName]) {
    acc[countyName] = {
      count: 0,
      // Calculate average lat/lon for distance sorting
      totalLat: 0,
      totalLon: 0,
      spots: []
    };
  }

  acc[countyName].count++;
  acc[countyName].totalLat += parseFloat(spot.latitude);
  acc[countyName].totalLon += parseFloat(spot.longitude);
  acc[countyName].spots.push(spot);

  return acc;
}, {} as Record<string, { count: number; totalLat: number; totalLon: number; spots: any[] }>);

// Convert to array with average coordinates
const counties = Object.entries(countyData)
  .map(([name, data]) => ({
    name,
    count: data.count,
    slug: name.toLowerCase().replace(/\s+/g, '-'),
    lat: data.totalLat / data.count,
    lon: data.totalLon / data.count
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

// Serialize for client-side JS
const countiesJson = JSON.stringify(counties);
---

<Layout
  title="Texas Fishing Spots by County - Public Access Directory"
  description="Browse fishing spots in Texas by county. Find boat ramps, piers, and bank fishing spots across all 254 Texas counties."
>
  <section class="retro-page-header">
    <div class="container">
      <nav class="retro-breadcrumb">
        <a href="/">← Home</a> / Texas
      </nav>
      <h1>Texas Fishing Spots</h1>
      <p class="subtitle">
        {texasSpots.length} fishing spots across {counties.length} counties
      </p>
    </div>
  </section>

  <section class="retro-container">
    <!-- Counties List Section -->
    <div class="counties-list-section">
      <div class="search-widget-style">
        <!-- Header -->
        <div class="results-header">
          <div class="results-info">
            <span class="query-prompt">›</span>
            <span class="query-text">Browse by County (<span id="county-count">{counties.length}</span> counties)</span>
          </div>
        </div>

        <!-- Controls -->
        <div class="controls-bar">
          <button id="sort-btn" class="control-button">
            <span class="control-label">Sort:</span>
            <span id="sort-display">Alphabetical</span>
          </button>
        </div>

        <!-- Counties Grid -->
        <div class="results-container" id="counties-scroll-container">
          <div id="counties-container" class="results-grid">
            {counties.map((county) => (
              <a href={`/texas/${county.slug}`} class="spot-card county-card" data-county-name={county.name} data-lat={county.lat} data-lon={county.lon}>
                <div class="card-header">
                  <h3>{county.name} County</h3>
                </div>
                <div class="card-body">
                  <span class="card-meta-item">{county.count} {county.count === 1 ? 'spot' : 'spots'}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Special Landing Pages Section -->
    <div class="special-pages-section">
      <SpecialLandingPageCallout forceState="TX" client:load />
    </div>
  </section>
</Layout>

<style>
  /* Special pages section - same width as counties list */
  .special-pages-section {
    max-width: 900px;
    margin: 2rem auto 0;
  }

  /* Counties list section - reuse search widget styles */
  .counties-list-section {
    max-width: 900px;
    margin: 0 auto;
  }

  .search-widget-style {
    background: var(--rgba-dark-bg-80);
    border: 2px solid var(--rgba-sage-50);
    border-radius: 0;
    padding: 1.5rem;
    box-shadow:
      0 0 20px var(--rgba-sage-30),
      inset 0 0 30px var(--rgba-black-50);
    position: relative;
    overflow: hidden;
  }

  /* Scanlines */
  .search-widget-style::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      var(--rgba-black-15) 0px,
      transparent 1px,
      transparent 2px,
      var(--rgba-black-15) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .search-widget-style > * {
    position: relative;
    z-index: 2;
  }

  :global([data-theme="light"]) .search-widget-style {
    background: white;
    border: 3px solid var(--neutral-black);
    box-shadow: 6px 6px 0 var(--rgba-black-20);
  }

  :global([data-theme="light"]) .search-widget-style::before {
    background: repeating-linear-gradient(
      0deg,
      var(--rgba-black-01) 0px,
      transparent 1px,
      transparent 2px,
      var(--rgba-black-01) 3px
    );
  }

  /* Results header */
  .results-header {
    margin-bottom: 1rem;
  }

  .results-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'VT323', monospace;
    font-size: 1.3rem;
    color: var(--theme-text-sage);
    font-weight: 400;
  }

  :global([data-theme="light"]) .results-info {
    color: var(--neutral-black);
    font-weight: 700;
  }

  .query-prompt {
    color: var(--theme-text-sage);
    font-weight: 700;
    text-shadow: 0 0 8px var(--rgba-sage-60);
  }

  :global([data-theme="light"]) .query-prompt {
    color: var(--boat-orange);
    text-shadow: none;
  }

  /* Controls bar */
  .controls-bar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .control-button {
    background: var(--rgba-sage-15);
    border: 2px solid var(--rgba-sage-50);
    color: var(--theme-text-sage);
    padding: 0.75rem 1.25rem;
    font-family: 'VT323', monospace;
    font-size: 1.1rem;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 0 10px var(--rgba-sage-30);
  }

  :global([data-theme="light"]) .control-button {
    background: white;
    border: 3px solid var(--neutral-black);
    color: var(--neutral-black);
    font-weight: 700;
    box-shadow: 3px 3px 0 var(--rgba-black-20);
  }

  .control-button:hover {
    background: var(--rgba-sage-25);
    border-color: var(--rgba-sage-80);
    box-shadow: 0 0 15px var(--rgba-sage-50);
  }

  :global([data-theme="light"]) .control-button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--rgba-black-30);
    border-color: var(--boat-orange);
  }

  .control-label {
    opacity: 0.7;
  }

  #sort-display {
    font-weight: 700;
    color: var(--theme-text-sage);
    text-shadow: 0 0 8px var(--rgba-sage-60);
  }

  :global([data-theme="light"]) #sort-display {
    color: var(--boat-orange);
    text-shadow: none;
  }

  /* County cards inherit from spot-card in search-widget.css */
  /* Override spot type coloring for counties - use neutral sage border */
  :global(.county-card) {
    border-color: var(--rgba-sage-30);
    box-shadow: 0 0 12px var(--rgba-sage-20);
  }

  :global([data-theme="light"] .county-card) {
    border-color: var(--neutral-black);
    box-shadow: 4px 4px 0 var(--rgba-black-20);
  }

  @media (max-width: 768px) {
    .search-widget-style {
      padding: 1rem;
    }

    .county-header {
      flex-direction: column;
      gap: 0.5rem;
    }

    .spot-count {
      align-self: flex-start;
    }
  }
</style>

<script define:vars={{ countiesJson }}>
  const counties = JSON.parse(countiesJson);
  let currentSort = 'alphabetical';
  let userLocation = null;

  const sortBtn = document.getElementById('sort-btn');
  const sortDisplay = document.getElementById('sort-display');
  const countiesContainer = document.getElementById('counties-container');
  const countyCount = document.getElementById('county-count');
  const scrollContainer = document.getElementById('counties-scroll-container');

  // Handle scroll fade effects
  function handleScrollFade() {
    if (!scrollContainer) return;

    const scrollTop = scrollContainer.scrollTop;
    const scrollHeight = scrollContainer.scrollHeight;
    const clientHeight = scrollContainer.clientHeight;
    const scrollBottom = scrollHeight - scrollTop - clientHeight;

    // Add/remove classes based on scroll position
    if (scrollTop > 10) {
      scrollContainer.classList.add('scrolled-from-top');
    } else {
      scrollContainer.classList.remove('scrolled-from-top');
    }

    if (scrollBottom > 10) {
      scrollContainer.classList.add('scrolled-from-bottom');
    } else {
      scrollContainer.classList.remove('scrolled-from-bottom');
    }
  }

  // Attach scroll listener
  if (scrollContainer) {
    scrollContainer.addEventListener('scroll', handleScrollFade);
    // Initial check
    handleScrollFade();
  }

  function calculateDistance(lat1, lon1, lat2, lon2) {
    const R = 3959; // Earth's radius in miles
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }

  function sortCounties(sortBy) {
    let sorted = [...counties];

    if (sortBy === 'distance' && userLocation) {
      sorted = sorted.map(county => ({
        ...county,
        distance: calculateDistance(
          userLocation.lat,
          userLocation.lon,
          county.lat,
          county.lon
        )
      })).sort((a, b) => a.distance - b.distance);
    } else {
      sorted.sort((a, b) => a.name.localeCompare(b.name));
    }

    renderCounties(sorted);
  }

  function renderCounties(countiesToRender) {
    countiesContainer.innerHTML = countiesToRender.map(county => {
      const distanceHtml = county.distance
        ? `<div class="distance-indicator">${Math.round(county.distance)} mi</div>`
        : '';

      return `
        <a href="/texas/${county.slug}" class="spot-card county-card" data-county-name="${county.name}">
          <div class="card-header">
            <h3>${county.name} County</h3>
            ${distanceHtml}
          </div>
          <div class="card-body">
            <span class="card-meta-item">${county.count} ${county.count === 1 ? 'spot' : 'spots'}</span>
          </div>
        </a>
      `;
    }).join('');

    // Re-check fade after rendering
    setTimeout(handleScrollFade, 100);
  }

  sortBtn.addEventListener('click', () => {
    if (currentSort === 'alphabetical') {
      // Switch to distance sorting - prompt for location
      if (navigator.geolocation) {
        sortDisplay.textContent = 'Getting location...';
        sortBtn.disabled = true;

        navigator.geolocation.getCurrentPosition(
          (position) => {
            userLocation = {
              lat: position.coords.latitude,
              lon: position.coords.longitude
            };
            currentSort = 'distance';
            sortDisplay.textContent = 'Distance';
            sortBtn.disabled = false;
            sortCounties('distance');
          },
          (error) => {
            sortDisplay.textContent = 'Alphabetical';
            sortBtn.disabled = false;
            alert('Unable to get your location. Please enable location services to sort by distance.');
          }
        );
      } else {
        alert('Geolocation is not supported by your browser.');
      }
    } else {
      // Switch back to alphabetical
      currentSort = 'alphabetical';
      sortDisplay.textContent = 'Alphabetical';
      sortCounties('alphabetical');
    }
  });
</script>
</Layout>
