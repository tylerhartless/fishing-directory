---
import Layout from '../layouts/Layout.astro';
import { getSpots } from '../lib/database';

// State lookup mappings
const stateNameLookup: Record<string, string> = {
  'AL': 'Alabama', 'AK': 'Alaska', 'AZ': 'Arizona', 'AR': 'Arkansas', 'CA': 'California',
  'CO': 'Colorado', 'CT': 'Connecticut', 'DE': 'Delaware', 'FL': 'Florida', 'GA': 'Georgia',
  'HI': 'Hawaii', 'ID': 'Idaho', 'IL': 'Illinois', 'IN': 'Indiana', 'IA': 'Iowa',
  'KS': 'Kansas', 'KY': 'Kentucky', 'LA': 'Louisiana', 'ME': 'Maine', 'MD': 'Maryland',
  'MA': 'Massachusetts', 'MI': 'Michigan', 'MN': 'Minnesota', 'MS': 'Mississippi', 'MO': 'Missouri',
  'MT': 'Montana', 'NE': 'Nebraska', 'NV': 'Nevada', 'NH': 'New Hampshire', 'NJ': 'New Jersey',
  'NM': 'New Mexico', 'NY': 'New York', 'NC': 'North Carolina', 'ND': 'North Dakota', 'OH': 'Ohio',
  'OK': 'Oklahoma', 'OR': 'Oregon', 'PA': 'Pennsylvania', 'RI': 'Rhode Island', 'SC': 'South Carolina',
  'SD': 'South Dakota', 'TN': 'Tennessee', 'TX': 'Texas', 'UT': 'Utah', 'VT': 'Vermont',
  'VA': 'Virginia', 'WA': 'Washington', 'WV': 'West Virginia', 'WI': 'Wisconsin', 'WY': 'Wyoming'
};

const stateSlugLookup: Record<string, string> = {
  'AL': 'alabama', 'AK': 'alaska', 'AZ': 'arizona', 'AR': 'arkansas', 'CA': 'california',
  'CO': 'colorado', 'CT': 'connecticut', 'DE': 'delaware', 'FL': 'florida', 'GA': 'georgia',
  'HI': 'hawaii', 'ID': 'idaho', 'IL': 'illinois', 'IN': 'indiana', 'IA': 'iowa',
  'KS': 'kansas', 'KY': 'kentucky', 'LA': 'louisiana', 'ME': 'maine', 'MD': 'maryland',
  'MA': 'massachusetts', 'MI': 'michigan', 'MN': 'minnesota', 'MS': 'mississippi', 'MO': 'missouri',
  'MT': 'montana', 'NE': 'nebraska', 'NV': 'nevada', 'NH': 'new-hampshire', 'NJ': 'new-jersey',
  'NM': 'new-mexico', 'NY': 'new-york', 'NC': 'north-carolina', 'ND': 'north-dakota', 'OH': 'ohio',
  'OK': 'oklahoma', 'OR': 'oregon', 'PA': 'pennsylvania', 'RI': 'rhode-island', 'SC': 'south-carolina',
  'SD': 'south-dakota', 'TN': 'tennessee', 'TX': 'texas', 'UT': 'utah', 'VT': 'vermont',
  'VA': 'virginia', 'WA': 'washington', 'WV': 'west-virginia', 'WI': 'wisconsin', 'WY': 'wyoming'
};

// Get all spots and group by state
const allSpots = await getSpots();

// Group spots by state
const stateData = allSpots.reduce((acc, spot) => {
  const stateCode = spot.state;

  if (!stateCode) {
    return acc;
  }

  if (!acc[stateCode]) {
    acc[stateCode] = {
      code: stateCode,
      name: stateNameLookup[stateCode] || stateCode,
      slug: stateSlugLookup[stateCode] || stateCode.toLowerCase(),
      spotCount: 0,
      counties: new Set<string>(),
      totalLat: 0,
      totalLon: 0
    };
  }

  acc[stateCode].spotCount++;
  acc[stateCode].totalLat += parseFloat(spot.latitude);
  acc[stateCode].totalLon += parseFloat(spot.longitude);

  // Track unique counties
  let countyName = spot.county || '';
  if (countyName.includes(',')) {
    countyName = countyName.split(',')[0].trim();
  }
  countyName = countyName.replace(/\s+County$/i, '').trim();
  if (countyName && countyName !== 'Multiple Counties') {
    acc[stateCode].counties.add(countyName);
  }

  return acc;
}, {} as Record<string, {
  code: string;
  name: string;
  slug: string;
  spotCount: number;
  counties: Set<string>;
  totalLat: number;
  totalLon: number;
}>);

// Convert to array with average coordinates
const states = Object.values(stateData)
  .map(state => ({
    code: state.code,
    name: state.name,
    slug: state.slug,
    spotCount: state.spotCount,
    countyCount: state.counties.size,
    lat: state.totalLat / state.spotCount,
    lon: state.totalLon / state.spotCount
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

// Serialize for client-side JS
const statesJson = JSON.stringify(states);
const totalSpots = allSpots.length;
---

<Layout
  title="Browse Fishing Spots by State - Public Access Directory"
  description="Explore fishing spots across all U.S. states. Find boat ramps, piers, and bank fishing spots by state."
>
  <section class="retro-page-header">
    <div class="container">
      <nav class="retro-breadcrumb">
        <a href="/">← Home</a> / States
      </nav>
      <h1>Browse by State</h1>
      <p class="subtitle">
        {totalSpots.toLocaleString()} fishing spots across {states.length} {states.length === 1 ? 'state' : 'states'}
      </p>
    </div>
  </section>

  <section class="retro-container">
    <div class="states-list-section">
      <div class="search-widget-style">

        <!-- Controls -->
        <div class="controls-bar">
          <a href="/" class="control-button back-button">
            <span class="back-arrow">←</span>
            <span class="back-text">Home</span>
          </a>
          <button id="sort-btn" class="control-button">
            <span class="control-label">Sort:</span>
            <span id="sort-display">Alphabetical</span>
          </button>
        </div>

        <!-- States Grid -->
        <div class="results-container" id="states-scroll-container">
          <div id="states-container" class="results-grid">
            {states.map((state) => (
              <a href={`/${state.slug}`} class="spot-card state-card" data-state-name={state.name} data-lat={state.lat} data-lon={state.lon}>
                <div class="card-header">
                  <h3>{state.name}</h3>
                </div>
                <div class="card-body">
                  <span class="card-meta-item">{state.countyCount} {state.countyCount === 1 ? 'county' : 'counties'}</span>
                  <span class="card-meta-item">{state.spotCount} {state.spotCount === 1 ? 'spot' : 'spots'}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* States list section - reuse search widget styles */
  .states-list-section {
    max-width: 900px;
    margin: 0 auto;
  }

  .search-widget-style {
    background: var(--rgba-dark-bg-80);
    border: 2px solid var(--rgba-sage-50);
    border-radius: 0;
    padding: 1.5rem;
    box-shadow:
      0 0 20px var(--rgba-sage-30),
      inset 0 0 30px var(--rgba-black-50);
    position: relative;
    overflow: hidden;
  }

  /* Scanlines */
  .search-widget-style::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      var(--rgba-black-15) 0px,
      transparent 1px,
      transparent 2px,
      var(--rgba-black-15) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .search-widget-style > * {
    position: relative;
    z-index: 2;
  }

  :global([data-theme="light"]) .search-widget-style {
    background: white;
    border: 3px solid var(--neutral-black);
    box-shadow: 6px 6px 0 var(--rgba-black-20);
  }

  :global([data-theme="light"]) .search-widget-style::before {
    background: repeating-linear-gradient(
      0deg,
      var(--rgba-black-01) 0px,
      transparent 1px,
      transparent 2px,
      var(--rgba-black-01) 3px
    );
  }

  /* Controls bar */
  .controls-bar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .control-button {
    background: var(--rgba-sage-15);
    border: 2px solid var(--rgba-sage-50);
    color: var(--theme-text-sage);
    padding: 0.75rem 1.25rem;
    font-family: 'VT323', monospace;
    font-size: 1.1rem;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 0 10px var(--rgba-sage-30);
    text-decoration: none;
  }

  .back-button {
    white-space: nowrap;
  }

  .back-arrow {
    font-size: 1.2rem;
  }

  :global([data-theme="light"]) .control-button {
    background: white;
    border: 3px solid var(--neutral-black);
    color: var(--neutral-black);
    font-weight: 700;
    box-shadow: 3px 3px 0 var(--rgba-black-20);
  }

  .control-button:hover {
    background: var(--rgba-sage-25);
    border-color: var(--rgba-sage-80);
    box-shadow: 0 0 15px var(--rgba-sage-50);
  }

  :global([data-theme="light"]) .control-button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--rgba-black-30);
    border-color: var(--boat-orange);
  }

  .control-label {
    opacity: 0.7;
  }

  #sort-display {
    font-weight: 700;
    color: var(--theme-text-sage);
    text-shadow: 0 0 8px var(--rgba-sage-60);
  }

  :global([data-theme="light"]) #sort-display {
    color: var(--boat-orange);
    text-shadow: none;
  }

  /* State cards inherit from spot-card in search-widget.css */
  :global(.state-card) {
    border-color: var(--rgba-sage-30);
    box-shadow: 0 0 12px var(--rgba-sage-20);
  }

  :global([data-theme="light"] .state-card) {
    border-color: var(--neutral-black);
    box-shadow: 4px 4px 0 var(--rgba-black-20);
  }

  @media (max-width: 768px) {
    .search-widget-style {
      padding: 1rem;
    }

    .back-text {
      display: none;
    }

    .back-button {
      padding: 0.75rem;
    }
  }
</style>

<script define:vars={{ statesJson }}>
  const states = JSON.parse(statesJson);
  let currentSort = 'alphabetical';
  let userLocation = null;

  const sortBtn = document.getElementById('sort-btn');
  const sortDisplay = document.getElementById('sort-display');
  const statesContainer = document.getElementById('states-container');
  const scrollContainer = document.getElementById('states-scroll-container');

  // Handle scroll fade effects
  function handleScrollFade() {
    if (!scrollContainer) return;

    const scrollTop = scrollContainer.scrollTop;
    const scrollHeight = scrollContainer.scrollHeight;
    const clientHeight = scrollContainer.clientHeight;
    const scrollBottom = scrollHeight - scrollTop - clientHeight;

    // Add/remove classes based on scroll position
    if (scrollTop > 10) {
      scrollContainer.classList.add('scrolled-from-top');
    } else {
      scrollContainer.classList.remove('scrolled-from-top');
    }

    if (scrollBottom > 10) {
      scrollContainer.classList.add('scrolled-from-bottom');
    } else {
      scrollContainer.classList.remove('scrolled-from-bottom');
    }
  }

  // Attach scroll listener
  if (scrollContainer) {
    scrollContainer.addEventListener('scroll', handleScrollFade);
    // Initial check
    handleScrollFade();
  }

  function calculateDistance(lat1, lon1, lat2, lon2) {
    const R = 3959; // Earth's radius in miles
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }

  function sortStates(sortBy) {
    let sorted = [...states];

    if (sortBy === 'distance' && userLocation) {
      sorted = sorted.map(state => ({
        ...state,
        distance: calculateDistance(
          userLocation.lat,
          userLocation.lon,
          state.lat,
          state.lon
        )
      })).sort((a, b) => a.distance - b.distance);
    } else {
      sorted.sort((a, b) => a.name.localeCompare(b.name));
    }

    renderStates(sorted);
  }

  function renderStates(statesToRender) {
    statesContainer.innerHTML = statesToRender.map(state => {
      const distanceHtml = state.distance
        ? `<div class="distance-indicator">${Math.round(state.distance)} mi</div>`
        : '';

      return `
        <a href="/${state.slug}" class="spot-card state-card" data-state-name="${state.name}">
          <div class="card-header">
            <h3>${state.name}</h3>
            ${distanceHtml}
          </div>
          <div class="card-body">
            <span class="card-meta-item">${state.countyCount} ${state.countyCount === 1 ? 'county' : 'counties'}</span>
            <span class="card-meta-item">${state.spotCount} ${state.spotCount === 1 ? 'spot' : 'spots'}</span>
          </div>
        </a>
      `;
    }).join('');

    // Re-check fade after rendering
    setTimeout(handleScrollFade, 100);
  }

  sortBtn.addEventListener('click', () => {
    if (currentSort === 'alphabetical') {
      // Switch to distance sorting - prompt for location
      if (navigator.geolocation) {
        sortDisplay.textContent = 'Getting location...';
        sortBtn.disabled = true;

        navigator.geolocation.getCurrentPosition(
          (position) => {
            userLocation = {
              lat: position.coords.latitude,
              lon: position.coords.longitude
            };
            currentSort = 'distance';
            sortDisplay.textContent = 'Distance';
            sortBtn.disabled = false;
            sortStates('distance');
          },
          (error) => {
            sortDisplay.textContent = 'Alphabetical';
            sortBtn.disabled = false;
            alert('Unable to get your location. Please enable location services to sort by distance.');
          }
        );
      } else {
        alert('Geolocation is not supported by your browser.');
      }
    } else {
      // Switch back to alphabetical
      currentSort = 'alphabetical';
      sortDisplay.textContent = 'Alphabetical';
      sortStates('alphabetical');
    }
  });
</script>
</Layout>
