  }

  :global([data-theme="light"]) .copy-coords {
    background: var(--neutral-black);
    color: white;
    border: none;
    box-shadow: none;
    text-shadow: none;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .copy-coords:hover {
    background: rgba(212, 165, 116, 0.3);
    border-color: rgba(212, 165, 116, 0.7);
    color: var(--earth-sand);
    text-shadow: 0 0 8px rgba(212, 165, 116, 0.5);
