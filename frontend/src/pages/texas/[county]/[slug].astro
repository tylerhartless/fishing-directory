---
import Layout from '../../../layouts/Layout.astro';
import { getSpots, generateMapUrl, type FishingSpot } from '../../../lib/database';


export async function getStaticPaths() {
  const spots = await getSpots(); 
  
  // Filter out any spots where the required data (county or slug) might be missing or invalid
  const validSpots = spots.filter(spot => spot && spot.county && spot.slug);

  const paths = validSpots.map((spot) => {

    // 1. Explicitly coerce and clean the county name
    let countyName = String(spot.county || '');

    // Handle multi-county entries (e.g., "Harris, Fort Bend") - use only first county
    if (countyName.includes(',')) {
      countyName = countyName.split(',')[0].trim();
    }

    // Remove "County" suffix if present (e.g., "Fort Bend County" -> "Fort Bend")
    countyName = countyName.replace(/\s+County$/i, '').trim();

    // Create slug: lowercase and replace spaces with hyphens
    const countySlug = countyName.toLowerCase().replace(/\s+/g, '-');

    // 2. Explicitly coerce the slug
    const spotSlug = String(spot.slug || '');

    // 3. Parse amenities if it's a JSON string
    let parsedAmenities = spot.amenities;
    if (typeof spot.amenities === 'string') {
      try {
        parsedAmenities = JSON.parse(spot.amenities);
      } catch (e) {
        console.error(`Failed to parse amenities for spot ${spot.slug}:`, e);
        parsedAmenities = null;
      }
    }

    // 4. Return params and pass spot data as props
    return {
      params: {
        county: countySlug,
        slug: spotSlug
      },
      props: {
        spot: {
          ...spot,
          amenities: parsedAmenities
        }
      }
    };
  });

  // 4. Return paths array directly (Astro expects an array, not an object)
  return paths;
}

const { spot } = Astro.props;
const MAPBOX_TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN;
const mapUrl = `https://api.mapbox.com/styles/v1/mapbox/streets-v11/static/${spot.longitude},${spot.latitude},14,0/600x400?access_token=${MAPBOX_TOKEN}`;

// Extract primary county for display (handles multi-county entries)
let primaryCounty = spot.county;
if (primaryCounty.includes(',')) {
  primaryCounty = primaryCounty.split(',')[0].trim();
}
// Remove "County" suffix if present
primaryCounty = primaryCounty.replace(/\s+County$/i, '').trim();

// Create county slug for URLs
const countySlug = primaryCounty.toLowerCase().replace(/\s+/g, '-');

// Schema.org structured data for SEO
const schema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": spot.name,
  "description": spot.description,
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": Number(spot.latitude),
    "longitude": Number(spot.longitude)
  },
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "TX",
    "addressLocality": primaryCounty === 'Multiple Counties' ? 'Multiple Counties' : primaryCounty + " County"
  }
};
---

<Layout
  title={spot.meta_title || `${spot.name} - Public Fishing in ${primaryCounty === 'Multiple Counties' ? 'Multiple Counties' : primaryCounty + ' County'}, TX`}
  description={spot.meta_description || `Free public fishing access at ${spot.name}. GPS coordinates, amenities, and fishing reports.`}
>
  <article class="spot-detail" data-spot-id={spot.id}>
    <div class="retro-container">
      <div class="retro-breadcrumb">
        <a href="/">Home</a> /
        <a href="/texas">Texas</a> /
        {primaryCounty === 'Multiple Counties' ? (
          <span>{primaryCounty}</span>
        ) : (
          <a href={`/texas/${countySlug}`}>{primaryCounty} County</a>
        )} /
        {spot.name}
      </div>

      <h1 class="retro-heading retro-heading-lg">{spot.name}</h1>

      {spot.is_verified && (
        <div class="retro-badge retro-badge-large verified">✓ Verified by TPWD</div>
      )}

      <div class="spot-grid">
        <div class="main-content">
          <!-- Static Map Image (SEO-friendly, loads fast) -->
          <div class="map-container">
            <img
              src={mapUrl}
              alt={`Map of ${spot.name}`}
              width="600"
              height="400"
              loading="eager"
            />
            <div class="map-overlay">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${spot.latitude},${spot.longitude}`}
                target="_blank"
                rel="noopener noreferrer"
                class="retro-btn retro-btn-primary"
              >
                Open in Google Maps
              </a>
            </div>
          </div>

          <!-- Description -->
          <section class="retro-section description">
            <h2 class="retro-heading retro-heading-md retro-heading-underline">About This Spot</h2>
            {spot.description ? (
              <p>{spot.description}</p>
            ) : (
              <p>Public fishing access in {primaryCounty === 'Multiple Counties' ? 'Multiple Counties' : primaryCounty + ' County'}, Texas.</p>
            )}
          </section>

          <!-- Amenities -->
          {spot.amenities && (
            <section class="retro-section amenities">
              <h2 class="retro-heading retro-heading-md retro-heading-underline">Amenities</h2>
              <ul class="amenity-list">
                {spot.amenities.boat_ramp && <li>🚤 Boat Ramp</li>}
                {spot.amenities.parking && <li>🅿️ Parking Available</li>}
                {spot.amenities.restrooms && <li>🚻 Restrooms</li>}
                {spot.amenities.lighting && <li>💡 Lighting</li>}
                {spot.amenities.fish_cleaning && <li>🔪 Fish Cleaning Station</li>}
                {spot.amenities.boat_trailer_parking && <li>🚢 Boat Trailer Parking</li>}
                {spot.amenities.camping && <li>⛺ Camping</li>}
                {spot.amenities.fishing_pier && <li>🎣 Fishing Pier</li>}
                {spot.amenities.picnic_area && <li>🧺 Picnic Area</li>}
              </ul>
            </section>
          )}

          <!-- Dynamic Content: Fishing Reports -->
          <section class="retro-section fishing-reports">
            <h2 class="retro-heading retro-heading-md retro-heading-underline">Recent Fishing Reports</h2>
            <div id="reports-container">
              <p class="loading">Loading recent catches...</p>
            </div>

            <button class="retro-btn retro-btn-secondary" id="add-report-btn">
              Add Your Fishing Report
            </button>
          </section>

          <!-- Dynamic Content: Fish Species Votes -->
          <section class="retro-section fish-votes">
            <h2 class="retro-heading retro-heading-md retro-heading-underline">What Fish Are Here?</h2>
            <p>Help other anglers by voting on what species you've caught here:</p>
            <div id="fish-votes-container">
              <p class="loading">Loading...</p>
            </div>
          </section>
        </div>

        <!-- Sidebar -->
        <aside class="sidebar">
          <div class="retro-info-box">
            <h3>Quick Info</h3>
            <dl>
              <dt>Type:</dt>
              <dd>{spot.spot_type.replace(/_/g, ' ')}</dd>

              <dt>County:</dt>
              <dd>{spot.county}</dd>

              {spot.water_body_name && (
                <>
                  <dt>Water Body:</dt>
                  <dd>{spot.water_body_name}</dd>
                </>
              )}

              <dt>Coordinates:</dt>
              <dd>
                {Number(spot.latitude).toFixed(6)}, {Number(spot.longitude).toFixed(6)}
                <button class="copy-coords" data-coords={`${spot.latitude},${spot.longitude}`}>
                  Copy
                </button>
              </dd>
            </dl>
          </div>

          {spot.spot_type === 'state_park' && (
            <div class="retro-info-box highlight">
              <h3>⭐ Free Fishing!</h3>
              <p>No fishing license required at Texas State Parks</p>
            </div>
          )}
        </aside>
      </div>
    </div>
  </article>

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Load dynamic content -->
  <script src="/js/load-spot-content.js" is:inline></script>
</Layout>

<style>
  /* Page-specific styles only - common styles in retro-common.css */

  .verified {
    background: var(--earth-forest);
    color: white;
  }

  .spot-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    margin-top: 2rem;
  }

  .map-container {
    position: relative;
    border-radius: 0;
    overflow: hidden;
    border: 4px solid var(--neutral-black);
    box-shadow: 8px 8px 0 rgba(0,0,0,0.2);
  }

  .map-container img {
    width: 100%;
    height: auto;
    display: block;
  }

  .map-overlay {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
  }

  .amenity-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .amenity-list li {
    padding: 0.75rem 1rem;
    background: var(--box-sage);
    border: 2px solid var(--neutral-black);
    border-radius: 0;
    font-weight: 700;
  }

  .sidebar {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  dl {
    margin: 0;
  }

  dt {
    font-weight: 700;
    margin-top: 0.75rem;
    color: var(--neutral-black);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  dd {
    margin: 0.25rem 0 0.75rem 0;
    font-weight: 600;
  }

  .copy-coords {
    margin-left: 0.5rem;
    padding: 0.4rem 0.7rem;
    font-size: 0.75rem;
    background: var(--neutral-black);
    color: white;
    border: none;
    border-radius: 0;
    cursor: pointer;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .copy-coords:hover {
    background: var(--accent-copper);
    color: var(--neutral-black);
  }

  .loading {
    color: var(--neutral-gray);
    font-style: italic;
    font-weight: 600;
  }

  .description p {
    line-height: 1.8;
    font-size: 1.05rem;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .spot-grid {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
    }
  }
</style>
