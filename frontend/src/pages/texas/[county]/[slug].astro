    font-weight: 700;
  }

  .spot-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
  }

  .map-container {
    position: relative;
    border-radius: 0;
    overflow: hidden;
    border: 2px solid rgba(184, 92, 58, 0.6);
    box-shadow:
      0 0 15px rgba(184, 92, 58, 0.3),
      inset 0 0 30px rgba(100, 100, 100, 0.3);
    width: 100%;
    max-width: 100%;
  }

  :global([data-theme="light"]) .map-container {
    border: 4px solid var(--neutral-black);
    box-shadow: 8px 8px 0 rgba(0,0,0,0.2);
  }

  .map-container img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    opacity: 0.9;
    min-height: 400px;
    object-fit: cover;
  }

  :global([data-theme="light"]) .map-container img {
    opacity: 1;
  }

  /* Mobile: Make map at least twice as big */
  @media (max-width: 768px) {
    .map-container img {
      min-height: 500px;
    }
  }

  @media (max-width: 480px) {
    .map-container img {
      min-height: 350px; /* Reduce on very small screens to prevent overflow */
    }

    .map-overlay {
      bottom: 0.5rem;
      left: 0.5rem;
      right: 0.5rem;
    }
  }

  .map-overlay {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
  }

  /* retro-section base styles now in retro-common.css */
  /* Only page-specific overrides here */
  .retro-section {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  /* Reduce padding on very small screens to prevent horizontal overflow */
  @media (max-width: 480px) {
    .retro-section {
      padding: 1rem;
    }
  }

  .retro-section h2 {
    font-family: 'VT323', monospace;
    color: var(--theme-heading-color);
    font-size: 2rem;
    font-weight: 400;
    margin: 0 0 1rem 0;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
  }

  :global([data-theme="light"]) .retro-section h2 {
    color: var(--theme-heading-color);
    font-weight: 700;
    text-shadow: none;
  }

  .description p {
    font-family: 'VT323', monospace;
    line-height: 1.8;
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--theme-text-secondary);
  }

  :global([data-theme="light"]) .description p {
    color: var(--neutral-black);
    font-weight: 500;
  }

  .amenities-subsection {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(168, 197, 168, 0.3);
  }

  :global([data-theme="light"]) .amenities-subsection {
    border-top: 2px solid rgba(0, 0, 0, 0.1);
  }

  .amenities-subheading {
    font-family: 'VT323', monospace;
    color: var(--theme-text-sage);
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0 0 1rem 0;
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.4);
  }

  :global([data-theme="light"]) .amenities-subheading {
    color: var(--earth-rust);
    font-weight: 700;
    text-shadow: none;
  }

  .amenity-list {
    list-style: none;
    padding: 0;
