    top: 2rem;
    align-self: start;
  }

  /* retro-info-box base styles now in retro-common.css */
  /* Override font-size for this page only */
  .retro-info-box h3 {
    font-size: 1.5rem;
  }

  dl {
    margin: 0;
    font-family: 'VT323', monospace;
  }

  dt {
    font-weight: 400;
    margin-top: 0.75rem;
    color: var(--earth-sand);
    text-transform: uppercase;
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    text-shadow: 0 0 6px rgba(212, 165, 116, 0.4);
  }

  :global([data-theme="light"]) dt {
    color: var(--earth-rust) !important;
    font-weight: 700;
    text-shadow: none;
    font-size: 1rem;
  }

  dd {
