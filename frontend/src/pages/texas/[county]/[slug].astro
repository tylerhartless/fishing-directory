---
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getSpots, generateMapUrl, getSpotCounties, getSpotCountyDisplay, type FishingSpot } from '../../../lib/database';


export async function getStaticPaths() {
  const spots = await getSpots(); 
  
  // Filter out any spots where the required data (county or slug) might be missing or invalid
  const validSpots = spots.filter(spot => spot && spot.county && spot.slug);

  const paths = validSpots.map((spot) => {

    // 1. Explicitly coerce and clean the county name
    let countyName = String(spot.county || '');

    // Handle multi-county entries (e.g., "Harris, Fort Bend") - use only first county
    if (countyName.includes(',')) {
      countyName = countyName.split(',')[0].trim();
    }

    // Remove "County" suffix if present (e.g., "Fort Bend County" -> "Fort Bend")
    countyName = countyName.replace(/\s+County$/i, '').trim();

    // Create slug: lowercase and replace spaces with hyphens
    const countySlug = countyName.toLowerCase().replace(/\s+/g, '-');

    // 2. Explicitly coerce the slug
    const spotSlug = String(spot.slug || '');

    // 3. Parse amenities if it's a JSON string
    let parsedAmenities = spot.amenities;
    if (typeof spot.amenities === 'string') {
      try {
        parsedAmenities = JSON.parse(spot.amenities);
      } catch (e) {
        console.error(`Failed to parse amenities for spot ${spot.slug}:`, e);
        parsedAmenities = null;
      }
    }

    // 4. Return params and pass spot data as props
    return {
      params: {
        county: countySlug,
        slug: spotSlug
      },
      props: {
        spot: {
          ...spot,
          amenities: parsedAmenities
        }
      }
    };
  });

  // 4. Return paths array directly (Astro expects an array, not an object)
  return paths;
}

const { spot } = Astro.props;
const MAPBOX_TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN;
// Use streets-v11 for light mode, dark-v11 for dark mode
// Larger dimensions (900x600) for better mobile display
const mapUrl = `https://api.mapbox.com/styles/v1/mapbox/streets-v11/static/${spot.longitude},${spot.latitude},14.5,0/900x600?access_token=${MAPBOX_TOKEN}`;
const darkMapUrl = `https://api.mapbox.com/styles/v1/mapbox/dark-v11/static/${spot.longitude},${spot.latitude},14.5,0/900x600?access_token=${MAPBOX_TOKEN}`;

// Get all counties for this spot (supports both legacy and new multi-county format)
const spotCounties = getSpotCounties(spot);
const countyDisplay = getSpotCountyDisplay(spot);
const primaryCounty = spotCounties.length > 0 ? spotCounties[0] : 'Unknown';
const isMultiCounty = spotCounties.length > 1;

// Create county slug for URLs (use primary county)
const countySlug = primaryCounty.toLowerCase().replace(/\s+/g, '-');

// Schema.org structured data for SEO
const schema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": spot.name,
  "description": spot.description,
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": Number(spot.latitude),
    "longitude": Number(spot.longitude)
  },
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "TX",
    "addressLocality": isMultiCounty ? countyDisplay : `${primaryCounty} County`
  }
};
---

<Layout
  title={spot.meta_title || `${spot.name} - Public Fishing in ${isMultiCounty ? countyDisplay : primaryCounty + ' County'}, TX`}
  description={spot.meta_description || `Free public fishing access at ${spot.name}. GPS coordinates, amenities, and fishing reports.`}
>
  <section class="retro-page-header">
    <div class="container">
      <a href={`/texas/${countySlug}`} class="page-back-link">← {primaryCounty} County</a>
      <h1 transition:name={`spot-title-${spot.id}`}>{spot.name}</h1>
    </div>
  </section>

  <article class="spot-detail" data-spot-id={spot.id}>
    <div class="retro-container">
      {spot.is_verified && (
        <div class="retro-badge retro-badge-large verified">✓ Verified by TPWD</div>
      )}

      <div class="spot-grid">
        <div class="main-content">
          <!-- Static Map Image (SEO-friendly, loads fast) -->
          <div class="map-container">
            <img
              id="spot-map"
              src={mapUrl}
              data-light-url={mapUrl}
              data-dark-url={darkMapUrl}
              alt={`Map of ${spot.name}`}
              width="900"
              height="600"
              loading="eager"
              class="hidden-map"
            />
            <!-- Set correct map URL immediately based on theme to prevent flash -->
            <script is:inline>
              (function() {
                function initializeMap() {
                  const mapImg = document.getElementById('spot-map');
                  if (!mapImg) {
                    // Retry if DOM not ready yet
                    if (document.readyState === 'loading') {
                      setTimeout(initializeMap, 50);
                    }
                    return;
                  }

                  const lightUrl = mapImg.getAttribute('data-light-url');
                  const darkUrl = mapImg.getAttribute('data-dark-url');
                  if (!lightUrl || !darkUrl) return;

                  function getCurrentTheme() {
                    const currentTheme = document.documentElement.getAttribute('data-theme');
                    return currentTheme === 'dark' || (!currentTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
                  }

                  let loadRetryCount = 0;
                  const maxRetries = 2;

                  function showMap() {
                    mapImg.style.opacity = '1';
                    mapImg.classList.remove('hidden-map');
                  }

                  function handleMapError(retryUrl) {
                    if (loadRetryCount < maxRetries) {
                      loadRetryCount++;
                      setTimeout(function() {
                        mapImg.src = retryUrl + '&_retry=' + loadRetryCount;
                      }, loadRetryCount * 1000);
                    } else {
                      // After max retries, show anyway with reduced opacity as fallback
                      mapImg.style.opacity = '0.5';
                      mapImg.classList.remove('hidden-map');
                      console.warn('Map image failed to load after retries');
                    }
                  }

                  // Determine initial theme and set URL
                  const isDark = getCurrentTheme();
                  const correctUrl = isDark ? darkUrl : lightUrl;
                  
                  // Only change URL if different
                  const currentSrc = mapImg.getAttribute('src') || mapImg.src;
                  const needsUrlChange = !currentSrc.includes(isDark ? 'dark-v11' : 'streets-v11');
                  
                  if (needsUrlChange) {
                    mapImg.src = correctUrl;
                  }

                  // Set up load/error handlers (remove existing first to avoid duplicates)
                  const loadHandler = function() {
                    showMap();
                    loadRetryCount = 0; // Reset retry count on success
                  };
                  
                  const errorHandler = function() {
                    handleMapError(correctUrl);
                  };

                  // Remove any existing handlers before adding new ones
                  mapImg.removeEventListener('load', loadHandler);
                  mapImg.removeEventListener('error', errorHandler);
                  mapImg.addEventListener('load', loadHandler);
                  mapImg.addEventListener('error', errorHandler);

                  // If image is already loaded, show immediately
                  if (mapImg.complete && mapImg.naturalHeight !== 0) {
                    showMap();
                  } else if (mapImg.complete && mapImg.naturalHeight === 0) {
                    // Image loaded but failed (naturalHeight === 0 indicates error)
                    handleMapError(correctUrl);
                  }
                }

                // Initialize when DOM is ready
                if (document.readyState === 'loading') {
                  document.addEventListener('DOMContentLoaded', initializeMap);
                } else {
                  initializeMap();
                }
              })();
            </script>
            <div class="map-overlay">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${spot.latitude},${spot.longitude}`}
                target="_blank"
                rel="noopener noreferrer"
                class="retro-btn retro-btn-search text-center no-underline"
              >
                Open in Google Maps
              </a>
            </div>
          </div>

          <!-- Ad: between map and description (mobile) -->
          <AdSlot format="horizontal" class="ad-slot-inline" />

          <!-- Description -->
          <section class="retro-section description">
            <h2>About This Spot</h2>
            {spot.description ? (
              <p>{spot.description}</p>
            ) : (
              <p>Public fishing access in {isMultiCounty ? countyDisplay : primaryCounty + ' County'}, Texas.</p>
            )}

            {/* Amenities within About This Spot */}
            {spot.amenities && (Object.values(spot.amenities).some(v => v === true)) ? (
              <div class="amenities-subsection">
                <h3 class="amenities-subheading">Amenities</h3>
                <ul class="amenity-list">
                  {spot.amenities.boat_ramp && <li>🚤 Boat Ramp</li>}
                  {spot.amenities.parking && <li>🅿️ Parking Available</li>}
                  {spot.amenities.restrooms && <li>🚻 Restrooms</li>}
                  {spot.amenities.lighting && <li>💡 Lighting</li>}
                  {spot.amenities.fish_cleaning && <li>🔪 Fish Cleaning Station</li>}
                  {spot.amenities.boat_trailer_parking && <li>🚢 Boat Trailer Parking</li>}
                  {spot.amenities.camping && <li>⛺ Camping</li>}
                  {spot.amenities.fishing_pier && <li>🎣 Fishing Pier</li>}
                  {spot.amenities.picnic_area && <li>🧺 Picnic Area</li>}
                </ul>
              </div>
            ) : null}
          </section>

          <!-- Heat List: Species Prevalence System -->
          <section class="retro-section heat-list-section">
            <h2>What's Biting Here?</h2>
            <p class="heat-list-description">Species ranked by recent catch activity. Use the button below to log a catch!</p>

            <div id="heat-list-container">
              <p class="loading">Loading species data...</p>
            </div>

            <button class="retro-btn retro-btn-search text-center no-underline" id="log-catch-btn">
              🎣 Log a Catch
            </button>
          </section>
        </div>

        <!-- Sidebar -->
        <aside class="sidebar">
          <div class="retro-info-box">
            <h3>Quick Info</h3>
            <dl>
              <dt>Type:</dt>
              <dd>{spot.spot_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</dd>

              <dt>{isMultiCounty ? 'Counties:' : 'County:'}</dt>
              <dd>
                {isMultiCounty ? (
                  <ul class="spot-detail-list">
                    {spotCounties.map(county => (
                      <li>
                        <a href={`/texas/${county.toLowerCase().replace(/\s+/g, '-')}`}>
                          {county} County
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <a href={`/texas/${countySlug}`}>{primaryCounty} County</a>
                )}
              </dd>

              {spot.water_body_name && (
                <>
                  <dt>Water Body:</dt>
                  <dd>{spot.water_body_name}</dd>
                </>
              )}

              <dt>Coordinates:</dt>
              <dd>
                {Number(spot.latitude).toFixed(6)}, {Number(spot.longitude).toFixed(6)}
                <button class="copy-coords" data-coords={`${spot.latitude},${spot.longitude}`}>
                  Copy
                </button>
              </dd>
            </dl>
          </div>

          {spot.spot_type === 'state_park' && (
            <div class="retro-info-box highlight">
              <h3>⭐ Free Fishing!</h3>
              <p>No fishing license required at Texas State Parks</p>
            </div>
          )}

          <!-- Ad: below sidebar info boxes -->
          <AdSlot format="rectangle" class="ad-slot-sidebar-content" />
        </aside>
      </div>
    </div>
  </article>

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Load heat list (species prevalence system) -->
  <script src="/js/heat-list.js" is:inline></script>

  <!-- Theme-aware map switching with debouncing and error handling -->
  <script is:inline>
    (function() {
      function setupThemeSwitching() {
        const mapImg = document.getElementById('spot-map');
        if (!mapImg) {
          // Retry if DOM not ready
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupThemeSwitching);
          } else {
            setTimeout(setupThemeSwitching, 100);
          }
          return;
        }

        const lightUrl = mapImg.dataset.lightUrl || mapImg.getAttribute('data-light-url');
        const darkUrl = mapImg.dataset.darkUrl || mapImg.getAttribute('data-dark-url');
        
        if (!lightUrl || !darkUrl) return;

        let debounceTimer;
        let retryCount = 0;
        const maxRetries = 2;

        function updateMapTheme(retry = 0) {
          const currentTheme = document.documentElement.getAttribute('data-theme');
          const isDark = currentTheme === 'dark' || (!currentTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);

          // Check the style in the URL instead of full URL comparison
          // This avoids issues with URL normalization
          const currentSrc = mapImg.getAttribute('src') || mapImg.src;
          const isCurrentlyDark = currentSrc.includes('dark-v11');
          const isCurrentlyLight = currentSrc.includes('streets-v11');

          // Update map if theme doesn't match current map style
          const shouldSwitch = (isDark && !isCurrentlyDark) || (!isDark && !isCurrentlyLight);
          
          if (shouldSwitch) {
            const newUrl = isDark ? darkUrl : lightUrl;
            
            // Set up error handler before changing src
            const errorHandler = function() {
              if (retry < maxRetries) {
                setTimeout(function() {
                  updateMapTheme(retry + 1);
                }, (retry + 1) * 1000);
              } else {
                console.warn('Map theme switch failed after retries');
              }
              mapImg.removeEventListener('error', errorHandler);
            };
            
            mapImg.addEventListener('error', errorHandler);
            mapImg.src = newUrl;
            
            // Reset retry count on success
            const successHandler = function() {
              retryCount = 0;
              mapImg.removeEventListener('load', successHandler);
            };
            mapImg.addEventListener('load', successHandler);
          }
        }

        // Preload both map images to avoid API calls on every theme switch
        const lightImage = new Image();
        const darkImage = new Image();
        lightImage.src = lightUrl;
        darkImage.src = darkUrl;

        // Initial map theme check (after a small delay to ensure initial setup is done)
        setTimeout(updateMapTheme, 100);

        // Watch for theme changes with debouncing
        const observer = new MutationObserver(() => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function() {
            retryCount = 0;
            updateMapTheme(0);
          }, 100);
        });

        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme']
        });
      }

      // Setup when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupThemeSwitching);
      } else {
        setupThemeSwitching();
      }
    })();
  </script>
</Layout>

