    font-family: 'VT323', monospace;
    background: rgba(168, 197, 168, 0.2);
    border: 2px solid rgba(168, 197, 168, 0.4);
    border-radius: 0;
    color: var(--theme-text-sage);
    font-size: 1.2rem;
    font-weight: 400;
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.4);
    box-shadow: 0 0 8px rgba(168, 197, 168, 0.2);
  }

  :global([data-theme="light"]) .amenity-list li {
    background: var(--box-sage);
    border: 2px solid var(--neutral-black);
    color: var(--neutral-black);
    box-shadow: none;
    text-shadow: none;
    font-weight: 700;
  }

  .amenities-empty-message {
