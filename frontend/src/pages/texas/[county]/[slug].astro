    .retro-heading-lg {
      font-size: 2.2rem;
    }

    .retro-section h2 {
      font-size: 1.6rem;
    }
  }

  /* Extra small screens - prevent overflow */
  @media (max-width: 480px) {
    .retro-section h2 {
      font-size: 1.4rem;
    }

    .retro-btn {
      font-size: 1.1rem;
      padding: 0.6rem 1rem;
    }

    .amenity-list {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .amenity-list li {
      font-size: 1.1rem;
      padding: 0.6rem 0.8rem;
    }
  }

  /* ============================================
     HEAT LIST (SPECIES PREVALENCE SYSTEM)
     ============================================ */

  .heat-list-description {
    font-family: 'VT323', monospace;
    color: var(--theme-text-secondary);
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
  }

  :global([data-theme="light"]) .heat-list-description {
    color: var(--neutral-black);
    font-weight: 500;
  }

  .heat-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .species-item {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    font-family: 'VT323', monospace;
    background: rgba(168, 197, 168, 0.15);
    border: 2px solid rgba(168, 197, 168, 0.3);
    cursor: pointer;
    transition: all 0.2s;
  }

  :global([data-theme="light"]) .species-item {
    background: var(--box-sage);
    border: 2px solid var(--neutral-black);
  }

