---
import Layout from '../../../layouts/Layout.astro';
import SearchWidget from '../../../components/SearchWidget.tsx';
import AdSlot from '../../../components/AdSlot.astro';
import { getSpots } from '../../../lib/database';

export async function getStaticPaths() {
  const allSpots = await getSpots();
  const texasSpots = allSpots.filter(spot => spot.state === 'TX' || spot.state === 'Texas');

  // Get unique counties
  const counties = new Set<string>();

  texasSpots.forEach(spot => {
    let countyName = spot.county || '';

    // Handle multi-county entries - use first county
    if (countyName.includes(',')) {
      countyName = countyName.split(',')[0].trim();
    }

    // Remove "County" suffix if present
    countyName = countyName.replace(/\s+County$/i, '').trim();

    // Skip "Multiple Counties"
    if (countyName && countyName !== 'Multiple Counties') {
      counties.add(countyName);
    }
  });

  // Generate paths for each county
  return Array.from(counties).map(countyName => {
    const countySlug = countyName.toLowerCase().replace(/\s+/g, '-');

    // Get all spots for this county
    const countySpots = texasSpots.filter(spot => {
      let spotCounty = spot.county || '';

      // Handle multi-county entries
      if (spotCounty.includes(',')) {
        spotCounty = spotCounty.split(',')[0].trim();
      }

      // Remove "County" suffix
      spotCounty = spotCounty.replace(/\s+County$/i, '').trim();

      return spotCounty === countyName;
    });

    return {
      params: { county: countySlug },
      props: {
        countyName,
        spots: countySpots,
        totalSpots: countySpots.length
      }
    };
  });
}

const { countyName, spots, totalSpots } = Astro.props;
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || '';

// Compute geographic center for the county
const avgLat = spots.reduce((sum, s) => sum + Number(s.latitude), 0) / spots.length;
const avgLon = spots.reduce((sum, s) => sum + Number(s.longitude), 0) / spots.length;

// Serialize for client component
const serializedSpots = spots.map(spot => ({
  id: spot.id,
  slug: spot.slug,
  name: spot.name,
  state: spot.state || 'TX',
  county: spot.county,
  county_slug: spot.county_slug,
  latitude: String(spot.latitude),
  longitude: String(spot.longitude),
  spot_type: spot.spot_type,
  water_body_name: spot.water_body_name,
  amenities: spot.amenities,
}));

// Get unique spot types present in this county for filter chips
const spotTypes = [...new Set(serializedSpots.map(s => s.spot_type))].sort();
---

<Layout
  title={`${countyName} County Fishing Spots - Texas`}
  description={`Find ${totalSpots} public fishing locations in ${countyName} County, Texas. Boat ramps, piers, and bank fishing spots with GPS coordinates.`}
>
  <section class="retro-page-header">
    <div class="container">
      <a href="/texas" class="page-back-link">← Texas</a>
      <h1>{countyName} County Fishing Spots</h1>
      <p class="subtitle">{totalSpots} fishing locations</p>
    </div>
  </section>

  <section class="retro-container">
    <!-- Ad: above results (mobile) -->
    <AdSlot format="horizontal" class="ad-slot-inline" />

    <div class="spots-list-section">
      <SearchWidget
        mapboxToken={mapboxToken}
        initialSpots={serializedSpots}
        hideSearch={true}
        showSortToggle={true}
        availableSpotTypes={spotTypes}
        defaultCenter={[avgLat, avgLon]}
        defaultZoom={10}
        backButtonUrl="/texas"
        backButtonText="Texas"
        client:idle
      />
    </div>
  </section>
</Layout>

<style>
  /* Spots list section - reuse search widget styles */
  .spots-list-section {
    max-width: 900px;
    margin: 0 auto;
  }
</style>
