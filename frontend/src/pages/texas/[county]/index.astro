---
import Layout from '../../../layouts/Layout.astro';
import { getSpots } from '../../../lib/database';

export async function getStaticPaths() {
  const allSpots = await getSpots();
  const texasSpots = allSpots.filter(spot => spot.state === 'TX' || spot.state === 'Texas');

  // Get unique counties
  const counties = new Set<string>();

  texasSpots.forEach(spot => {
    let countyName = spot.county || '';

    // Handle multi-county entries - use first county
    if (countyName.includes(',')) {
      countyName = countyName.split(',')[0].trim();
    }

    // Remove "County" suffix if present
    countyName = countyName.replace(/\s+County$/i, '').trim();

    // Skip "Multiple Counties"
    if (countyName && countyName !== 'Multiple Counties') {
      counties.add(countyName);
    }
  });

  // Generate paths for each county
  return Array.from(counties).map(countyName => {
    const countySlug = countyName.toLowerCase().replace(/\s+/g, '-');

    // Get all spots for this county
    const countySpots = texasSpots.filter(spot => {
      let spotCounty = spot.county || '';

      // Handle multi-county entries
      if (spotCounty.includes(',')) {
        spotCounty = spotCounty.split(',')[0].trim();
      }

      // Remove "County" suffix
      spotCounty = spotCounty.replace(/\s+County$/i, '').trim();

      return spotCounty === countyName;
    });

    return {
      params: { county: countySlug },
      props: {
        countyName,
        spots: countySpots,
        totalSpots: countySpots.length
      }
    };
  });
}

const { countyName, spots, totalSpots } = Astro.props;

// Get unique spot types for filter
const spotTypes = [...new Set(spots.map(spot => spot.spot_type))].sort();
---

<Layout
  title={`${countyName} County Fishing Spots - Texas`}
  description={`Find ${totalSpots} public fishing locations in ${countyName} County, Texas. Boat ramps, piers, and bank fishing spots with GPS coordinates.`}
>
  <section class="retro-page-header">
    <div class="container">
      <nav class="retro-breadcrumb">
        <a href="/">Home</a> / <a href="/texas">Texas</a> / {countyName} County
      </nav>
      <h1>{countyName} County Fishing Spots</h1>
      <p class="subtitle">{totalSpots} fishing locations</p>
    </div>
  </section>

  <section class="retro-container">
    <div class="controls">
      <input
        type="text"
        id="search-input"
        placeholder="Search by name or water body..."
        class="retro-input search-input"
      />

      <div class="filter-group">
        <label for="type-filter">Filter by type:</label>
        <select id="type-filter" class="retro-select">
          <option value="">All types</option>
          {spotTypes.map(type => (
            <option value={type}>{type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="results-info">
      Showing <span id="count">{totalSpots}</span> of {totalSpots} spots
    </div>

    <div id="spots-container" class="retro-grid retro-grid-spots">
      {spots.sort((a, b) => a.name.localeCompare(b.name)).map(spot => (
        <a href={`/texas/${Astro.params.county}/${spot.slug}`} class="retro-card">
          <h3>{spot.name}</h3>
          {spot.water_body_name && (
            <p class="water-body">{spot.water_body_name}</p>
          )}
          <div class="spot-meta">
            <span class="retro-badge spot-type">
              {spot.spot_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* Page-specific styles only - common styles in retro-common.css */

  .controls {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .search-input {
    flex: 1;
    min-width: 250px;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-group label {
    font-family: 'VT323', monospace;
    font-weight: 400;
    color: #d4a574;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    text-shadow:
      0 0 6px rgba(212, 165, 116, 0.4);
  }

  :global([data-theme="light"]) .filter-group label {
    color: var(--neutral-black);
    font-weight: 700;
    text-shadow: none;
  }

  .results-info {
    margin-bottom: 1.5rem;
    color: #b0b0b0;
    font-size: 1.05rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
  }

  :global([data-theme="light"]) .results-info {
    color: var(--neutral-gray);
    font-weight: 600;
  }

  #count {
    font-weight: 400;
    color: #a8c5a8;
    text-shadow:
      0 0 6px rgba(168, 197, 168, 0.4);
  }

  :global([data-theme="light"]) #count {
    font-weight: 700;
    color: var(--neutral-black);
    text-shadow: none;
  }

  :global(.retro-card h3) {
    margin: 0 0 0.5rem 0;
    color: #f0e6d2;
    font-size: 1.2rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-shadow:
      0 0 8px rgba(240, 230, 210, 0.5);
  }

  :global([data-theme="light"] .retro-card h3) {
    color: var(--neutral-black);
    font-weight: 900;
    text-shadow: none;
  }

  :global(.water-body) {
    color: #b0b0b0;
    font-size: 0.95rem;
    font-family: 'VT323', monospace;
    margin: 0 0 1rem 0;
    font-weight: 400;
  }

  :global([data-theme="light"] .water-body) {
    color: #666;
    font-weight: 500;
  }

  :global(.spot-meta) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .controls {
      flex-direction: column;
    }

    .search-input {
      min-width: 100%;
    }

    .filter-group {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }

    .filter-group select {
      width: 100%;
    }
  }
</style>

<script define:vars={{ spots }}>
  // Store all spots for filtering
  let currentSpots = spots;

  // Get DOM elements
  const searchInput = document.getElementById('search-input');
  const typeFilter = document.getElementById('type-filter');
  const spotsContainer = document.getElementById('spots-container');
  const countDisplay = document.getElementById('count');

  // Filter and display spots
  function filterAndDisplay() {
    const searchTerm = searchInput.value.toLowerCase();
    const typeFilter = document.getElementById('type-filter').value;

    let filtered = currentSpots;

    // Apply search filter
    if (searchTerm) {
      filtered = filtered.filter(spot =>
        spot.name.toLowerCase().includes(searchTerm) ||
        (spot.water_body_name && spot.water_body_name.toLowerCase().includes(searchTerm))
      );
    }

    // Apply type filter
    if (typeFilter) {
      filtered = filtered.filter(spot => spot.spot_type === typeFilter);
    }

    // Sort alphabetically
    filtered = filtered.sort((a, b) => a.name.localeCompare(b.name));

    // Update display
    displaySpots(filtered);
    countDisplay.textContent = filtered.length;
  }

  // Display spots in the grid
  function displaySpots(spotsToDisplay) {
    const countySlug = window.location.pathname.split('/')[2];

    spotsContainer.innerHTML = spotsToDisplay.map(spot => {
      const waterBody = spot.water_body_name ?
        `<p class="water-body">${spot.water_body_name}</p>` : '';

      const typeLabel = spot.spot_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

      return `
        <a href="/texas/${countySlug}/${spot.slug}" class="retro-card">
          <h3>${spot.name}</h3>
          ${waterBody}
          <div class="spot-meta">
            <span class="retro-badge spot-type">${typeLabel}</span>
          </div>
        </a>
      `;
    }).join('');
  }

  // Add event listeners
  searchInput.addEventListener('input', filterAndDisplay);
  typeFilter.addEventListener('change', filterAndDisplay);
</script>
</Layout>
