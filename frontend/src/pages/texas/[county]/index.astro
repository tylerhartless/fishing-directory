---
import Layout from '../../../layouts/Layout.astro';
import { getSpots } from '../../../lib/database';

export async function getStaticPaths() {
  const allSpots = await getSpots();
  const texasSpots = allSpots.filter(spot => spot.state === 'TX' || spot.state === 'Texas');

  // Get unique counties
  const counties = new Set<string>();

  texasSpots.forEach(spot => {
    let countyName = spot.county || '';

    // Handle multi-county entries - use first county
    if (countyName.includes(',')) {
      countyName = countyName.split(',')[0].trim();
    }

    // Remove "County" suffix if present
    countyName = countyName.replace(/\s+County$/i, '').trim();

    // Skip "Multiple Counties"
    if (countyName && countyName !== 'Multiple Counties') {
      counties.add(countyName);
    }
  });

  // Generate paths for each county
  return Array.from(counties).map(countyName => {
    const countySlug = countyName.toLowerCase().replace(/\s+/g, '-');

    // Get all spots for this county
    const countySpots = texasSpots.filter(spot => {
      let spotCounty = spot.county || '';

      // Handle multi-county entries
      if (spotCounty.includes(',')) {
        spotCounty = spotCounty.split(',')[0].trim();
      }

      // Remove "County" suffix
      spotCounty = spotCounty.replace(/\s+County$/i, '').trim();

      return spotCounty === countyName;
    });

    return {
      params: { county: countySlug },
      props: {
        countyName,
        spots: countySpots,
        totalSpots: countySpots.length
      }
    };
  });
}

const { countyName, spots, totalSpots } = Astro.props;

// Get unique spot types for filter
const spotTypes = [...new Set(spots.map(spot => spot.spot_type))].sort();
---

<Layout
  title={`${countyName} County Fishing Spots - Texas`}
  description={`Find ${totalSpots} public fishing locations in ${countyName} County, Texas. Boat ramps, piers, and bank fishing spots with GPS coordinates.`}
>
  <section class="retro-page-header">
    <div class="container">
      <nav class="retro-breadcrumb">
        <a href="/">Home</a> / <a href="/texas">Texas</a> / {countyName} County
      </nav>
      <h1>{countyName} County Fishing Spots</h1>
      <p class="subtitle">{totalSpots} fishing locations</p>
    </div>
  </section>

  <section class="retro-container">
    <div class="controls">
      <input
        type="text"
        id="search-input"
        placeholder="Search by name or water body..."
        class="retro-input search-input"
      />

      <div class="filter-group">
        <label for="type-filter">Filter by type:</label>
        <select id="type-filter" class="retro-select">
          <option value="">All types</option>
          {spotTypes.map(type => (
            <option value={type}>{type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="results-info">
      Showing <span id="count">{totalSpots}</span> of {totalSpots} spots
    </div>

    <div id="spots-container" class="retro-grid retro-grid-spots">
      {spots.sort((a, b) => a.name.localeCompare(b.name)).map(spot => {
        const amenities = spot.amenities ? (typeof spot.amenities === 'string' ? JSON.parse(spot.amenities) : spot.amenities) : {};
        const amenitiesJson = JSON.stringify(amenities);

        const prominentAmenities = [];
        const amenityIcons = {
          'boat_ramp': '🚤 Boat Ramp',
          'fishing_pier': '🎣 Pier',
          'fish_cleaning': '🔪 Cleaning Station',
          'restrooms': '🚻 Restrooms',
          'parking': '🅿️ Parking',
          'boat_trailer_parking': '🚢 Boat Trailer',
          'camping': '⛺ Camping',
          'lighting': '💡 Lighting',
          'picnic_area': '🧺 Picnic Area'
        };

        for (const [key, label] of Object.entries(amenityIcons)) {
          if (amenities[key] === true) {
            prominentAmenities.push(label);
          }
        }

        return (
          <a href={`/texas/${Astro.params.county}/${spot.slug}`} class="retro-card" data-spot-type={spot.spot_type} data-amenities={amenitiesJson}>
            <h3>{spot.name}</h3>
            <div class="spot-meta">
              <span class="retro-badge spot-type">
                {spot.spot_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}
              </span>
            </div>
            {prominentAmenities.length > 0 && (
              <div class="amenities-row">
                {prominentAmenities.map(label => (
                  <span class="amenity-badge">{label}</span>
                ))}
              </div>
            )}
          </a>
        );
      })}
    </div>
  </section>
</Layout>

<style>
  /* Page-specific styles only - common styles in retro-common.css */

  .controls {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .search-input {
    flex: 1;
    min-width: 250px;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-group label {
    font-family: 'VT323', monospace;
    font-weight: 400;
    color: #d4a574;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    text-shadow:
      0 0 6px rgba(212, 165, 116, 0.4);
  }

  :global([data-theme="light"]) .filter-group label {
    color: var(--neutral-black);
    font-weight: 700;
    text-shadow: none;
  }

  .results-info {
    margin-bottom: 1.5rem;
    color: #b0b0b0;
    font-size: 1.05rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
  }

  :global([data-theme="light"]) .results-info {
    color: var(--neutral-gray);
    font-weight: 600;
  }

  #count {
    font-weight: 400;
    color: #a8c5a8;
    text-shadow:
      0 0 6px rgba(168, 197, 168, 0.4);
  }

  :global([data-theme="light"]) #count {
    font-weight: 700;
    color: var(--neutral-black);
    text-shadow: none;
  }

  :global(.retro-card h3) {
    margin: 0 0 0.75rem 0;
    color: var(--theme-heading-color);
    font-size: 1.8rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-shadow:
      0 0 10px rgba(255, 255, 255, 0.6),
      0 0 20px rgba(255, 255, 255, 0.4);
  }

  :global([data-theme="light"] .retro-card h3) {
    color: var(--theme-heading-color);
    font-weight: 900;
    text-shadow: none;
  }

  :global(.water-body) {
    color: #b0b0b0;
    font-size: 0.95rem;
    font-family: 'VT323', monospace;
    margin: 0 0 1rem 0;
    font-weight: 400;
  }

  :global([data-theme="light"] .water-body) {
    color: #666;
    font-weight: 500;
  }

  :global(.spot-meta) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  :global(.amenities-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  :global(.amenity-badge) {
    background: rgba(168, 197, 168, 0.15);
    border: 1px solid rgba(168, 197, 168, 0.3);
    color: #a8c5a8;
    padding: 0.3rem 0.6rem;
    font-size: 1rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    text-shadow: none;
  }

  :global([data-theme="light"] .amenity-badge) {
    background: rgba(122, 132, 80, 0.1);
    border: 1px solid rgba(122, 132, 80, 0.3);
    color: #5a6450;
    text-shadow: none;
    font-weight: 600;
  }

  /* Spot type badge styling */
  :global(.spot-type) {
    padding: 0.4rem 0.8rem;
    font-size: 1rem;
    font-family: 'VT323', monospace;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Colored card outlines and spot type badges based on spot type */

  /* Lake - Blue for dark, slate blue for light */
  :global(.retro-card[data-spot-type="lake"]) {
    border-color: #5c9dff;
    box-shadow: 0 0 12px rgba(92, 157, 255, 0.25);
  }

  :global(.retro-card[data-spot-type="lake"] .spot-type) {
    background: rgba(92, 157, 255, 0.2);
    border: 1px solid rgba(92, 157, 255, 0.5);
    color: #5c9dff;
    text-shadow: 0 0 6px rgba(92, 157, 255, 0.5);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="lake"]) {
    border-color: #5a6b73;
    box-shadow: 2px 2px 0 rgba(90, 107, 115, 0.2);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="lake"] .spot-type) {
    background: #5a6b73;
    border: 2px solid #3a4b53;
    color: #ffffff;
    text-shadow: none;
    font-weight: 700;
  }

  /* River Access - Purple for dark, deep purple for light */
  :global(.retro-card[data-spot-type="river_access"]) {
    border-color: #b88dff;
    box-shadow: 0 0 12px rgba(184, 141, 255, 0.25);
  }

  :global(.retro-card[data-spot-type="river_access"] .spot-type) {
    background: rgba(184, 141, 255, 0.2);
    border: 1px solid rgba(184, 141, 255, 0.5);
    color: #b88dff;
    text-shadow: 0 0 6px rgba(184, 141, 255, 0.5);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="river_access"]) {
    border-color: #6b4a9e;
    box-shadow: 2px 2px 0 rgba(107, 74, 158, 0.2);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="river_access"] .spot-type) {
    background: #6b4a9e;
    border: 2px solid #5a3a8e;
    color: #ffffff;
    text-shadow: none;
    font-weight: 700;
  }

  /* Public Water - Green for dark, forest green for light */
  :global(.retro-card[data-spot-type="public_water"]) {
    border-color: #7ec97e;
    box-shadow: 0 0 12px rgba(126, 201, 126, 0.25);
  }

  :global(.retro-card[data-spot-type="public_water"] .spot-type) {
    background: rgba(126, 201, 126, 0.2);
    border: 1px solid rgba(126, 201, 126, 0.5);
    color: #7ec97e;
    text-shadow: 0 0 6px rgba(126, 201, 126, 0.5);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="public_water"]) {
    border-color: #4a6741;
    box-shadow: 2px 2px 0 rgba(74, 103, 65, 0.2);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="public_water"] .spot-type) {
    background: #4a6741;
    border: 2px solid #3a5731;
    color: #ffffff;
    text-shadow: none;
    font-weight: 700;
  }

  /* State Park - Yellow-green for dark, olive green for light */
  :global(.retro-card[data-spot-type="state_park"]) {
    border-color: #a8d96e;
    box-shadow: 0 0 12px rgba(168, 217, 110, 0.25);
  }

  :global(.retro-card[data-spot-type="state_park"] .spot-type) {
    background: rgba(168, 217, 110, 0.2);
    border: 1px solid rgba(168, 217, 110, 0.5);
    color: #a8d96e;
    text-shadow: 0 0 6px rgba(168, 217, 110, 0.5);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="state_park"]) {
    border-color: #7a8450;
    box-shadow: 2px 2px 0 rgba(122, 132, 80, 0.2);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="state_park"] .spot-type) {
    background: #7a8450;
    border: 2px solid #6a7440;
    color: #ffffff;
    text-shadow: none;
    font-weight: 700;
  }

  /* Fishing Pier - Gold for dark, sandy tan for light */
  :global(.retro-card[data-spot-type="fishing_pier"]) {
    border-color: #ffb84d;
    box-shadow: 0 0 12px rgba(255, 184, 77, 0.25);
  }

  :global(.retro-card[data-spot-type="fishing_pier"] .spot-type) {
    background: rgba(255, 184, 77, 0.2);
    border: 1px solid rgba(255, 184, 77, 0.5);
    color: #ffb84d;
    text-shadow: 0 0 6px rgba(255, 184, 77, 0.5);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="fishing_pier"]) {
    border-color: #d4a574;
    box-shadow: 2px 2px 0 rgba(212, 165, 116, 0.2);
  }

  :global([data-theme="light"] .retro-card[data-spot-type="fishing_pier"] .spot-type) {
    background: #d4a574;
    border: 2px solid #c49564;
    color: #2d2d2d;
    text-shadow: none;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .controls {
      flex-direction: column;
    }

    .search-input {
      min-width: 100%;
    }

    .filter-group {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }

    .filter-group select {
      width: 100%;
    }
  }
</style>

<script define:vars={{ spots }}>
  // Store all spots for filtering
  let currentSpots = spots;

  // Get DOM elements
  const searchInput = document.getElementById('search-input');
  const typeFilter = document.getElementById('type-filter');
  const spotsContainer = document.getElementById('spots-container');
  const countDisplay = document.getElementById('count');

  // Filter and display spots
  function filterAndDisplay() {
    const searchTerm = searchInput.value.toLowerCase();
    const typeFilter = document.getElementById('type-filter').value;

    let filtered = currentSpots;

    // Apply search filter
    if (searchTerm) {
      filtered = filtered.filter(spot =>
        spot.name.toLowerCase().includes(searchTerm) ||
        (spot.water_body_name && spot.water_body_name.toLowerCase().includes(searchTerm))
      );
    }

    // Apply type filter
    if (typeFilter) {
      filtered = filtered.filter(spot => spot.spot_type === typeFilter);
    }

    // Sort alphabetically
    filtered = filtered.sort((a, b) => a.name.localeCompare(b.name));

    // Update display
    displaySpots(filtered);
    countDisplay.textContent = filtered.length;
  }

  // Display spots in the grid
  function displaySpots(spotsToDisplay) {
    const countySlug = window.location.pathname.split('/')[2];

    spotsContainer.innerHTML = spotsToDisplay.map(spot => {
      const amenities = spot.amenities ? (typeof spot.amenities === 'string' ? JSON.parse(spot.amenities) : spot.amenities) : {};
      const amenitiesJson = JSON.stringify(amenities);

      const prominentAmenities = [];
      const amenityIcons = {
        'boat_ramp': '🚤 Boat Ramp',
        'fishing_pier': '🎣 Pier',
        'fish_cleaning': '🔪 Cleaning Station',
        'restrooms': '🚻 Restrooms',
        'parking': '🅿️ Parking',
        'boat_trailer_parking': '🚢 Boat Trailer',
        'camping': '⛺ Camping',
        'lighting': '💡 Lighting',
        'picnic_area': '🧺 Picnic Area'
      };

      for (const [key, label] of Object.entries(amenityIcons)) {
        if (amenities[key] === true) {
          prominentAmenities.push(`<span class="amenity-badge">${label}</span>`);
        }
      }

      const amenitiesHtml = prominentAmenities.length > 0
        ? `<div class="amenities-row">${prominentAmenities.join('')}</div>`
        : '';

      const typeLabel = spot.spot_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

      return `
        <a href="/texas/${countySlug}/${spot.slug}" class="retro-card" data-spot-type="${spot.spot_type}" data-amenities='${amenitiesJson}'>
          <h3>${spot.name}</h3>
          <div class="spot-meta">
            <span class="retro-badge spot-type">${typeLabel}</span>
          </div>
          ${amenitiesHtml}
        </a>
      `;
    }).join('');
  }

  // Add event listeners
  searchInput.addEventListener('input', filterAndDisplay);
  typeFilter.addEventListener('change', filterAndDisplay);
</script>
</Layout>
