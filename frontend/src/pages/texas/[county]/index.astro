---
import Layout from '../../../layouts/Layout.astro';
import { getSpots } from '../../../lib/database';

export async function getStaticPaths() {
  const allSpots = await getSpots();
  const texasSpots = allSpots.filter(spot => spot.state === 'TX' || spot.state === 'Texas');

  // Get unique counties
  const counties = new Set<string>();

  texasSpots.forEach(spot => {
    let countyName = spot.county || '';

    // Handle multi-county entries - use first county
    if (countyName.includes(',')) {
      countyName = countyName.split(',')[0].trim();
    }

    // Remove "County" suffix if present
    countyName = countyName.replace(/\s+County$/i, '').trim();

    // Skip "Multiple Counties"
    if (countyName && countyName !== 'Multiple Counties') {
      counties.add(countyName);
    }
  });

  // Generate paths for each county
  return Array.from(counties).map(countyName => {
    const countySlug = countyName.toLowerCase().replace(/\s+/g, '-');

    // Get all spots for this county
    const countySpots = texasSpots.filter(spot => {
      let spotCounty = spot.county || '';

      // Handle multi-county entries
      if (spotCounty.includes(',')) {
        spotCounty = spotCounty.split(',')[0].trim();
      }

      // Remove "County" suffix
      spotCounty = spotCounty.replace(/\s+County$/i, '').trim();

      return spotCounty === countyName;
    });

    return {
      params: { county: countySlug },
      props: {
        countyName,
        spots: countySpots,
        totalSpots: countySpots.length
      }
    };
  });
}

const { countyName, spots, totalSpots } = Astro.props;

// Get unique spot types for filter
const spotTypes = [...new Set(spots.map(spot => spot.spot_type))].sort();
---

<Layout
  title={`${countyName} County Fishing Spots - Texas`}
  description={`Find ${totalSpots} public fishing locations in ${countyName} County, Texas. Boat ramps, piers, and bank fishing spots with GPS coordinates.`}
>
  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a> / <a href="/texas">Texas</a> / {countyName} County
      </nav>
      <h1>{countyName} County Fishing Spots</h1>
      <p class="subtitle">{totalSpots} fishing locations</p>
    </div>
  </section>

  <section class="container">
    <div class="controls">
      <input
        type="text"
        id="search-input"
        placeholder="Search by name or water body..."
        class="search-input"
      />

      <div class="filter-group">
        <label for="type-filter">Filter by type:</label>
        <select id="type-filter" class="filter-select">
          <option value="">All types</option>
          {spotTypes.map(type => (
            <option value={type}>{type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="results-info">
      Showing <span id="count">{totalSpots}</span> of {totalSpots} spots
    </div>

    <div id="spots-container" class="spots-grid">
      {spots.sort((a, b) => a.name.localeCompare(b.name)).map(spot => (
        <a href={`/texas/${Astro.params.county}/${spot.slug}`} class="spot-card">
          <h3>{spot.name}</h3>
          {spot.water_body_name && (
            <p class="water-body">{spot.water_body_name}</p>
          )}
          <div class="spot-meta">
            <span class="spot-type">
              {spot.spot_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--primary-bg);
    color: white;
    padding: 0;
    position: relative;
  }

  .page-header::before {
    content: '';
    display: block;
    height: 12px;
    background: var(--rainbow-gradient);
  }

  .page-header .container {
    padding: 2rem 2rem;
  }

  .breadcrumb {
    font-size: 0.9rem;
    margin-bottom: 1rem;
    color: var(--secondary-text);
    font-weight: 500;
  }

  .breadcrumb a {
    color: white;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-cyan);
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem 0;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-shadow: 4px 4px 0 rgba(0,0,0,0.3);
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--secondary-text);
    margin: 0;
    font-weight: 600;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }

  .controls {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .search-input {
    flex: 1;
    min-width: 250px;
    padding: 1rem;
    font-size: 1rem;
    border: 3px solid var(--neutral-black);
    border-radius: 0;
    transition: all 0.1s;
    font-weight: 500;
    box-sizing: border-box;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--c64-purple);
    box-shadow: 0 0 0 3px rgba(159, 78, 159, 0.2);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-group label {
    font-weight: 700;
    color: var(--neutral-black);
  }

  .filter-select {
    padding: 1rem;
    font-size: 1rem;
    border: 3px solid var(--neutral-black);
    border-radius: 0;
    background: white;
    cursor: pointer;
    font-weight: 600;
  }

  .results-info {
    margin-bottom: 1.5rem;
    color: var(--neutral-gray);
    font-size: 1rem;
    font-weight: 600;
  }

  #count {
    font-weight: 700;
    color: var(--neutral-black);
  }

  .spots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .spot-card {
    background: white;
    border: 4px solid;
    border-radius: 0;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.1s;
    box-shadow: 6px 6px 0 rgba(0,0,0,0.2);
  }

  .spot-card:nth-child(4n+1) {
    border-color: var(--box-aqua);
  }

  .spot-card:nth-child(4n+2) {
    border-color: var(--box-pink);
  }

  .spot-card:nth-child(4n+3) {
    border-color: var(--box-mint);
  }

  .spot-card:nth-child(4n+4) {
    border-color: var(--box-peach);
  }

  .spot-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 rgba(0,0,0,0.3);
  }

  .spot-card h3 {
    margin: 0 0 0.5rem 0;
    color: var(--neutral-black);
    font-size: 1.2rem;
    font-weight: 900;
  }

  .water-body {
    color: #666;
    font-size: 0.9rem;
    margin: 0 0 1rem 0;
    font-weight: 500;
  }

  .spot-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .spot-type {
    background: var(--neutral-black);
    color: white;
    padding: 0.4rem 0.7rem;
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .page-header .container {
      padding: 2rem 1.5rem;
    }

    .controls {
      flex-direction: column;
    }

    .search-input {
      min-width: 100%;
    }

    .filter-group {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }

    .filter-select {
      width: 100%;
    }

    .spots-grid {
      grid-template-columns: 1fr;
    }

    .spot-card {
      border-width: 3px;
    }
  }
</style>

<script define:vars={{ spots }}>
  // Store all spots for filtering
  let currentSpots = spots;

  // Get DOM elements
  const searchInput = document.getElementById('search-input');
  const typeFilter = document.getElementById('type-filter');
  const spotsContainer = document.getElementById('spots-container');
  const countDisplay = document.getElementById('count');

  // Filter and display spots
  function filterAndDisplay() {
    const searchTerm = searchInput.value.toLowerCase();
    const typeFilter = document.getElementById('type-filter').value;

    let filtered = currentSpots;

    // Apply search filter
    if (searchTerm) {
      filtered = filtered.filter(spot =>
        spot.name.toLowerCase().includes(searchTerm) ||
        (spot.water_body_name && spot.water_body_name.toLowerCase().includes(searchTerm))
      );
    }

    // Apply type filter
    if (typeFilter) {
      filtered = filtered.filter(spot => spot.spot_type === typeFilter);
    }

    // Sort alphabetically
    filtered = filtered.sort((a, b) => a.name.localeCompare(b.name));

    // Update display
    displaySpots(filtered);
    countDisplay.textContent = filtered.length;
  }

  // Display spots in the grid
  function displaySpots(spotsToDisplay) {
    const countySlug = window.location.pathname.split('/')[2];

    spotsContainer.innerHTML = spotsToDisplay.map(spot => {
      const waterBody = spot.water_body_name ?
        `<p class="water-body">${spot.water_body_name}</p>` : '';

      const typeLabel = spot.spot_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

      return `
        <a href="/texas/${countySlug}/${spot.slug}" class="spot-card">
          <h3>${spot.name}</h3>
          ${waterBody}
          <div class="spot-meta">
            <span class="spot-type">${typeLabel}</span>
          </div>
        </a>
      `;
    }).join('');
  }

  // Add event listeners
  searchInput.addEventListener('input', filterAndDisplay);
  typeFilter.addEventListener('change', filterAndDisplay);
</script>
</Layout>
