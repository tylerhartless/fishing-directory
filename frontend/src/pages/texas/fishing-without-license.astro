---
import Layout from '../../layouts/Layout.astro';
import ResultsWidget from '../../components/ResultsWidget.astro';
import { getSpots } from '../../lib/database';

const pageTitle = "Where Can I Fish Without a License in Texas? - State Parks Guide";
const pageDescription = "Fish without a fishing license in Texas state parks! Complete guide to all Texas state parks where you can fish license-free, including locations, amenities, and what you need to know.";

// Get all Texas state park spots
const allSpots = await getSpots();
const stateParks = allSpots.filter(spot =>
  (spot.state === 'TX' || spot.state === 'Texas') &&
  spot.spot_type === 'state_park'
);
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="retro-page-header">
    <div class="container">
      <nav class="retro-breadcrumb">
        <a href="/">← Home</a> / <a href="/states">States</a> / <a href="/texas">Texas</a> / Fishing Without a License
      </nav>
      <h1>Fishing Without a License in Texas</h1>
      <p class="subtitle" style="font-family: 'VT323', monospace;">Texas State Parks Don't Require Fishing Licenses</p>
    </div>
  </section>

  <section class="retro-container">
    <div class="no-license-page">
      <!-- Introduction -->
      <div class="intro-section retro-section">
        <h2>🎣 Free Fishing in Texas State Parks</h2>
        <p class="lead">
          You can fish without a fishing license at any Texas state park! This exemption applies to all state parks in the Texas State Park system, making it a great option for casual anglers, visitors, and families.
        </p>
        <div class="highlight-box">
          <strong>Important:</strong> While you don't need a fishing license, you still need to pay park entrance fees. Daily passes typically cost $3-8 per person (ages 13+).
        </div>
      </div>

      <!-- State Parks Search -->
      <div class="spots-list-section">
        <ResultsWidget
          items={stateParks}
          itemType="spot"
          backButton={{ url: '/texas', text: 'Texas' }}
          scrollContainerId="parks-scroll-container"
          resultsContainerId="parks-container"
        >
          {stateParks.sort((a, b) => a.name.localeCompare(b.name)).map(spot => {
            const amenities = spot.amenities ? (typeof spot.amenities === 'string' ? JSON.parse(spot.amenities) : spot.amenities) : {};
            const prominentAmenities = [];
            const amenityIcons = {
              'boat_ramp': '🚤 Boat Ramp',
              'fishing_pier': '🎣 Pier',
              'fish_cleaning': '🔪 Cleaning',
              'restrooms': '🚻 Restrooms',
              'parking': '🅿️ Parking',
            };

            for (const [key, label] of Object.entries(amenityIcons)) {
              if (amenities[key] === true) {
                prominentAmenities.push(label);
              }
            }

            const countySlug = spot.county_slug || spot.county?.toLowerCase().replace(/\s+/g, '-') || 'unknown';
            const spotSlug = spot.slug || spot.name.toLowerCase().replace(/\s+/g, '-');

            return (
              <a href={`/texas/${countySlug}/${spotSlug}`} class="spot-card" data-spot-type={spot.spot_type}>
                <div class="card-header">
                  <h3>{spot.name}</h3>
                </div>
                <div class="card-body">
                  {prominentAmenities.length > 0 ? (
                    <>
                      {prominentAmenities.map(label => (
                        <span class="card-meta-item">{label}</span>
                      ))}
                    </>
                  ) : (
                    <span class="amenity-placeholder">No amenities listed</span>
                  )}
                </div>
              </a>
            );
          })}
        </ResultsWidget>
      </div>


      <!-- FAQ Section -->
      <div class="faq-section retro-section">
        <h2>Frequently Asked Questions</h2>

        <div class="faq-item">
          <h3>Does this apply to all Texas waters?</h3>
          <p>
            No. The no-license exemption only applies when fishing within Texas state parks. If you fish at lakes, rivers, or coastal areas outside of state parks, you will need a valid Texas fishing license.
          </p>
        </div>

        <div class="faq-item">
          <h3>Do I need any other permits?</h3>
          <p>
            You don't need a fishing license, but you do need to pay the state park entrance fee. Additionally, all standard fishing regulations (bag limits, size limits, fishing methods) still apply.
          </p>
        </div>

        <div class="faq-item">
          <h3>What about saltwater fishing?</h3>
          <p>
            For saltwater fishing in Texas, different rules apply. While the no-license rule applies in state parks, you should check specific regulations for coastal fishing. Visit the <a href="https://tpwd.texas.gov/" target="_blank" rel="noopener">Texas Parks & Wildlife Department website</a> for current saltwater fishing regulations.
          </p>
        </div>

        <div class="faq-item">
          <h3>Can I fish at all state parks?</h3>
          <p>
            Most Texas state parks have fishing opportunities, but not all. The spots listed above are state parks with documented fishing access. Always check with the specific park before your visit to confirm fishing is available and to learn about any park-specific rules.
          </p>
        </div>

        <div class="faq-item">
          <h3>What fishing regulations still apply?</h3>
          <p>
            All state fishing regulations apply, including:
          </p>
          <ul>
            <li>Bag limits (how many fish you can keep)</li>
            <li>Size limits (minimum or maximum size of fish)</li>
            <li>Seasonal restrictions</li>
            <li>Allowed fishing methods</li>
            <li>Species-specific regulations</li>
          </ul>
        </div>
      </div>

      <!-- Additional Resources -->
      <div class="resources-section retro-section">
        <h2>Additional Resources</h2>
        <ul>
          <li>
            <a href="https://tpwd.texas.gov/regulations/outdoor-annual/fishing" target="_blank" rel="noopener">
              Texas Fishing Regulations (TPWD)
            </a>
          </li>
          <li>
            <a href="https://tpwd.texas.gov/state-parks/" target="_blank" rel="noopener">
              Texas State Parks Directory
            </a>
          </li>
          <li>
            <a href="https://tpwd.texas.gov/fishboat/fish/" target="_blank" rel="noopener">
              Texas Fishing Reports & Forecasts
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .no-license-page {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Spots list section - reuse search widget styles */
  .spots-list-section {
    max-width: 900px;
    margin: 0 auto;
  }

  .retro-section {
    margin-bottom: 3rem;
  }

  .retro-section h2 {
    font-family: 'VT323', monospace;
    font-size: 2rem;
    font-weight: 400;
    color: var(--theme-heading-color);
    margin: 0 0 1.5rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global([data-theme="light"]) .retro-section h2 {
    font-weight: 900;
  }

  .lead {
    font-family: 'VT323', monospace;
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--theme-text-secondary);
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  :global([data-theme="light"]) .lead {
    font-weight: 600;
    color: var(--neutral-black);
  }

  .highlight-box {
    background: var(--rgba-sage-15);
    border: 2px solid var(--rgba-sage-50);
    padding: 1.25rem;
    margin: 1.5rem 0;
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    color: var(--theme-text-sage);
    box-shadow: 0 0 10px var(--rgba-sage-30);
  }

  :global([data-theme="light"]) .highlight-box {
    background: #FFF9E6;
    border: 3px solid #FF8C42;
    color: #333333;
    box-shadow: 4px 4px 0 rgba(255, 140, 66, 0.2);
    font-weight: 700;
  }

  .faq-item {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rgba-sage-30);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item h3 {
    font-family: 'VT323', monospace;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--theme-text-sage);
    margin: 0 0 0.75rem 0;
    text-shadow: 0 0 6px rgba(168, 197, 168, 0.4);
  }

  :global([data-theme="light"]) .faq-item h3 {
    color: #333333;
    font-weight: 900;
    text-shadow: none;
  }

  .faq-item p,
  .faq-item ul {
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--theme-text-secondary);
    margin: 0.5rem 0;
    font-weight: 400;
  }

  :global([data-theme="light"]) .faq-item p,
  :global([data-theme="light"]) .faq-item ul {
    color: #555555;
    font-weight: 600;
  }

  .faq-item ul {
    padding-left: 2rem;
  }

  .faq-item li {
    margin: 0.5rem 0;
  }

  .faq-item a {
    color: var(--theme-text-sage);
    text-decoration: underline;
  }

  .faq-item a:hover {
    text-shadow: 0 0 8px rgba(168, 197, 168, 0.6);
  }

  :global([data-theme="light"]) .faq-item a {
    color: #FF6B6B;
    font-weight: 700;
  }

  :global([data-theme="light"]) .faq-item a:hover {
    color: #FF8C42;
    text-shadow: none;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }

  .features-list li {
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--theme-text-secondary);
    padding: 0.5rem 0;
  }

  :global([data-theme="light"]) .features-list li {
    color: #555555;
    font-weight: 600;
  }

  .resources-section ul {
    list-style: none;
    padding: 0;
  }

  .resources-section li {
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    margin: 1rem 0;
  }

  .resources-section a {
    color: var(--theme-text-sage);
    text-decoration: none;
    display: inline-block;
    padding: 0.75rem 1rem;
    background: var(--rgba-sage-15);
    border: 2px solid var(--rgba-sage-50);
    transition: all 0.2s;
  }

  .resources-section a:hover {
    background: var(--rgba-sage-25);
    border-color: var(--rgba-sage-80);
    box-shadow: 0 0 15px var(--rgba-sage-50);
  }

  :global([data-theme="light"]) .resources-section a {
    background: white;
    border: 3px solid #333333;
    color: #333333;
    font-weight: 700;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.2);
  }

  :global([data-theme="light"]) .resources-section a:hover {
    background: #FF8C42;
    color: white;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 768px) {
    .retro-section h2 {
      font-size: 1.6rem;
    }

    .lead {
      font-size: 1.15rem;
    }

    .faq-item h3 {
      font-size: 1.2rem;
    }
  }
</style>
