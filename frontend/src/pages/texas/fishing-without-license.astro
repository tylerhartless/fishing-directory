---
import Layout from '../../layouts/Layout.astro';
import Plate from '../../components/Plate.astro';
import SearchWidget from '../../components/SearchWidget.tsx';
import AdSlot from '../../components/AdSlot.astro';
import { getSpots } from '../../lib/database';

const pageTitle = 'Fishing Without a License in Texas · Public Fishing Directory';
const pageDescription = 'Fish license-free at any Texas state park. Complete index of TPWD state parks with public fishing access — locations, amenities, and what you need to know.';

const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || '';

const allSpots = await getSpots();
const stateParks = allSpots.filter(spot => spot.state === 'TX' && spot.spot_type === 'state_park');

const serializedParks = stateParks.map(spot => ({
  canonical_id: spot.canonical_id,
  name: spot.name,
  state: spot.state,
  state_route: spot.state_route,
  county: spot.county,
  county_slug: spot.county_slug,
  latitude: spot.latitude,
  longitude: spot.longitude,
  spot_type: spot.spot_type,
  water_body_names: spot.water_body_names,
  amenities: spot.amenities,
}));
---

<Layout title={pageTitle} description={pageDescription}>
  <article class="field-record">
    <a href="/" class="field-record-back">Back to index</a>

    <Plate
      accession="REC. SPECIAL · TX-STATE-PARKS"
      classification="LICENSE-FREE FISHING · TPWD STATE PARK SYSTEM"
      stampLabel="Free to Fish"
      stampVariant="verified"
    >
      Fishing Without a License in Texas
    </Plate>

    <section class="field-section">
      <h2 class="field-section-heading">What This Means</h2>
      <p class="lead">
        You can fish without a fishing license inside any Texas state park. The exemption applies statewide
        across the TPWD park system — no permit needed if you stay inside park boundaries.
      </p>
      <div class="callout-box">
        <strong>Note:</strong> A fishing license isn't required, but you still pay the park's daily entrance fee
        ($3–$8 per adult). Bag limits, size limits, and gear regulations all still apply.
      </div>
    </section>

    <AdSlot format="horizontal" class="ad-slot-inline" />

    <section class="field-section">
      <h2 class="field-section-heading">State Parks Index</h2>
      <div class="spots-list-section">
        <SearchWidget
          mapboxToken={mapboxToken}
          initialSpots={serializedParks}
          initialTypeFilter="state_park"
          hideSearch={true}
          hideFilters={true}
          showSortToggle={true}
          defaultCenter={[31.9686, -99.9018]}
          defaultZoom={6}
          backButtonUrl="/"
          backButtonText="Index"
          client:idle
        />
      </div>
    </section>

    <AdSlot format="horizontal" class="ad-slot-inline" />

    <section class="field-section">
      <h2 class="field-section-heading">FAQ</h2>

      <div class="faq-item">
        <h3>Does this apply to all Texas waters?</h3>
        <p>
          No — the exemption only applies <em>inside</em> Texas state parks. Lakes, rivers, and coastal
          waters outside park boundaries require a valid Texas fishing license.
        </p>
      </div>

      <div class="faq-item">
        <h3>Do I need any other permits?</h3>
        <p>
          You don't need a fishing license, but you do need to pay the state park entrance fee.
          All standard fishing regulations (bag limits, size limits, methods) still apply.
        </p>
      </div>

      <div class="faq-item">
        <h3>What about saltwater fishing?</h3>
        <p>
          Coastal park rules differ. The no-license exemption applies inside park boundaries, but
          additional saltwater rules may apply — check the
          <a href="https://tpwd.texas.gov/" target="_blank" rel="noopener">TPWD website</a> for specifics.
        </p>
      </div>

      <div class="faq-item">
        <h3>Can I fish at every state park?</h3>
        <p>
          Most have fishing access, but not all. The index above lists every TPWD park with documented
          fishing access. Always check the specific park before your trip to confirm.
        </p>
      </div>

      <div class="faq-item">
        <h3>What rules still apply?</h3>
        <p>All Texas fishing regulations remain in effect:</p>
        <ul>
          <li>Bag limits (how many fish you can keep)</li>
          <li>Size limits (minimum or maximum)</li>
          <li>Seasonal restrictions</li>
          <li>Allowed methods and gear</li>
          <li>Species-specific regulations</li>
        </ul>
      </div>
    </section>

    <section class="field-section">
      <h2 class="field-section-heading">References</h2>
      <ul class="references-list">
        <li>
          <a href="https://tpwd.texas.gov/regulations/outdoor-annual/fishing/" target="_blank" rel="noopener">
            TPWD Outdoor Annual · Fishing Regulations →
          </a>
        </li>
        <li>
          <a href="https://tpwd.texas.gov/state-parks/" target="_blank" rel="noopener">
            TPWD State Parks Directory →
          </a>
        </li>
        <li>
          <a href="https://tpwd.texas.gov/fishboat/fish/" target="_blank" rel="noopener">
            TPWD Fishing Reports & Forecasts →
          </a>
        </li>
      </ul>
    </section>
  </article>
</Layout>

<style>
  .lead {
    font-family: var(--font-body-text);
    font-size: 1.15rem;
    line-height: 1.65;
    margin: 0 0 1.25rem 0;
    color: var(--theme-text);
  }

  :global([data-theme="light"]) .lead {
    color: var(--boat-black);
    font-weight: 500;
  }

  .callout-box {
    padding: 1rem 1.15rem;
    margin: 1.25rem 0 0 0;
    font-family: var(--font-body-text);
    font-size: 1.02rem;
    line-height: 1.55;
    background: var(--rgba-sage-08);
    border-left: 3px solid var(--accent-sage);
    color: var(--theme-text);
  }

  :global([data-theme="light"]) .callout-box {
    background: var(--accent-cream);
    border-left: 5px solid var(--boat-orange);
    color: var(--boat-black);
    font-weight: 500;
  }

  .spots-list-section {
    margin: 0;
  }

  .faq-item {
    margin: 0 0 1.6rem 0;
    padding-bottom: 1.2rem;
    border-bottom: 1px dashed var(--rgba-sage-25);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  :global([data-theme="light"]) .faq-item {
    border-bottom: 1px dashed rgba(0, 0, 0, 0.18);
  }

  .faq-item h3 {
    margin: 0 0 0.55rem 0;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--theme-text);
  }

  :global([data-theme="light"]) .faq-item h3 {
    color: var(--boat-charcoal);
  }

  .faq-item p,
  .faq-item ul {
    font-family: var(--font-body-text);
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--theme-text);
    margin: 0.4rem 0;
  }

  :global([data-theme="light"]) .faq-item p,
  :global([data-theme="light"]) .faq-item ul {
    color: var(--boat-black);
    font-weight: 500;
  }

  .faq-item ul {
    padding-left: 1.2rem;
  }

  .faq-item li {
    margin: 0.3rem 0;
  }

  .faq-item a {
    color: var(--accent-sage);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  :global([data-theme="light"]) .faq-item a {
    color: var(--accent-dark-orange);
    font-weight: 700;
  }

  :global([data-theme="light"]) .faq-item a:hover {
    color: var(--boat-red);
  }

  .references-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem;
  }

  .references-list a {
    display: block;
    padding: 0.85rem 1rem;
    font-family: var(--font-body-text);
    font-size: 1rem;
    background: var(--rgba-sage-08);
    border: 1px solid var(--rgba-sage-50);
    color: var(--accent-sage);
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .references-list a:hover {
    background: var(--rgba-sage-20);
    transform: translateX(3px);
  }

  :global([data-theme="light"]) .references-list a {
    background: var(--neutral-white);
    border: 3px solid var(--boat-black);
    color: var(--boat-black);
    font-weight: 700;
    box-shadow: 4px 4px 0 var(--rgba-black-18);
  }

  :global([data-theme="light"]) .references-list a:hover {
    background: var(--boat-orange);
    color: var(--neutral-white);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--rgba-black-25);
  }

  @media (max-width: 600px) {
    .lead {
      font-size: 1.05rem;
    }

    .faq-item h3 {
      font-size: 1.02rem;
    }
  }
</style>
