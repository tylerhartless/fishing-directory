---
import '../styles/retro-colors.css';
import '../styles/retro-common.css';
import '../styles/search-widget.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Find public fishing spots nationwide. Free boat ramps, bank fishing, and pier access locations with GPS coordinates.' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://yourdomain.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header>
      <div class="rainbow-bar"></div>
      <nav class="container">
        <a href="/" class="logo">
          <span class="logo-main">WCIF?</span>
        </a>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/browse">Browse</a></li>
          <li><a href="/submit-spot">Submit a Spot</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Public Fishing Directory. All rights reserved.</p>
        <p>Data sources: State wildlife departments, user submissions</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: #333;
    background: #f5f5f5;
  }

  /* Commodore 64 Rainbow Bar */
  .rainbow-bar {
    height: 8px;
    background: linear-gradient(
      to right,
      #9f4e44 0%,      /* Red */
      #9f4e44 14.28%,
      #cb7e5f 14.28%,  /* Orange */
      #cb7e5f 28.56%,
      #cbcb9f 28.56%,  /* Yellow */
      #cbcb9f 42.84%,
      #6d9f6f 42.84%,  /* Green */
      #6d9f6f 57.12%,
      #5f7fcb 57.12%,  /* Blue */
      #5f7fcb 71.4%,
      #7f5fcb 71.4%,   /* Indigo */
      #7f5fcb 85.68%,
      #9f4e9f 85.68%,  /* Purple */
      #9f4e9f 100%
    );
  }

  header {
    background: #4040a0;
    color: white;
    padding: 0;
    box-shadow: 0 2px 0 rgba(0,0,0,0.1);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
  }

  .logo {
    color: white;
    text-decoration: none;
  }

  .logo-main {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    color: #ffffff;
    text-shadow: 3px 3px 0 rgba(0,0,0,0.3);
  }

  nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: white;
    text-decoration: none;
    font-weight: 500;
  }

  nav a:hover {
    color: #c0c0ff;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  main {
    min-height: calc(100vh - 200px);
  }

  footer {
    background: #4040a0;
    padding: 2rem 0;
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.9rem;
    color: #c0c0ff;
    border-top: 8px solid transparent;
    border-image: linear-gradient(
      to right,
      #9f4e44,
      #cb7e5f,
      #cbcb9f,
      #6d9f6f,
      #5f7fcb,
      #7f5fcb,
      #9f4e9f
    ) 1;
  }

  footer p {
    margin: 0.5rem 0;
  }
</style>
