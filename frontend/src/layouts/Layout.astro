---
import { ViewTransitions } from 'astro:transitions';
import CountyNavLink from '../components/CountyNavLink.tsx';
import '../styles/retro-colors.css';
import '../styles/retro-common.css';
import '../styles/search-widget.css';
import '../styles/layout.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Find public fishing spots nationwide. Free boat ramps, bank fishing, and pier access locations with GPS coordinates.' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://yourdomain.com';
const isStaging = siteUrl.includes('staging');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* Prevent search engine indexing on staging */}
    {isStaging && <meta name="robots" content="noindex, nofollow" />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:wght@300;400;700&family=Press+Start+2P&display=swap" rel="stylesheet">

    <!-- SEO -->
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Set theme immediately before any rendering to prevent flash -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        // Default to system preference if no stored theme
        const systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (systemPrefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        // Disable transitions on page load to prevent initial transition artifacts
        document.documentElement.classList.add('preload');
      })();
    </script>

    <!-- View Transitions -->
    <ViewTransitions />
  </head>
  <body>
    <header>
      <nav class="container">
        <a href="/" class="logo">
          <span class="logo-prompt">&gt;&lt;&gt;</span>
          <span class="logo-text">WhereCanIFish.com<span class="cursor">_</span></span>
        </a>
        
        <!-- Desktop Navigation -->
        <ul class="nav-links" id="nav-links">
          <li><a href="/states">Browse by State</a></li>
          <CountyNavLink client:load />
          <li><a href="/#search">Search</a></li>
        </ul>
        
        <!-- Mobile Menu Toggle -->
        <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </nav>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Public Fishing Directory. All rights reserved.</p>
        <p>Data sources: State wildlife departments, user submissions</p>
      </div>
    </footer>

    <!-- Floating theme toggle -->
    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
      <span class="theme-icon theme-icon-dark">☾</span>
      <span class="theme-icon theme-icon-light">☀</span>
    </button>

    <script is:inline>
      // Theme toggle functionality
      (function() {
        const setTheme = (theme) => {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
        };

        // Single global handler function to avoid multiple listeners
        const handleThemeToggle = (e) => {
          const current = document.documentElement.getAttribute('data-theme');
          const next = current === 'dark' ? 'light' : 'dark';
          setTheme(next);
          // Blur the button to remove hover state and prevent glow from persisting
          if (e && e.currentTarget) {
            e.currentTarget.blur();
          }
        };

        const setupThemeToggle = () => {
          const toggle = document.getElementById('theme-toggle');
          if (toggle) {
            // Remove old listener if it exists
            toggle.removeEventListener('click', handleThemeToggle);
            // Add fresh listener
            toggle.addEventListener('click', handleThemeToggle);
          }
        };

        // Logo click handler to reset search state
        const handleLogoClick = (e) => {
          // Clear search widget state from sessionStorage
          sessionStorage.removeItem('searchWidgetState');
        };

        const setupLogoReset = () => {
          const logo = document.querySelector('.logo');
          if (logo) {
            // Remove old listener if it exists
            logo.removeEventListener('click', handleLogoClick);
            // Add fresh listener
            logo.addEventListener('click', handleLogoClick);
          }
        };

        // Mobile menu toggle functionality
        const setupMobileMenu = () => {
          const toggle = document.getElementById('mobile-menu-toggle');
          const navLinks = document.getElementById('nav-links');
          
          if (toggle && navLinks) {
            const handleToggle = (e) => {
              e.stopPropagation(); // Prevent event from bubbling to document
              const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
              toggle.setAttribute('aria-expanded', !isExpanded);
              navLinks.classList.toggle('nav-links-open');
              toggle.classList.toggle('mobile-menu-toggle-open');
            };
            
            // Remove old listener if it exists
            const oldHandler = toggle._mobileMenuHandler;
            if (oldHandler) {
              toggle.removeEventListener('click', oldHandler);
            }
            
            // Store handler reference and add new listener
            toggle._mobileMenuHandler = handleToggle;
            toggle.addEventListener('click', handleToggle);
            
            // Close menu when clicking outside (only add once)
            if (!document._mobileMenuOutsideClick) {
              document.addEventListener('click', (e) => {
                if (!toggle.contains(e.target) && !navLinks.contains(e.target)) {
                  if (navLinks.classList.contains('nav-links-open')) {
                    toggle.setAttribute('aria-expanded', 'false');
                    navLinks.classList.remove('nav-links-open');
                    toggle.classList.remove('mobile-menu-toggle-open');
                  }
                }
              });
              document._mobileMenuOutsideClick = true;
            }
          }
        };

        // Setup theme toggle on DOMContentLoaded
        document.addEventListener('DOMContentLoaded', () => {
          setupThemeToggle();
          setupLogoReset();
          setupMobileMenu();
          // Re-enable transitions after page has loaded and rendered
          setTimeout(() => {
            document.documentElement.classList.remove('preload');
          }, 100);
        });

        // Set theme BEFORE page swap to prevent flash
        document.addEventListener('astro:before-swap', (ev) => {
          const stored = localStorage.getItem('theme');
          const systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored || (systemPrefersDark ? 'dark' : 'light');
          // Set theme on both old and new document
          document.documentElement.setAttribute('data-theme', theme);
          ev.newDocument.documentElement.setAttribute('data-theme', theme);
          ev.newDocument.documentElement.classList.add('preload');
        });

        // Re-setup event listeners after View Transitions navigation
        document.addEventListener('astro:page-load', () => {
          setupThemeToggle();
          setupLogoReset();
          setupMobileMenu();
          // Re-enable transitions after a brief delay
          setTimeout(() => {
            document.documentElement.classList.remove('preload');
          }, 50);
        });
      })();
    </script>
  </body>
</html>

