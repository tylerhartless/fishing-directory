---
import '../styles/retro-colors.css';
import '../styles/retro-common.css';
import '../styles/search-widget.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Find public fishing spots nationwide. Free boat ramps, bank fishing, and pier access locations with GPS coordinates.' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://yourdomain.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&display=swap" rel="stylesheet">

    <!-- SEO -->
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header>
      <nav class="container">
        <a href="/" class="logo">
          <span class="logo-prompt">&gt;&lt;&gt;</span>
          <span class="logo-bubble">°</span>
          <span class="logo-text">whereCanIFish.com</span>
        </a>
      </nav>
      <div class="rainbow-bar"></div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Public Fishing Directory. All rights reserved.</p>
        <p>Data sources: State wildlife departments, user submissions</p>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
          <span class="theme-icon theme-icon-dark">🌙</span>
          <span class="theme-icon theme-icon-light">☀️</span>
        </button>
      </div>
    </footer>

    <script is:inline>
      // Theme detection and toggle - Always defaults to dark mode
      (function() {
        const getTheme = () => {
          // Check localStorage first
          const stored = localStorage.getItem('theme');
          if (stored) return stored;

          // Always default to dark mode (ignore system preferences)
          return 'dark';
        };

        const setTheme = (theme) => {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
        };

        // Set initial theme
        setTheme(getTheme());

        // Toggle button handler
        document.addEventListener('DOMContentLoaded', () => {
          const toggle = document.getElementById('theme-toggle');
          if (toggle) {
            toggle.addEventListener('click', () => {
              const current = document.documentElement.getAttribute('data-theme');
              const next = current === 'dark' ? 'light' : 'dark';
              setTheme(next);
            });
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: var(--theme-text);
    background: var(--theme-bg);
    position: relative;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  :global(body::before) {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.02) 0px,
      transparent 1px,
      transparent 2px,
      rgba(0, 0, 0, 0.02) 3px
    );
    pointer-events: none;
    z-index: 9999;
  }

  /* Earthy Rainbow Bar */
  .rainbow-bar {
    height: 4px;
    background: repeating-linear-gradient(
      to right,
      var(--earth-rust) 0px,
      var(--earth-rust) 8px,
      transparent 8px,
      transparent 16px
    );
    box-shadow:
      0 0 12px rgba(184, 92, 58, 0.8),
      0 0 20px rgba(184, 92, 58, 0.6),
      0 0 30px rgba(184, 92, 58, 0.4),
      0 2px 4px rgba(0, 0, 0, 0.3);
  }

  header {
    background: #0d1f0d;
    color: white;
    padding: 0;
    box-shadow: none;
    position: relative;
    overflow: hidden;
  }

  header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.15) 0px,
      transparent 1px,
      transparent 2px,
      rgba(0, 0, 0, 0.15) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  nav {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 3rem 0;
  }

  .logo {
    color: white;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-left: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .logo-prompt {
    font-family: 'Press Start 2P', monospace;
    font-size: 2.2rem;
    font-weight: 400;
    color: #ff8c42;
    text-shadow:
      0 0 10px rgba(255, 140, 66, 0.8),
      0 0 20px rgba(255, 140, 66, 0.6),
      0 0 30px rgba(255, 140, 66, 0.4),
      2px 2px 0 rgba(0,0,0,0.3);
    flex-shrink: 0;
    letter-spacing: -0.15em;
    line-height: 2.2;
  }

  .logo-bubble {
    font-size: 1rem;
    color: #6db3f2;
    text-shadow:
      0 0 8px rgba(109, 179, 242, 0.9),
      0 0 15px rgba(109, 179, 242, 0.6);
    animation: bubble 1.5s ease-in-out infinite;
    position: relative;
    top: -0.5rem;
    margin-left: -0.3rem;
    margin-right: 0.2rem;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: 'Press Start 2P', monospace;
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #f0e6d2;
    text-shadow:
      0 0 10px rgba(240, 230, 210, 0.7),
      0 0 20px rgba(240, 230, 210, 0.5),
      0 0 30px rgba(240, 230, 210, 0.3),
      2px 2px 0 rgba(0,0,0,0.3);
    white-space: nowrap;
    position: relative;
    line-height: 2.2;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @keyframes bubble {
    0%, 100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: white;
    text-decoration: none;
    font-weight: 500;
  }

  nav a:hover {
    color: var(--accent-cream);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  nav .container {
    padding: 0 1rem;
    margin: 0;
    max-width: none;
  }

  main {
    min-height: calc(100vh - 200px);
  }

  /* Gradient transition for pages without hero sections */
  main.main-content::before {
    content: '';
    display: block;
    height: 80px;
    background: linear-gradient(180deg, #0d1f0d 0%, #121212 30%, #151515 50%, #181818 70%, #1a1a1a 100%);
    transition: background 0.3s ease;
  }

  [data-theme="light"] main.main-content::before {
    background: linear-gradient(180deg, #0d1f0d 0%, #2a2a2a 20%, #4a4a4a 40%, #7a7a7a 60%, #a0a0a0 75%, #c5c5c5 87%, #e0e0e0 94%, #f5f5f5 100%);
  }

  /* Hide gradient on pages that have hero/page-header sections */
  main.main-content:has(.hero)::before,
  main.main-content:has(.retro-page-header)::before {
    display: none;
  }

  footer {
    background: #0d1f0d;
    padding: 2rem 0;
    margin-top: 2.5rem;
    text-align: center;
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    color: #b0b0b0;
    border-top: 4px solid var(--earth-rust);
    position: relative;
    box-shadow: 0 -4px 15px rgba(184, 92, 58, 0.3);
  }

  :global([data-theme="light"]) footer {
    background: var(--primary-bg);
    color: var(--secondary-text);
    font-size: 0.9rem;
    box-shadow: none;
  }

  footer p {
    margin: 0.5rem 0;
    font-weight: 400;
  }

  :global([data-theme="light"]) footer p {
    font-weight: 500;
  }

  .theme-toggle {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 1.2rem;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .theme-toggle:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-50%) scale(1.05);
  }

  .theme-icon {
    display: none;
  }

  [data-theme="dark"] .theme-icon-light {
    display: inline;
  }

  [data-theme="light"] .theme-icon-dark {
    display: inline;
  }

  @media (max-width: 768px) {
    .theme-toggle {
      position: static;
      transform: none;
      margin: 1rem auto 0;
    }

    .theme-toggle:hover {
      transform: scale(1.05);
    }
  }

  @media (max-width: 640px) {
    .logo-prompt {
      font-size: 1.4rem;
      line-height: 2.2;
    }

    .logo-text {
      font-size: 0.95rem;
      line-height: 2.2;
      letter-spacing: 0.01em;
    }

    .logo {
      gap: 0.15rem;
    }

    .logo-bubble {
      font-size: 0.75rem;
      top: -0.4rem;
      margin-left: -0.25rem;
      margin-right: 0.15rem;
    }

    nav {
      padding: 2.5rem 0;
    }

    nav .container {
      padding: 0 0.5rem;
    }
  }

  @media (max-width: 400px) {
    .logo-prompt {
      font-size: 1.1rem;
      line-height: 2.2;
    }

    .logo-text {
      font-size: 0.75rem;
      line-height: 2.2;
      letter-spacing: 0;
    }

    .logo {
      gap: 0.1rem;
    }

    .logo-bubble {
      font-size: 0.6rem;
      top: -0.35rem;
      margin-left: -0.2rem;
      margin-right: 0.1rem;
    }

    nav {
      padding: 2rem 0;
    }

    nav .container {
      padding: 0 0.5rem;
    }
  }
</style>
