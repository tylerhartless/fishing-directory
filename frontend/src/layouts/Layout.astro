---
import '../styles/retro-colors.css';
import '../styles/retro-common.css';
import '../styles/search-widget.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Find public fishing spots nationwide. Free boat ramps, bank fishing, and pier access locations with GPS coordinates.' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://yourdomain.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&display=swap" rel="stylesheet">

    <!-- SEO -->
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header>
      <div class="rainbow-bar"></div>
      <nav class="container">
        <a href="/" class="logo">
          <span class="logo-prompt">&gt;&lt;&gt;</span>
          <span class="logo-bubble">°</span>
          <span class="logo-text">whereCanIFish.com</span>
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Public Fishing Directory. All rights reserved.</p>
        <p>Data sources: State wildlife departments, user submissions</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: #333;
    background: #f5f5f5;
  }

  /* Earthy Rainbow Bar */
  .rainbow-bar {
    height: 8px;
    background: var(--rainbow-gradient);
  }

  header {
    background: linear-gradient(180deg, #1a1a1a 0%, #0d1f0d 100%);
    color: white;
    padding: 0;
    box-shadow: 0 2px 0 rgba(0,0,0,0.3);
    position: relative;
  }

  header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.15) 0px,
      transparent 1px,
      transparent 2px,
      rgba(0, 0, 0, 0.15) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  nav {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 3rem 0;
  }

  .logo {
    color: white;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-left: 0;
  }

  .logo-prompt {
    font-family: 'Press Start 2P', monospace;
    font-size: 2.5rem;
    font-weight: 400;
    color: #ff8c42;
    text-shadow:
      0 0 10px rgba(255, 140, 66, 0.8),
      0 0 20px rgba(255, 140, 66, 0.6),
      0 0 30px rgba(255, 140, 66, 0.4),
      2px 2px 0 rgba(0,0,0,0.3);
    flex-shrink: 0;
    letter-spacing: -0.15em;
    line-height: 1.8;
  }

  .logo-bubble {
    font-size: 1.2rem;
    color: #6db3f2;
    text-shadow:
      0 0 8px rgba(109, 179, 242, 0.9),
      0 0 15px rgba(109, 179, 242, 0.6);
    animation: bubble 1.5s ease-in-out infinite;
    position: relative;
    top: -0.6rem;
    margin-left: -0.3rem;
    margin-right: 0.3rem;
  }

  .logo-text {
    font-family: 'Press Start 2P', monospace;
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: #f0e6d2;
    text-shadow:
      0 0 10px rgba(240, 230, 210, 0.7),
      0 0 20px rgba(240, 230, 210, 0.5),
      0 0 30px rgba(240, 230, 210, 0.3),
      2px 2px 0 rgba(0,0,0,0.3);
    white-space: nowrap;
    position: relative;
    line-height: 1.8;
  }

  @keyframes bubble {
    0%, 100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: white;
    text-decoration: none;
    font-weight: 500;
  }

  nav a:hover {
    color: var(--accent-cream);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  nav .container {
    padding: 0 1rem;
    margin: 0;
    max-width: none;
  }

  main {
    min-height: calc(100vh - 200px);
  }

  footer {
    background: var(--primary-bg);
    padding: 2rem 0;
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--secondary-text);
    border-top: 8px solid transparent;
    border-image: var(--rainbow-gradient) 1;
  }

  footer p {
    margin: 0.5rem 0;
  }

  @media (max-width: 640px) {
    .logo-prompt {
      font-size: 1.6rem;
      line-height: 1.8;
    }

    .logo-text {
      font-size: 1.1rem;
      line-height: 1.8;
    }

    .logo {
      gap: 0.15rem;
    }

    .logo-bubble {
      font-size: 0.85rem;
      top: -0.45rem;
      margin-left: -0.25rem;
      margin-right: 0.25rem;
    }

    nav {
      padding: 2.5rem 0;
    }

    nav .container {
      padding: 0 0.75rem;
    }
  }

  @media (max-width: 400px) {
    .logo-prompt {
      font-size: 1.3rem;
      line-height: 1.8;
    }

    .logo-text {
      font-size: 0.9rem;
      line-height: 1.8;
    }

    .logo {
      gap: 0.15rem;
    }

    .logo-bubble {
      font-size: 0.7rem;
      top: -0.4rem;
      margin-left: -0.2rem;
      margin-right: 0.2rem;
    }

    nav {
      padding: 2rem 0;
    }
  }
</style>
