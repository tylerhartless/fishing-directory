---
import { ViewTransitions } from 'astro:transitions';
import AgencyStrip from '../components/AgencyStrip.astro';
import StatusBar from '../components/StatusBar.astro';
import AdSidebar from '../components/AdSidebar.astro';
import { ADS_ENABLED, PUBLISHER_ID } from '../lib/ads-config';
import '../styles/retro-colors.css';
import '../styles/retro-common.css';
import '../styles/search-widget.css';
import '../styles/layout.css';
import '../styles/field-record.css';
import '../styles/ads.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Find public fishing spots nationwide. Free boat ramps, bank fishing, and pier access locations with GPS coordinates.' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://yourdomain.com';
const isStaging = siteUrl.includes('staging');
const loadAdScript = ADS_ENABLED && PUBLISHER_ID.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* Prevent search engine indexing on staging */}
    {isStaging && <meta name="robots" content="noindex, nofollow" />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:wght@300;400;700&family=IBM+Plex+Mono:wght@400;500;700&family=Press+Start+2P&display=swap" rel="stylesheet">

    <!-- SEO -->
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Set theme immediately before any rendering to prevent flash -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        // Default to system preference if no stored theme
        const systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (systemPrefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        // Disable transitions on page load to prevent initial transition artifacts
        document.documentElement.classList.add('preload');
      })();
    </script>

    <!-- Google AdSense (loaded only when fully configured) -->
    {loadAdScript && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-${PUBLISHER_ID}`} crossorigin="anonymous"></script>
    )}

    <!-- View Transitions -->
    <ViewTransitions />
  </head>
  <body>
    <AgencyStrip />

    <main class="main-content">
      {ADS_ENABLED ? (
        <div class="ad-layout">
          <AdSidebar position="left" />
          <div class="ad-layout-content">
            <slot />
          </div>
          <AdSidebar position="right" />
        </div>
      ) : (
        <slot />
      )}
    </main>

    <StatusBar />

    <script is:inline>
      // Theme toggle — segmented buttons in the agency strip.
      (function() {
        const setTheme = (theme) => {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
        };

        const handleThemeBtnClick = (e) => {
          const btn = e.currentTarget;
          const target = btn.dataset.themeTarget;
          if (!target) return;
          setTheme(target);
          // Drop focus so :focus styling doesn't linger on touch devices
          if (btn.blur) btn.blur();
        };

        const setupThemeToggle = () => {
          const buttons = document.querySelectorAll('.theme-switcher-btn');
          buttons.forEach((btn) => {
            // Idempotent rebind across View Transitions
            btn.removeEventListener('click', handleThemeBtnClick);
            btn.addEventListener('click', handleThemeBtnClick);
          });
        };

        // Logo click handler to reset search state
        const handleLogoClick = (e) => {
          // Clear search widget state from sessionStorage
          sessionStorage.removeItem('searchWidgetState');
        };

        const setupLogoReset = () => {
          const logo = document.querySelector('.logo');
          if (logo) {
            // Remove old listener if it exists
            logo.removeEventListener('click', handleLogoClick);
            // Add fresh listener
            logo.addEventListener('click', handleLogoClick);
          }
        };

        // Setup theme toggle on DOMContentLoaded
        document.addEventListener('DOMContentLoaded', () => {
          setupThemeToggle();
          setupLogoReset();
          // Re-enable transitions after page has loaded and rendered
          setTimeout(() => {
            document.documentElement.classList.remove('preload');
          }, 100);
        });

        // Set theme BEFORE page swap to prevent flash
        document.addEventListener('astro:before-swap', (ev) => {
          const stored = localStorage.getItem('theme');
          const systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored || (systemPrefersDark ? 'dark' : 'light');
          // Set theme on both old and new document
          document.documentElement.setAttribute('data-theme', theme);
          ev.newDocument.documentElement.setAttribute('data-theme', theme);
          ev.newDocument.documentElement.classList.add('preload');
        });

        // Re-setup event listeners after View Transitions navigation
        document.addEventListener('astro:page-load', () => {
          setupThemeToggle();
          setupLogoReset();
          // Re-enable transitions after a brief delay
          setTimeout(() => {
            document.documentElement.classList.remove('preload');
          }, 50);
        });
      })();
    </script>
  </body>
</html>

