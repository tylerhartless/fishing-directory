---
import { ViewTransitions } from 'astro:transitions';
import '../styles/retro-colors.css';
import '../styles/retro-common.css';
import '../styles/search-widget.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Find public fishing spots nationwide. Free boat ramps, bank fishing, and pier access locations with GPS coordinates.' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://yourdomain.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&display=swap" rel="stylesheet">

    <!-- SEO -->
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- View Transitions -->
    <ViewTransitions />
  </head>
  <body>
    <header>
      <nav class="container">
        <a href="/" class="logo">
          <span class="logo-prompt">&gt;&lt;&gt;</span>
          <span class="logo-text">WhereCanIFish.com<span class="cursor">_</span></span>
        </a>
      </nav>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Public Fishing Directory. All rights reserved.</p>
        <p>Data sources: State wildlife departments, user submissions</p>
      </div>
    </footer>

    <!-- Floating theme toggle -->
    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
      <span class="theme-icon theme-icon-dark">DARK</span>
      <span class="theme-icon theme-icon-light">LIGHT</span>
    </button>

    <script is:inline>
      // Theme detection and toggle - Always defaults to dark mode
      (function() {
        const getTheme = () => {
          // Check localStorage first
          const stored = localStorage.getItem('theme');
          if (stored) return stored;

          // Always default to dark mode (ignore system preferences)
          return 'dark';
        };

        const setTheme = (theme) => {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
        };

        const setupThemeToggle = () => {
          const toggle = document.getElementById('theme-toggle');
          if (toggle) {
            toggle.addEventListener('click', () => {
              const current = document.documentElement.getAttribute('data-theme');
              const next = current === 'dark' ? 'light' : 'dark';
              setTheme(next);
            });
          }
        };

        // Set initial theme (runs on first load)
        setTheme(getTheme());

        // Setup theme toggle on DOMContentLoaded
        document.addEventListener('DOMContentLoaded', setupThemeToggle);

        // Re-apply theme after View Transitions navigation
        document.addEventListener('astro:page-load', () => {
          // Re-apply theme from localStorage
          setTheme(getTheme());
          // Re-setup toggle button
          setupThemeToggle();
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: var(--theme-text);
    background: var(--theme-bg);
    position: relative;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  :global(body::before) {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.15) 0px,
      transparent 1px,
      transparent 2px,
      rgba(0, 0, 0, 0.15) 3px
    );
    pointer-events: none;
    z-index: 9999;
  }

  :global([data-theme="light"] body::before) {
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.01) 0px,
      transparent 1px,
      transparent 2px,
      rgba(0, 0, 0, 0.01) 3px
    ) !important;
  }

  header {
    background: var(--theme-bg-forest);
    color: white;
    padding: 0;
    box-shadow: none;
    position: relative;
    overflow: visible;
  }

  [data-theme="light"] header {
    background: var(--theme-bg-forest);
    border-bottom: 4px solid var(--accent-dark-orange);
  }

  nav {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 6.5rem 2rem;
    overflow: visible;
  }

  .logo {
    color: white;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow: visible;
  }

  .logo-prompt {
    font-family: 'Press Start 2P', monospace;
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--theme-breadcrumb-color);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
    filter: drop-shadow(0 0 4px rgba(57, 255, 20, 0.6))
            drop-shadow(0 0 8px rgba(57, 255, 20, 0.3));
    flex-shrink: 0;
    letter-spacing: -0.15em;
    line-height: 2.2;
    padding: 0 20px;
    margin: 0 -20px;
  }

  .logo-text {
    font-family: 'Press Start 2P', monospace;
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--neutral-white);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.4))
            drop-shadow(0 0 8px rgba(255, 255, 255, 0.2));
    white-space: nowrap;
    position: relative;
    line-height: 2.2;
    padding: 0 25px;
    margin: 0 -25px;
  }

  [data-theme="light"] .logo-prompt {
    filter: none;
  }

  [data-theme="light"] .logo-text {
    filter: none;
  }

  .cursor {
    animation: blink 1s step-end infinite;
  }

  [data-theme="light"] .cursor {
    display: none;
  }

  @keyframes blink {
    0%, 50% {
      opacity: 1;
    }
    51%, 100% {
      opacity: 0;
    }
  }

  nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: white;
    text-decoration: none;
    font-weight: 500;
  }

  nav a:hover {
    color: var(--accent-cream);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  nav.container {
    display: flex;
    justify-content: center;
    overflow: visible;
    max-width: 1200px;
    margin: 0 auto;
  }

  main {
    min-height: calc(100vh - 200px);
  }

  /* Gradient transition for pages without hero sections */
  main.main-content::before {
    content: '';
    display: block;
    height: 100px;
    background: linear-gradient(180deg, #0d1f0d 0%, #0f2a0f 50%, #1a1a1a 100%);
    transition: background 0.3s ease;
  }

  [data-theme="light"] main.main-content::before {
    display: none;
  }

  /* Hide gradient on pages that have hero/page-header sections */
  main.main-content:has(.hero)::before,
  main.main-content:has(.retro-page-header)::before {
    display: none;
  }

  /* Spots page gets same gradient as homepage */
  main.main-content:has(.spots-page-container)::before {
    height: 200px;
    background: linear-gradient(180deg, #0d1f0d 0%, #0e250e 25%, #0f2a0f 50%, #101010 75%, #1a1a1a 100%);
  }

  footer {
    background: var(--theme-bg-forest);
    padding: 0 0 2rem 0;
    margin-top: 0;
    text-align: center;
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    color: var(--theme-text-secondary);
    position: relative;
  }

  /* Gradient transition before footer */
  footer::before {
    content: '';
    display: block;
    height: 200px;
    background: linear-gradient(180deg, transparent 0%, #1a1a1a 25%, #151515 50%, #0f2a0f 75%, #0d1f0d 100%);
    margin-bottom: 0;
    transition: background 0.3s ease;
  }

  [data-theme="light"] footer::before {
    display: none;
  }

  [data-theme="light"] footer {
    background: var(--theme-bg-forest);
    color: white;
    border-top: 4px solid var(--accent-dark-orange);
  }

  footer p {
    margin: 0.5rem 0;
    font-weight: 400;
  }

  :global([data-theme="light"]) footer p {
    font-weight: 500;
  }

  .theme-toggle {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: rgba(0, 0, 0, 0.6);
    border: 2px solid var(--theme-breadcrumb-color);
    padding: 0.6rem 1rem;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    box-shadow: 0 0 10px rgba(57, 255, 20, 0.3);
    font-family: 'VT323', monospace;
    z-index: 1000;
    color: var(--theme-breadcrumb-color);
    letter-spacing: 0.05em;
    font-weight: 400;
  }

  .theme-toggle:hover {
    background: rgba(57, 255, 20, 0.1);
    box-shadow: 0 0 15px rgba(57, 255, 20, 0.5);
    transform: translateY(-2px);
  }

  .theme-toggle:active {
    transform: translateY(0);
  }

  [data-theme="light"] .theme-toggle {
    background: var(--accent-sage);
    border: 3px solid var(--neutral-black);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.3);
    color: var(--neutral-black);
  }

  [data-theme="light"] .theme-toggle:hover {
    background: var(--box-moss);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.3);
  }

  [data-theme="light"] .theme-toggle:active {
    transform: translate(0, 0);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.3);
  }

  .theme-icon {
    display: none;
  }

  [data-theme="dark"] .theme-icon-light {
    display: inline;
  }

  [data-theme="light"] .theme-icon-dark {
    display: inline;
  }

  @media (max-width: 768px) {
    nav {
      padding: 3.5rem 1rem;
    }

    nav.container {
      padding: 0 1rem;
    }

    .theme-toggle {
      bottom: 1.5rem;
      right: 1.5rem;
      padding: 0.5rem 0.8rem;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 640px) {
    .logo-prompt {
      font-size: 1.4rem;
      line-height: 2.2;
      padding: 0 15px;
      margin: 0 -15px;
    }

    .logo-text {
      font-size: 0.95rem;
      line-height: 2.2;
      letter-spacing: 0.01em;
      padding: 0 20px;
      margin: 0 -20px;
    }

    .logo {
      gap: 0.3rem;
    }

    nav {
      padding: 3.5rem 0;
    }

    nav.container {
      padding: 0 1rem;
    }
  }

  @media (max-width: 400px) {
    .logo-prompt {
      font-size: 1.1rem;
      line-height: 2.2;
      padding: 0 12px;
      margin: 0 -12px;
    }

    .logo-text {
      font-size: 0.75rem;
      line-height: 2.2;
      letter-spacing: 0;
      padding: 0 15px;
      margin: 0 -15px;
    }

    .logo {
      gap: 0.2rem;
    }

    nav {
      padding: 3rem 0;
    }

    nav.container {
      padding: 0 0.5rem;
    }
  }

  /* =====================================
     VIEW TRANSITIONS - THEME SPECIFIC
     ===================================== */

  /* Dark Mode: CRT Screen Transition - Digital fade with scanline effect */
  ::view-transition-old(root) {
    animation: fadeOutScanline 0.3s ease-out;
  }

  ::view-transition-new(root) {
    animation: fadeInScanline 0.3s ease-in;
  }

  @keyframes fadeOutScanline {
    from {
      opacity: 1;
      filter: brightness(1);
    }
    to {
      opacity: 0;
      filter: brightness(1.2) blur(2px);
    }
  }

  @keyframes fadeInScanline {
    from {
      opacity: 0;
      filter: brightness(1.2) blur(2px);
    }
    to {
      opacity: 1;
      filter: brightness(1);
    }
  }

  /* Light Mode: Magazine Page Turn - Subtle slide effect */
  [data-theme="light"] ::view-transition-old(root) {
    animation: slideOutPage 0.35s ease-out;
  }

  [data-theme="light"] ::view-transition-new(root) {
    animation: slideInPage 0.35s ease-in;
  }

  @keyframes slideOutPage {
    from {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateX(-30px) scale(0.98);
    }
  }

  @keyframes slideInPage {
    from {
      opacity: 0;
      transform: translateX(30px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none !important;
    }
  }

  /* =====================================
     SEARCH WIDGET MORPH TRANSITION
     ===================================== */

  /* Search container morphing to results header */
  ::view-transition-old(search-container),
  ::view-transition-new(search-container) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Dark Mode: Widget expands downward like terminal output */
  ::view-transition-old(search-container) {
    animation-name: expandOut;
  }

  ::view-transition-new(search-container) {
    animation-name: expandIn;
  }

  @keyframes expandOut {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0.8;
      transform: scale(1.05) translateY(-20px);
    }
  }

  @keyframes expandIn {
    from {
      opacity: 0.8;
      transform: scale(0.95) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Light Mode: Magazine page flip effect */
  [data-theme="light"] ::view-transition-old(search-container) {
    animation-name: pageFlipOut;
  }

  [data-theme="light"] ::view-transition-new(search-container) {
    animation-name: pageFlipIn;
  }

  @keyframes pageFlipOut {
    from {
      opacity: 1;
      transform: perspective(1000px) rotateX(0deg);
    }
    to {
      opacity: 0;
      transform: perspective(1000px) rotateX(-15deg) translateY(-30px);
    }
  }

  @keyframes pageFlipIn {
    from {
      opacity: 0;
      transform: perspective(1000px) rotateX(15deg) translateY(30px);
    }
    to {
      opacity: 1;
      transform: perspective(1000px) rotateX(0deg) translateY(0);
    }
  }

  /* Reduced motion: simpler fade */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(search-container),
    ::view-transition-new(search-container) {
      animation: simpleFade 0.3s ease !important;
    }

    @keyframes simpleFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }
</style>
