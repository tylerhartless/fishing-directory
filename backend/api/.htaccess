# ========================================
# CORS (Cross-Origin Resource Sharing)
# ========================================
# Note: This .htaccess sets a permissive CORS policy for Apache.
# The actual origin validation is handled in config.php via the
# set_cors_headers() function, which checks against $allowed_origins.
# This two-layer approach ensures Apache doesn't block requests
# while PHP can implement stricter domain validation.
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
</IfModule>

# Disable directory listing
Options -Indexes

# PHP settings
<IfModule mod_php.c>
    php_value upload_max_filesize 2M
    php_value post_max_size 2M
    php_value max_execution_time 30
    php_value max_input_time 30
</IfModule>

# Protect sensitive files
<FilesMatch "^(config\.php|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable error logging
php_flag display_errors Off
php_flag log_errors On

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
